+
+        return template_data
+
+    @classmethod
+    def template_options_put_values(cls, **kwargs):
+        for column_template in cls.columns_templates:  # type: dict
+            value = kwargs.get(column_template['source'])  # translated value  # noqa: F841
+            pass
+        pass
+
+    @classmethod
+    def check_to_show(cls, data_types: dict | None = None, columns: list | None = None, **kwargs) -> bool:
+        columns = cls.filter_dtypes_columns(data_types, methods=['array'], columns=columns)
+        columns = list(filter(lambda c: not c.startswith('proba'), columns))
+
+        to_show = len(columns) > 0
+
+        return to_show
