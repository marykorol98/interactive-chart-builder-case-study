+import numpy as np
+
+from .base_method import BaseMethod
+from .styles import StyleModificator
+
+
+def get_feature_importance(model, columns, raise_exc=True):
+    if hasattr(model, 'coef_'):
+        coef_ = model.coef_
+        if isinstance(model.coef_[0], np.ndarray):
+            coef_ = coef_[0]
+
+    elif hasattr(model, 'feature_importances_'):
+        coef_ = model.feature_importances_
+    elif raise_exc:
+        raise Exception(f'The model {model.__class__.__name__} has not feature importance')
+    else:
+        coef_ = list(map(lambda v: 0, columns))  # Нулевая важность для всех
+
+    return sorted(zip(columns, np.abs(coef_)), key=lambda v: v[1], reverse=True)
+
+
+class FeaturesImportance(BaseMethod):
+    styles_fields_exclude = {'line_type', 'max_size', 'scheme_color', 'multiple_axes'}
+    styles_modificators = [StyleModificator('xaxis_tickangle', value=-90)]
+
+    def plot(self, df, *args, styles: dict[str, str] | None = None, **kwargs):
+        model, columns = kwargs.get('model'), kwargs.get('model_columns')
+
+        assert model is not None, 'Модель не была передана'
+        assert columns is not None, 'Столбцы не были переданы'
+
+        self.update_styles(styles)
+
+        params = {}
+        if hasattr(model, 'steps'):
+            params['step'] = model.steps
+
+        if hasattr(model, 'get_feature_importance'):
+            data = model.get_feature_importance(**params)
+        else:
+            data = get_feature_importance(model, columns)
+
+        if not isinstance(data, np.ndarray) and not isinstance(data, list):
+            trace = {
+                'name': 'Score',
+                'type': 'bar',
+                'x': data['feature'],
+                'y': data['importance'],
+                'marker': {'color': kwargs.get('marker_color', 'blue')},
+            }
+        else:
+            trace = {
+                'name': 'Score',
+                'type': 'bar',
+                'x': list(map(lambda v: v[0], data)),
+                'y': list(map(lambda v: v[1], data)),
+                'marker': {'color': self.styles['marker_color'].value},
+            }
+
+        layout = self.compile_layout()
+        xaxis_title = 'Feature' if layout.get('xaxis_title') in ['', None] else layout.get('xaxis_title')
+        yaxis_title = 'Importance (coefs)' if layout.get('yaxis_title') in ['', None] else layout.get('yaxis_title')
+
+        layout['xaxis'].update(
+            {
+                'type': 'category',
+                'title': xaxis_title,
+                'autorange': True,
+                'gridcolor': 'white',
+            }
+        )
+        layout['yaxis'].update(
+            {
+                'type': 'linear',
+                'title': yaxis_title,
+                'autorange': True,
+                'gridcolor': 'white',
+            }
+        )
+
+        layout.update(
+            {
+                'autosize': True,
+            }
+        )
+
+        return {'data': [trace], 'layout': layout}
+
+    @classmethod
+    def check_to_show(cls, data_types=None, columns=None, node=None, **kwargs):
+        if node is not None and hasattr(node.title_property, 'instance'):
+            model = node.title_property.instance.first_model
+            return hasattr(model, 'feature_importances_') or hasattr(model, 'coef_')
+
+        return True
