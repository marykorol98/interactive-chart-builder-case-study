+            images = [img_]
+            target = None
+            predict = [data[self.column_predict][0]] if self.column_predict not in ['Отсутствует'] else None
+        else:
+            if self.max_size <= 1:
+                raise Exception('Please, select number of images >= 2')
+
+            # if it is single column, try to get input shape of images column
+            if (shape is None or shape == self.shape_default) and meta is not None and (meta_col := meta.get(column)):
+                shape = meta_col.shape
+
+            self.shape = self.validate_shape(shape)
+
+            data_in = self.get_series(data, {}, [column, self.column_target, self.column_predict])
+
+            images, target, predict = data_in
+
+            count_images_side = int(np.sqrt(self.max_size))
+
+        fig, axes = plt.subplots(count_images_side, count_images_side, figsize=(14, 14))
+        if not isinstance(axes, (list, tuple, np.ndarray)):
+            axes = [[axes]]
+
+        for i in range(count_images_side):
+            for j in range(count_images_side):
+                ax, index = axes[i][j], i * count_images_side + j
+                self._plot_single_img(
+                    ax,
+                    images[index],
+                    self.shape,
+                    self.get_el_by_index(target, index),
+                    self.get_el_by_index(predict, index),
+                )
+
+        return fig
