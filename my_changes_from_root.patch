@@ -0,0 +1,187 @@
+from abc import ABC
+
+from smile_ml_core.data.tools import try_to_number
+
+
+class StyleElement(ABC):
+    _type = 'bool'
+    _classes = ''
+
+    def __init__(
+        self,
+        id_: str,
+        label: str,
+        value: str | float | int | bool,
+        layout: bool = False,
+        parent: str | None = None,
+        set_to: list[str] | None = None,
+    ):
+        """
+        :param id_:
+        :param label:
+        :param value:
+        :param layout: to set this style to layout
+        :param parent: style inside the prop, for example "font" {font: {size: 10}}
+        :param set_to: the list of styles, to set this property, by default it is id_
+        """
+        self._id: str = id_
+        self._label: str = label
+        self._value = value
+
+        self._layout = layout
+        self._parent = parent
+        self._set_to = set_to
+
+    @property
+    def id(self) -> str:
+        if self._parent is None:
+            return self._id
+
+        return f'{self._parent}_{self._id}'
+
+    @property
+    def value(self) -> str | float | int | bool:
+        return self._value
+
+    @value.setter
+    def value(self, value):
+        self._value = value
+
+    def __copy__(self):
+        return self.__class__(
+            id_=self._id,
+            label=self._label,
+            value=self._value,
+            layout=self._layout,
+            set_to=self._set_to,
+            parent=self._parent,
+        )
+
+    def copy(self):
+        return self.__copy__()
+
+    def to_dict(self) -> dict:
+        if not self._type:
+            raise NotImplementedError()
+
+        return {
+            'label': self._label,
+            'value': self._value,
+            'class': self._classes,
+            'type': self._type,
+            'input_type': self._type,
+        }
+
+    def update_layout(self, layout: None | dict):
+        if layout is None:
+            layout = {}
+
+        if not self._layout:
+            return layout
+
+        obj_to_set = layout
+        if self._parent:
+            if self._parent not in layout:
+                layout[self._parent] = {}
+            obj_to_set = layout[self._parent]
+
+        set_to = [self._id] if self._set_to is None else self._set_to
+        for id_ in set_to:
+            obj_to_set[id_] = self._value
+
+        return layout
+
+
+class StyleBool(StyleElement):
+    _type = 'bool'
+    _classes = ''
+
+    @property
+    def value(self):
+        return self._value
+
+    @value.setter
+    def value(self, value):
+        if isinstance(value, str):
+            value = value.lower()
+
+            if value not in {'true', 'false'}:
+                raise Exception(f'Expected values are: True or False, got {value}')
+
+            value = value == 'true'
+
+        if not isinstance(value, bool):
+            raise Exception(f'Unsupported type of value {type(value)}')
+
+        self._value = value
+
+
+class StyleNumber(StyleElement):
+    _type = 'number'
+    _classes = 'form-control'
+
+    @property
+    def value(self):
+        return self._value
+
+    @value.setter
+    def value(self, value):
+        if isinstance(value, str):
+            value = try_to_number(value)
+
+            if isinstance(value, str):
+                raise Exception(f'Expected number value, got {value}')
+
+        if not isinstance(value, (int, float)):
+            raise Exception(f'Unsupported type of value {type(value)}')
+
+        self._value = value
+
+
+class StyleString(StyleElement):
+    _type = 'text'
+    _classes = 'form-control'
+
+
+class StyleSelect(StyleElement):
+    _type = 'select'
+    _classes = 'form-control'
+
+    def __init__(
+        self,
+        id_: str,
+        label: str,
+        value: str | float | int | bool,
+        options: dict[str, str],
+        layout: bool = False,
+        set_to: list[str] | None = None,
+        parent: str | None = None,
+    ):
+        super().__init__(id_, label, value, layout, parent, set_to)
+        self._options: dict[str, str] = options
+
+    def __copy__(self):
+        return StyleSelect(
+            id_=self._id,
+            label=self._label,
+            value=self._value,
+            layout=self._layout,
+            parent=self._parent,
+            set_to=self._set_to,
+            options=self._options.copy(),  # Make a copy of options
+        )
+
+    @property
+    def value(self):
+        return self._value
+
+    @value.setter
+    def value(self, value):
+        if value not in self._options:
+            raise Exception(f'Expected values are: {set(self._options.keys())}, got {value}')
+
+        self._value = value
+
+    def to_dict(self) -> dict:
+        options = [{'label': label, 'value': value} for value, label in self._options.items()]
+        return super().to_dict() | {'options': options}
