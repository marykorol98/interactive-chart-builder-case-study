+from __future__ import annotations
+
+import math
+import re
+from typing import Any
+
+import numpy as np
+import pandas as pd
+import plotly.express as px
+import plotly.graph_objs as go
+import scipy.stats as stats
+from plotly.subplots import make_subplots
+
+from .base_method import BaseMethod
+from .styles import StyleModificator, StyleNumber
+
+plotly_colors = [  # (hist_color, kde_color)
+    ('#9fa8da', '#1a237e'),  # blue
+    ('#a5d6a7', '#1b5e20'),  # green
+    ('#ffcc80', '#e65100'),  # yellow
+    ('#ce93d8', '#4a148c'),  # purple
+    ('#b0bec5', '#263238'),  # grey
+    ('#ef9a9a', '#b71c1c'),  # red
+]
+
+
+class Histogram(BaseMethod):
+    columns_templates = [
+        {
+            'label': 'Column',
+            'name': 'column',
+            'multi': False,
+            'source': 'column',
+        },
+        {
+            'label': 'Group by',
+            'name': 'group_by',
+            'source': 'group_by',
+            'include_non_selected': True,
+        },
+        {'label': 'Same xlim', 'name': 'same_xlim', 'source': 'same_xlim'},
+    ]
+
+    styles_extra = [
+        StyleNumber(id_='bins', label='Bins', value=10),
+    ]
+    styles_fields_exclude = {'line_type', 'marker_color', 'max_size', 'multiple_axes'}
+
+    styles_modificators = [
+        StyleModificator(id_='xaxis_tickangle', value=45),
+        StyleModificator(id_='data_slice', value=' '),
+    ]
+
+    def __init__(self):
+        super().__init__()
+
+        self.column: str | None = None
+        self.group_by_col: str | None = None
+        self.same_xlim: bool = False
+
+    @classmethod
+    def get_default_layout(cls):
+        layout = super(cls, cls).get_default_layout()
+        layout.update({'bargap': 0.0})
+        return layout
+
+    @staticmethod
+    def get_pie_colors():
+        return ['#111C5C', '#024A7E', '#80E0E5']
+
+    @staticmethod
+    def calculate_bar_width(interval: float, n_bins: int) -> float:
+        """
+        Formula source: https/en.wikipedia.org/wiki/Freedman–Diaconis_rule
+        """
+        return 2 * interval / n_bins ** (1 / 3)
+
+    def plot_frequencies(self, df: pd.DataFrame) -> Any:
+        number = 0
+        num_categories = len(df)
+        cols = min([3, num_categories])
+        rows = math.ceil(num_categories / cols)
+
+        bins = self.styles['bins'].value  # в np.histogram по дефолту bins=10
+        fig = make_subplots(rows=rows, cols=cols)
+
+        colors = self.get_colors()
+        x_min, x_max = np.inf, -np.inf
+
+        for i, (category_name, df_cat) in enumerate(df):
+            x_min = min(x_min, float(df_cat.min()))
+            x_max = max(x_max, float(df_cat.max()))
+
+            df_cat = df_cat.dropna()
+            if not df_cat[self.column].unique().shape[0] == 1:  # Если столбец не из одинаковых значений
+                hist, bin_edges = np.histogram(df_cat[self.column], bins=bins, density=True)
+
+                kde_figure = go.Scatter(
+                    x=bin_edges[:-1],
+                    y=stats.gaussian_kde(df_cat[self.column]).evaluate(bin_edges[:-1]),
+                    line_shape='spline',
+                    line_color=self.get_colors()[0],
+                    marker={'size': 10, 'color': 'white'},
+                    showlegend=True if number == 0 else False,
+                    name='kde' if number == 0 else '',  # В легенду добавляем kde только один раз для первого графика
+                )
+                fig.add_trace(kde_figure, row=number // cols + 1, col=number % cols + 1)
