+        n_samples = shap_values.values.shape[0]
+        
+        # Сохраним все traces от всех фигур
+        all_traces = []
+        layout_template = None
+        traces_per_sample = None
+
+        for i in range(n_samples):
+            fig = self.shap_plot_one(
+                shap_values=shap_values, feature_names=feature_names, index=i, **kwargs
+            )
+
+            if layout_template is None:
+                layout_template = fig.layout
+
+            if traces_per_sample is None:
+                traces_per_sample = len(fig.data)
+
+            for trace in fig.data:
+                trace.visible = (i == 0)
+                all_traces.append(trace)
+
+        sliders = [
+            {
+                'active': 0,
+                'currentvalue': {'prefix': 'Row index: '},
+                'pad': {'t': 50},
+                'steps': [
+                    {
+                        'label': str(i),
+                        'method': 'update',
+                        'args': [{'visible': [i * traces_per_sample <= j < (i + 1) * traces_per_sample for j in range(len(all_traces))]}]
+                    } for i in range(n_samples)
+                ]
+            }
+        ]
+
+        final_fig = go.Figure(data=all_traces)
+        final_fig.update_layout(layout_template)
+        final_fig.update_layout(sliders=sliders)
+
+        return final_fig
 
