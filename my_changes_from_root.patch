+from abc import ABC
+
+from smile_ml_core.plot_methods import BaseMethod
+
+
+class SortingMixin(BaseMethod, ABC):
+    sorting_non_selected = 'Index'
+    special_columns_templates = [
+        {
+            'label': 'Sort by',
+            'name': 'sort_column',
+            'source': 'columns_sort_by',
+            'include_non_selected': True,
+            'non_selected': sorting_non_selected,
+            'reverse': True,
+        },
+    ]
+
+    def __init__(self):
+        super().__init__()
+
+        self.sort_column = None
+        self.reverse = False
+
+    def set_sorting_states(self, sort_column=None, reverse=False):
+        if sort_column is None:
+            sort_column = self.sorting_non_selected
+
+        self.sort_column = sort_column
+        self.reverse = reverse
+
+    def get_series(self, df, *args, ignore_index: bool = True, **kwargs):
+        if self.sort_column == self.sorting_non_selected:  # by index
+            df = df.sort_index(ascending=not self.reverse, ignore_index=ignore_index)
+
+        else:
+            df = df.sort_values(
+                by=[self.sort_column],
+                ascending=not self.reverse,
+                ignore_index=ignore_index,
+            )
+
+        return super(SortingMixin, self).get_series(df, *args, **kwargs)
+
+    @classmethod
+    def get_params(cls, data_types=None, columns=None, instance=None, **kwargs):
+        template_columns = kwargs.get('template_columns', {})
+        sorting_columns = kwargs.get('sorting_columns', {})
+
+        columns_sort_by = [instance.sort_column] if instance else []
+        sort_by_data = dict(map(lambda col: (col, col in columns_sort_by), sorting_columns))
+        params = {
+            **template_columns,
+            'columns_sort_by': sort_by_data,
+            'reverse': instance.reverse if instance else False,
+        }
+        return params
+
+    @classmethod
+    def get_template(cls, data_types=None, columns=None, instance=None, **kwargs):
+        params = cls.get_params(data_types=data_types, columns=columns, instance=instance, **kwargs)
+
+        return params
+
+    @classmethod
+    def get_json(cls, data_types=None, columns=None, instance=None, **kwargs):
+        params = cls.get_params(data_types=data_types, columns=columns, instance=instance, **kwargs)
+        params = cls.format_json_data(params)
+        return params
