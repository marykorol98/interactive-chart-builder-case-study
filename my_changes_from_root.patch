+import pandas as pd
+
+from smile_ml_core.models.ts_forecasting import BaseTsForecastModel
+from smile_ml_core.plot_methods import BaseMethod
+
+
+class TimeSeries(BaseMethod):
+    def plot(
+        self,
+        df: pd.DataFrame,
+        target_column: str,
+        styles: dict[str, str] | None = None,
+        **kwargs,
+    ):
+        self.update_styles(styles=styles)
+
+        model: 'BaseTsForecastModel' = kwargs['model']
+
+        data_train: pd.DataFrame = kwargs['data_input']
+        data_train.columns = list(map(lambda c: c.rsplit(':', 1)[-1], data_train.columns))
+
+        endog_train = endog = data_train[target_column]
+        validation: pd.Series | None = None
+        if 'validation' in data_train:
+            validation = data_train['validation']
+        else:
+            try:
+                validation = model.predict(data_train)
+            except Exception:
+                pass  # Попытка получить валидацию через модель, но тут может возникнуть что угодно
+
+        if data_train.shape[0] != df.shape[0]:
+            endog = pd.concat((endog, df[target_column]))
+
+        assert 'TimeSeries Plot requires "forecast" column in "df" argument'
+        forecast = df['forecast']
+
+        m_ticks = 10  # noqa: F841
+
+        min_y = float(min([forecast.min(), endog.min()]))
+        max_y = float(max([forecast.max(), endog.max()]))
+
+        trace_real = dict(
+            x=endog.index.tolist(),
+            y=endog.tolist(),
+            type='scatter',
+            name='Исторические данные',
+            mode='lines+markers',
+            line=dict(color='#1F8AD8', width=2),
+            marker=dict(size=6),
+            # hovertemplate='<i>%{x}</i>' + '<br><i>%{y}</i>',
+            hoverlabel=dict(font=dict(color='black')),
+        )
+
+        trace_val = None
+        if validation is not None:
+            trace_val = dict(
+                x=endog_train.index.tolist(),
+                y=validation.tolist(),
+                type='scatter',
+                name='Валидация',
+                mode='lines',
+                line=dict(color='orange', width=2),
+                hovertemplate='<i>1%{x}</i>' + '<br><i>%{y}</i>',
+            )
+
+        forecast = forecast[pd.notna(forecast)]
+        trace_model = dict(
+            x=forecast.index.tolist(),
+            y=forecast.tolist(),
+            type='scatter',
+            name='Прогноз значений',
+            mode='lines+markers',
+            line=dict(dash='dot', width=2, color='firebrick'),
+            marker=dict(size=6),
+            legendgroup='Прогноз значений',
+            hovertemplate='<i>%{x}</i>' + '<br><i>%{y}</i>',
+            showlegend=True,
+        )
+
+        trace_0 = {}
+        if data_train.shape[0] != df.shape[0]:
+            trace_0 = dict(
+                x=[df.index.tolist()[0], df.index.tolist()[0]],
+                y=[min_y - 300, max_y + 300],
+                type='scatter',
+                mode='lines',
+                line=dict(dash='dash', width=2, color='black'),
+                hoverinfo='none',
+                showlegend=False,
+            )
+
+        layout = self.compile_layout()
+
+        layout.update(
+            dict(
+                legend=dict(
+                    x=0.25,
+                    y=1.04,
+                    orientation='h',
+                    tracegroupgap=12,
+                    font=dict(family='Arial', color='black', size=18),
+                ),
+                margin=dict(l=0, r=0, t=100, b=40),
+                showlegend=True,
+            )
+        )
+
+        data = [trace_real, trace_model, trace_0]
+        if trace_val is not None:
+            data.append(trace_val)
+
+        return {'data': data, 'layout': layout}
+
+    @classmethod
+    def check_to_show(cls, data_types=None, columns=None, **kwargs) -> bool:
+        columns = cls.filter_dtypes_columns(data_types, methods=['datetime'], columns=['index'] + columns)
+
+        return len(columns) > 0
