+from __future__ import annotations
+
+import numpy as np
+import pandas as pd
+import plotly.figure_factory as ff
+import plotly.graph_objs as go
+from scipy.cluster import hierarchy
+
+from .base_method import BaseMethod
+from ..models._ml_model_protocol import MLModel
+
+
+class CustomedDendrogram(ff._dendrogram._Dendrogram):
+    """
+    Plotly's _Dendrogram modification
+    """
+
+    def __init__(self, *args, truncate_mode: str | None = 'lastp', p=10, **kwargs):
+        self.truncate_mode: str | None = truncate_mode
+        self.p: int = p
+        super().__init__(*args, **kwargs)
+
+    def get_dendrogram_traces(self, X, colorscale, distfun, linkagefun, hovertext, color_threshold, **kwargs):
+        """
+        Plotly's _Dendrogram modification
+        """
+        P = hierarchy.dendrogram(
+            X,
+            orientation=self.orientation,
+            no_plot=True,
+            color_threshold=color_threshold,
+            truncate_mode=self.truncate_mode,
+            p=self.p,
+        )
+
+        icoord = np.array(P['icoord'])
+        dcoord = np.array(P['dcoord'])
+        ordered_labels = np.array(P['ivl'])
+        color_list = np.array(P['color_list'])
+        colors = self.get_color_dict(colorscale)
+
+        trace_list = []
+
+        for i in range(len(icoord)):
+            # xs and ys are arrays of 4 points that make up the '∩' shapes
+            # of the dendrogram tree
+            if self.orientation in ['top', 'bottom']:
+                xs = icoord[i]
+            else:
+                xs = dcoord[i]
+
+            if self.orientation in ['top', 'bottom']:
+                ys = dcoord[i]
+            else:
+                ys = icoord[i]
+            color_key = color_list[i]
+
+            trace = dict(
+                type='scatter',
+                x=np.multiply(self.sign[self.xaxis], xs),
+                y=np.multiply(self.sign[self.yaxis], ys),
+                mode='lines',
+                marker=dict(color=colors[color_key]),
+                hoverinfo='text',
+            )
+
+            try:
+                x_index: str = str(int(self.xaxis[-1]))
+            except ValueError:
+                x_index = ''
+
+            try:
+                y_index: str = str(int(self.yaxis[-1]))
+            except ValueError:
+                y_index = ''
+
+            trace['xaxis'] = 'x' + x_index
+            trace['yaxis'] = 'y' + y_index
+
+            trace_list.append(trace)
+
+        return trace_list, icoord, dcoord, ordered_labels, P['leaves']
+
+
+class Dendrogram(BaseMethod):
+    exclude_types = {'object', 'datetime64'}
+    styles_fields_exclude = {
+        'line_type',
+        'scheme_color',
+        'marker_color',
+        'multiple_axes',
+        'data_slice',
+    }
+
+    orientation = {'left': 'left', 'right': 'right', 'top': 'top', 'bottom': 'bottom'}
+    truncate_mode_dict = {'lastp': 'lastp', 'level': 'level'}
+
+    columns_templates = [
+        {
+            'label': 'Truncate mode',
+            'name': 'truncate_mode',
+            'default': 'lastp',
+            'source': 'truncate_mode',
+            'include_non_selected': True,
+        },
+        {
+            'label': 'Parameter for truncation',
+            'name': 'p',
+            'default': '',
+            'source': 'p',
+        },
+        {
+            'label': 'Orientation',
+            'name': 'orientation',
+            'default': 'bottom',
+            'source': 'orientation',
+            'include_non_selected': True,
+        },
+    ]
+
+    def __init__(self):
+        super().__init__()
+        self.column = None
+        self.truncate_mode: str = 'lastp'
+        self.p: int | None = None
+
+    def plot(self, df: pd.DataFrame, *args, styles: dict[str, str] | None = None, **kwargs):
+        """
+        Plot dendrogram for selected column
+        :param df:
+        :param args:
+        :param styles:
+        :param kwargs:
+        :return:
+        """
+        assert len(df) != 0, 'Passed empty DataFrame'
+        assert not df.isna().any().any(), 'Input X contains NaN.'
+
+        model: MLModel | None = kwargs.get('model', None)
+        if model is None:
+            raise ValueError('Model for the plot is not provided')
+
+        if kwargs.get('test_remote', None):  # for testing on remote datasets
+            model = model.fit(df)
+
+        self.update_styles(styles=styles)
+
+        orientation = kwargs.get('orientation', 'bottom')
+        if orientation == self.non_selected:
+            orientation = self.orientation['bottom']
+
+        # create the counts of samples under each node
+        counts = np.zeros(model.children_.shape[0])
+        n_samples = len(model.labels_)
+        for i, merge in enumerate(model.children_):
+            current_count = 0
+            for child_idx in merge:
+                if child_idx < n_samples:
+                    current_count += 1  # leaf node
+                else:
+                    current_count += counts[child_idx - n_samples]
+            counts[i] = current_count
+
+        try:
+            linkage_matrix = np.column_stack([model.children_, model.distances_, counts]).astype(float)
+        except AttributeError:  # Если в модели не были посчитаны distances, нужно их посчитать
+            model.set_params(compute_distances=True)
+            df = df.drop(['clusters'], axis=1).select_dtypes(exclude=['object'])
+            model = model.fit(df)
+            linkage_matrix = np.column_stack([model.children_, model.distances_, counts]).astype(float)
+
+        truncate_mode = kwargs.get('truncate_mode', 'lastp')
+        p = int(kwargs.get('p', '10')) if len(kwargs.get('p', '')) > 0 else None
+
+        if not p:
+            if truncate_mode:
+                p = model.n_clusters + 1
+
+        dendrogram = CustomedDendrogram(linkage_matrix, orientation, truncate_mode=truncate_mode, p=p)
+        fig = go.Figure(data=dendrogram.data, layout=dendrogram.layout)
+
+        layout = self.compile_layout()
+
+        xaxis_title = (
+            'Number of points in node (or index of point if no parenthesis).'
+            if layout['xaxis_title'] in ['', None]
+            else layout['xaxis_title']
+        )
+        yaxis_title = 'Euclidean Distance' if layout['yaxis_title'] in ['', None] else layout['yaxis_title']
+
+        if orientation in ['left', 'right']:  # меняем местами оси при другой ориентации
+            if layout['xaxis_title'] in ['', None]:
+                temp = xaxis_title
+                xaxis_title = yaxis_title
+                if layout['yaxis_title'] in ['', None]:
+                    yaxis_title = temp
+
+        fig.update_layout(layout)
+
+        fig.update_xaxes(title=xaxis_title)
+        fig.update_yaxes(title=yaxis_title)
+
+        return fig.to_plotly_json()
+
+    @classmethod
+    def get_columns(
+        cls,
+        data_types: dict | None = None,
+        columns: str | None = None,
+        instance: Dendrogram | None = None,
+        **kwargs,
+    ):
+        selected_orientation = cls.non_selected
+        selected_truncate_mode = 'lastp'
+        p = ''
+
+        columns_info = {
+            'truncate_mode': dict(map(lambda v: (v, v == selected_truncate_mode), cls.truncate_mode_dict.keys())),
+            'p': p,
+            'orientation': dict(map(lambda v: (v, v == selected_orientation), cls.orientation.keys())),
+        }
+
+        return columns_info
+
+    @classmethod
+    def check_to_show(cls, *args, data_types=None, **kwargs):
+        columns = kwargs.get('columns', []) if kwargs.get('columns', []) else list(data_types.keys())
+
+        has_clusters = 'clusters' in columns
+        is_types_numeric = len(cls.filter_dtypes_columns(data_types=data_types, methods=['number'])) > 0
+
+        # TODO: переписать после рефакторинга
+
+        # node = kwargs.get('node', None)
+        # is_hierarchical = (
+        #     node.properties.get('models_title', {}).get('value', '')
+        #     == 'AgglomerativeClustering'
+        #     if node
+        #     else None
+        # )
+        return is_types_numeric and (has_clusters or kwargs.get('is_test', False))  # (has_clusters and is_hierarchical)
