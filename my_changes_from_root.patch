+import numpy as np
+import plotly.graph_objects as go
+from django.conf import settings
+from matplotlib import pyplot as plt
+from PIL import Image
+
+
+def cut_image(img_path, fields_size=10):
+    """
+    Обрезает белые поля у изображения.
+    :img_path: путь до файла.
+    :fields_size: ширина белой рамки вокруг основного изображения.
+    :return:
+    """
+    img = np.array(Image.open(img_path))
+    indices_cols = img.min(axis=2).mean(axis=0)
+    indices_rows = img.min(axis=2).mean(axis=1)
+
+    index_left = max(0, np.where(indices_cols < 255)[0][0] - fields_size)
+    index_right = min(img.shape[1], np.where(indices_cols < 255)[0][-1] + fields_size)
+
+    index_top = max(0, np.where(indices_rows < 255)[0][0] - fields_size)
+    index_bottom = min(img.shape[0], np.where(indices_rows < 255)[0][-1] + fields_size)
+
+    img = img[index_top:index_bottom, index_left:index_right, :]
+    plt.imsave(img_path, img.astype('uint8'))
+
+
+def render_image(img_path):
+    img = Image.open(img_path)
+    img_width, img_height = img.size
+
+    fig = go.Figure()
+
+    fig.add_trace(go.Scatter(x=[0, img_width], y=[0, img_height], mode='markers'))
+
+    fig.update_xaxes(
+        visible=False,
+        range=[0, img_width],
+    )
+
+    fig.update_yaxes(visible=False, range=[0, img_height], scaleanchor='x')
+
+    image_url = settings.URL_SCHEME + settings.DOMAIN + '/api/' + img_path
+    fig.add_layout_image(
+        x=0,
+        sizex=img_width,
+        y=img_height,
+        sizey=img_height,
+        xref='x',
+        yref='y',
+        source=image_url,  # / for relative media path
+    )
+
+    fig.update_layout(
+        margin={'l': 0, 'r': 0, 't': 0, 'b': 0},
+    )
+    return fig.to_plotly_json()
