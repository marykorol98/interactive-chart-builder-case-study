+                    y=hist,
+                    name=str(category_name) or str(self.column),
+                    marker_color=colors[number + 1 if number < len(colors) else 1],
+                    width=self.calculate_bar_width(bin_edges[1] - bin_edges[0], len(bin_edges)),
+                )
+                fig.add_trace(hist_fig, row=number // cols + 1, col=number % cols + 1)
+                number += 1
+
+        if number == 0:
+            raise Exception(f'Нет данных для отрисовки в столбце {self.column} c группировкой по {self.group_by_col}')
+
+        if self.same_xlim:
+            fig.update_xaxes(range=[x_min, x_max])
+
+        return fig
+
+    def plot(self, df, *args, styles: dict[str, str] | None = None, **kwargs) -> Any:
+        """
+        Отобразить сетку с гистограммами столбца, сгруппированных по выбранному столбцу
+        :param df:
+        :param args:
+        :param styles:
+        :param kwargs:
+        :return:
+        """
+        column, group_by_column = (
+            kwargs.get('column', None),
+            kwargs.get('group_by', self.non_selected),
+        )
+
+        if column is None:
+            raise Exception('Необходимо выбрать целевой столбец, для которого будет построена гистограмма')
+        if column == group_by_column:
+            raise Exception('Столбец для гистограммы не должен быть таким же, как и столбец "Группировать по"')
+
+        self.column, self.group_by_col = column, group_by_column
+        self.same_xlim = kwargs.get('same_xlim', False)
+        if styles:
+            styles['xaxis_title'] = re.sub(r'(Значения).*', r'\g<1> ' + column, styles['xaxis_title'])
+
+        self.update_styles(styles=styles)
+        df = df.df if hasattr(df, 'df') else df
+        dfs_by_categories = self.get_series(df, kwargs, [column], group_by_col=group_by_column)
+        fig = self.plot_frequencies(dfs_by_categories)
+        dfs_by_categories = dfs_by_categories[0][1]
+
+        layout = self.compile_layout()
+
+        xaxis_title = layout['xaxis_title'] if layout['xaxis_title'] not in [None, ''] else column
+        yaxis_title = layout['yaxis_title'] if layout['yaxis_title'] not in [None, ''] else 'Frequency'
+
+        # Отменяем поворот для случаев с недлинным индексом
+        layout['xaxis_tickangle'] = (
+            0
+            if len(dfs_by_categories) <= 20 and layout.get('xaxis_tickangle', 45) == 45
+            else layout.get('xaxis_tickangle', 45)
+        )
+        fig.update_layout(
+            {
+                **layout,
+                'legend': {
+                    'orientation': 'h',
+                    'xanchor': 'right',
+                    'yanchor': 'bottom',
+                    'x': 1,
+                    'y': 1,
+                },
+                'xaxis_title': xaxis_title,
+                'yaxis_title': yaxis_title,
+            }
+        )
+
+        fig._layout['template']['layout']['xaxis']['title'] = {'text': xaxis_title}
+        fig._layout['template']['layout']['yaxis']['title'] = {'text': yaxis_title}
+        fig.update_traces({'marker': {'line': {'width': 0}}})
+
+        return fig.to_plotly_json()
+
+    @classmethod
+    def plot_scaled(cls, df, column, **kwargs):
+        series = df[column]
+
+        hist, bin_edges = np.histogram(
