+import numpy as np
+import pandas as pd
+
+from ..data.exceptions import PlottingAbsentColumnExceptions
+from ._sorting_mixin import SortingMixin
+from .base_method import BaseMethod
+
+
+class TableVisualiser(SortingMixin, BaseMethod):
+    styles_fields = []  # This plot is without styles
+
+    columns_templates = [
+        {
+            'label': 'Столбцы',
+            'name': 'columns',
+            'source': 'columns',
+            'multi': True,
+        },
+    ]
+
+    def plot(self, df, *args, columns=None, styles: dict[str, str] | None = None, **kwargs):
+        proba: np.ndarray = kwargs.get('proba', np.ndarray([]))
+
+        self.columns = columns = columns or kwargs.get('columns', list[str])
+        if columns is None or len(columns) == 0:
+            raise PlottingAbsentColumnExceptions(self.MESSAGE_COLUMNS_EMPTY)
+
+        self.set_sorting_states(kwargs.get('sort_column'), kwargs.get('reverse'))
+        self.update_styles(styles=styles)
+
+        df_reduced = self.get_series(df, kwargs, self.columns, ignore_index=False)
+        assert len(df_reduced) == 1, 'The input data was split into several dfs, check'
+        df = df_reduced[0][1]
+
+        if proba is not None:
+            assert (
+                df.shape[0] == proba.shape[0]
+            ), 'Неверный размер массива proba. Размер массива {rows_proba} на {cols_proba}. Ожидается размер {rows_df} на {cols_df}'.format(
+                rows_proba=proba.shape[0],
+                cols_proba=proba.shape[1],
+                rows_df=df.shape[0],
+                cols_df=proba.shape[1],
+            )
+            proba = np.round(proba, 2)
+            df_for_merge = pd.DataFrame(
+                proba,
+                index=df.index,
+                columns=['proba_{}'.format(i) for i in range(proba.shape[1])],
+            )
+            df = pd.concat([df, df_for_merge], axis=1, sort=False)
+
+        df_selected_columns = df[self.columns]
+        assert not df_selected_columns.empty, 'Не выбран ни один столбец'
+
+        if len(df_selected_columns.columns) > 10:
+            df_selected_columns = df_selected_columns.iloc[:, [0, 1, 2, 3, 4, 5, -5, -4, -3, -2, -1]]
+            df_selected_columns.iloc[:, [5]] = '...'
+            cols = list(df_selected_columns.columns)
+            cols[5] = '...'
+            df_selected_columns.columns = cols
+
+        html_df = df_selected_columns.to_html(max_rows=6, classes=['table', 'table-hover'], border=0, justify='left')
+        return html_df
+
+    @classmethod
+    def get_df_info(
+        cls,
+        data_types: dict | None = None,
+        columns: list[str] | None = None,
+        instance: BaseMethod | None = None,
+    ):
+        if columns is None:
+            columns = []
+
+        columns = cls.filter_dtypes_columns(data_types, methods=['number', 'string', 'object'], columns=columns)
+
+        selected_columns = instance.columns if instance is not None else columns
+        columns_data = dict(map(lambda col: (col, col in selected_columns), columns))
+
+        return {'columns': columns_data}, columns_data
+
+    @classmethod
+    def get_template(cls, data_types=None, columns=None, instance=None, **kwargs):
+        template_columns, sorting_columns = cls.get_df_info(data_types, columns, instance)
+
+        return super().get_template(
+            data_types,
+            columns,
+            instance,
+            template_columns=template_columns,
+            sorting_columns=sorting_columns,
+            **kwargs,
+        )
+
+    @classmethod
+    def get_json(cls, data_types=None, columns=None, instance=None, **kwargs):
+        template_columns, sorting_columns = cls.get_df_info(data_types, columns, instance)
+
+        return super().get_json(
+            data_types,
+            columns,
+            instance,
+            template_columns=template_columns,
+            sorting_columns=sorting_columns,
+            **kwargs,
+        )
+
+    @classmethod
+    def check_to_show(cls, columns=None, data_types=None, **kwargs):
+        columns = cls.filter_dtypes_columns(data_types, methods=['number', 'string', 'object'], columns=columns)
+        return len(columns) > 0
