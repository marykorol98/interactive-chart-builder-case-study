@@ -0,0 +1,35 @@
+from .style_element import StyleElement
+
+
+class StyleModificator:
+    def __init__(
+        self,
+        id_: str,
+        label: str | None = None,
+        value: str | float | int | bool | None = None,
+        options: dict[str, str] | None = None,
+    ):
+        assert label or value or options, 'One of label, value or options must be passed'
+
+        self._id = id_
+        self._label = label
+        self._value = value
+        self._options = options
+
+    @property
+    def id(self):
+        return self._id
+
+    def modify(self, style: StyleElement) -> StyleElement:
+        style_new = style.copy()
+
+        if self._label:
+            style_new._label = self._label
+
+        if self._value:
+            style_new._value = self._value
+
+        if self._options:
+            style_new._options = self._options
+
+        return style_new
