+    - Ветви показывают направление разделения в зависимости от значений признаков.
+    - Листовые узлы содержат итоговые предсказания класса и распределение по классам.
+    - Цвета узлов соответствуют предсказанным классам, а насыщенность цвета указывает на уверенность модели в этом классе (чем насыщеннее — тем выше уверенность).
+    - В правом нижнем углу отображается легенда, где указано, какому классу соответствует каждый цвет узла.
+
+    ⚙️ Пользовательские параметры:
+    - Tree index — выбор конкретного дерева в ансамбле (например, в лесу из 100 деревьев можно выбрать 0–99).
+    - Max depth — ограничение глубины дерева, полезно для фокусировки на ключевых уровнях логики.
+
+    🧠 Как интерпретировать:
+    - Чтение дерева начинается с корня (самый верхний узел) и движется вниз по ветвям.
+    - Каждое условие в узле указывает, как делятся данные (например, `feature_3 <= 1.5`).
+    - Дочерние узлы представляют подмножества данных, соответствующие условиям.
+    - Чем глубже узел, тем более специфичным становится разделение.
+    - Листовой узел показывает, какой класс был присвоен, и может содержать информацию о количестве образцов.
+
+    📌 Назначение:
+    - Анализировать, как модель принимает решения.
+    - Проверять, какие признаки наиболее важны.
+    - Упрощённая отладка и объяснение модели в терминах логики.
+    - Используется в Explainable AI (XAI) для визуального обоснования выводов модели.
+    '''
+    
+    params_description: dict[str, str] = {
+        'tree_index': 'Индекс дерева в ансамбле (например, в Random Forest). Позволяет выбрать конкретное дерево для визуализации.',
+        'max_depth': 'Максимальная глубина визуализируемого дерева. Помогает ограничить количество уровней для улучшения читаемости графа.',
+    }
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+
+        self.tree_index: int | None = None
+        self.max_depth: int = self.MAX_DEPTH_DEFAULT
+
+    def update_properties(self, properties: dict[str, Any]):
+        self.tree_index = None
+        if tree_index := properties.get('tree_index'):
+            try:
+                self.tree_index = int(tree_index)
+            except ValueError as e:
+                raise PlottingParametersException("Parameter 'tree_index' must be an integer") from e
+            
+        self.max_depth = properties.get('max_depth')
+
+    def validate_model(self, model: BaseModel | None) -> BaseModel:
+        model = super().validate_model(model)
+        instance = model.instance_model
+        if not hasattr(instance, 'tree_') and not hasattr(instance, 'estimators_'):
+            raise PlottingParametersException(
+                'The model should have such attrubutes as `tree_` or `estimators_` (as '
+                'DecisionTreeClassifier, for example). '
+            )
+
+        return model
+    
+    def extract_class_color_map(self, dot_data: str, simple: bool = False) -> dict[str, str | list[str]]:
+        pattern = re.compile(
+            r'label=.*?class = (?P<class>[^\n"]+).*?fillcolor="(?P<color>#[0-9a-fA-F]+|\w+)"',
+            re.DOTALL
+        )
+
+        class_to_colors = defaultdict(list)
+
+        for match in pattern.finditer(dot_data):
+            class_name = match.group("class").strip()
+            color = match.group("color").strip()
+            class_to_colors[class_name].append(color)
+            
+        if simple:
+
+            # Выбираем наиболее частый оттенок для каждого класса
+            dominant_color_map = {
+                cls: Counter(colors).most_common(1)[0][0]
+                for cls, colors in class_to_colors.items()
+            }
+
+            return dominant_color_map
+        else: 
+            return class_to_colors
+        
+        
+    
+    def generate_simple_legend_dot(self, class_color_map: dict[str, str]) -> str:
+        legend_nodes = ""
+        for i, (class_name, color) in enumerate(class_color_map.items()):
+            legend_nodes += f'"legend_{i}" [label="{class_name}", style=filled, fillcolor="{color}", shape=box];\n'
+
+        legend_subgraph = f"""
+        subgraph cluster_legend {{
+            label="Legend";
+            style=dashed;
+            fontsize=12;
+            {legend_nodes}
+        }}
+        """
+        return legend_subgraph
+    
+    def generate_gradient_legend_dot(self, class_to_colors: dict[str, list[str]]) -> str:
+        legend_nodes = ""
+        node_id = 0
+
+        for class_name, colors in class_to_colors.items():
+            unique_colors = list(dict.fromkeys(colors))  # Убираем дубликаты, сохраняя порядок
+
+            for j, color in enumerate(unique_colors):
+                label = f"{class_name}" if j == 0 else ""
+                legend_nodes += (
+                    f'"legend_{node_id}" [label="{label}", style=filled, fillcolor="{color}", shape=box, width=0.4, height=0.3];\n'
+                )
+                node_id += 1
+
+        legend_subgraph = f"""
+        subgraph cluster_legend {{
+            label="Legend (All Color Variants)";
+            style=dashed;
+            fontsize=12;
+            {legend_nodes}
+        }}
+        """
+        return legend_subgraph
+
+    def plot(
+        self,
+        ddf: DictDataFrame,
+        properties: dict[str, Any],
+        styles: dict[str, Any],
+        boto_handler: Callable[[io.BytesIO, str], Any] | None = None,
+        **kwargs,
+    ):
+        graphviz_import.check()
+
+        if boto_handler is None:
+            raise ValueError('Could not save the plot to storage (s3): boto_handler is not defined')
+
+        self.update_styles(styles=styles)
+        self.update_properties(properties=properties)
+
+        model: MLModel = self.validate_model(kwargs.get('model')).instance_model
+
+        # Обычно в моделях sklearn есть эта информация
+        columns: list[str] = getattr(model, 'feature_names_in_', None)  # type: ignore
+
+        cls_ = model if hasattr(model, 'tree_') else model.estimators_[self.tree_index or 0]
+        class_names = getattr(cls_, 'classes_', np.ndarray([])).astype(str)
+        
+        color_scheme = self.styles.get('scheme_color').value
+        # colors = px.colors.qualitative.__dict__[color_scheme]
+
+        # dot_data: str = export_graphviz(cls_, feature_names=columns, class_names=class_names, rounded=True, filled=True, max_depth=self.max_depth)
