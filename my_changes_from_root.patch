+import numpy as np
+import plotly.graph_objs as go
+
+from . import exception_messages
+from .base_method import BaseMethod
+from .styles import StyleModificator
+
+
+class CorrelationMatrix(BaseMethod):
+    styles_fields_exclude = {
+        'line_type',
+        'marker_color',
+        'max_size',
+        'xaxis_title',
+        'yaxis_title',
+        'units',
+    }
+
+    columns_templates = [
+        {
+            'label': 'Столбцы',
+            'name': 'columns',
+            'source': 'columns',
+            'multi': True,
+        }
+    ]
+
+    styles_modificators = [StyleModificator(id_='data_slice', value=' ')]
+
+    @staticmethod
+    def cut_label(label, symbols):
+        new_label = label[:symbols]
+        if len(label) > symbols:
+            new_label += '...'
+        return new_label
+
+    def plot(
+        self,
+        df,
+        *args,
+        columns: list[str] | None = None,
+        styles: dict[str, str] | None = None,
+        **kwargs,
+    ):
+        if columns is None or len(columns) < 2:
+            raise Exception(exception_messages.NOT_ENOUGH_COLUMNS.format(cnt=2))
+        self.columns = columns
+
+        self.update_styles(styles=styles)
+
+        df_reduced = self.get_series(df, kwargs, columns)
+        assert len(df_reduced) == 1, 'The input data was split into several dfs, check'
+        df = df_reduced[0][1]
+
+        df_selected_columns = df[columns]
+        assert not df_selected_columns.empty, 'Не выбран ни один столбец'
+
+        corr = df_selected_columns.select_dtypes(include=[np.number]).corr()
+        labels = df_selected_columns.columns.tolist()
+        heat = go.Heatmap(
+            z=corr,
+            x=labels,
+            y=labels,
+            xgap=1,
+            ygap=1,
+            colorbar=dict(thickness=20, ticklen=3),
+            hoverinfo='text',
+            hovertemplate='Сorrelation indicator' + '<br><br><b>%{z:.3f}</b><extra></extra>',
+            colorscale=[self.get_colors()[0], '#AAAAAA', self.get_colors()[2]],
+            zmin=-1,
+            zmax=1,
+        )
+        layout = self.compile_layout()
+        layout['xaxis'].update(showgrid=False, tickangle=30, automargin=True)
+        layout['yaxis'].update(showgrid=False, tickangle=-25, autorange='reversed', automargin=True)
+
+        layout = go.Layout(layout)
+        return {'data': [heat.to_plotly_json()], 'layout': layout}
+
+    @classmethod
+    def get_columns(cls, data_types=None, columns=None, instance=None, **kwargs):
+        columns = cls.filter_dtypes_columns(data_types, methods=['number'], columns=columns)
+        columns = cls.filter_not_proba_columns(columns)
+        selected_columns = instance.columns if instance else columns  # по дефолту выбраны все
+        columns = dict(map(lambda col: (col, col in selected_columns), columns))
+        return {'columns': columns}
+
+    @classmethod
+    def check_to_show(cls, columns=None, data_types=None, **kwargs):
+        columns = cls.filter_dtypes_columns(data_types, methods=['number'], columns=columns)
+        return len(columns) > 1
