+from __future__ import annotations
+
+import os
+from abc import ABC, abstractmethod
+from typing import Any, Callable
+from uuid import uuid4
+
+import numpy as np
+import pandas as pd
+import plotly.express as px
+from django.conf import settings
+
+from smile_ml_core.data.exceptions import PlottingParametersException
+from smile_ml_core.data.structures import DictDataFrameRemote
+from smile_ml_core.data.tools import get_type
+from smile_ml_core.plot_methods.styles import StyleModificator, Styles, StyleString
+
+
+def get_js_type(python_type_name: str) -> str:
+    if python_type_name == 'str':
+        return 'string'
+    if python_type_name == 'bool':
+        return 'boolean'
+    if python_type_name in ('int', 'float', 'Decimal'):
+        return 'number'
+    return 'object'
+
+
+def get_chosen_options(options_dict: dict) -> list[dict]:
+    return [
+        {'label': option_label, 'value': option_label}
+        for option_label in options_dict
+        if options_dict[option_label] is True
+    ]
+
+
+class BaseMethod(ABC):
+    MESSAGE_COLUMNS_EMPTY = 'The columns for plotting was not selected'
+    non_selected: str = 'Отсутствует'
+
+    reduce_max_size = 300
+    include_viewing_options: list[Any] = []
+    to_reduce = False
+    columns_templates: list[dict[str, Any]] = []  # The inputs in plot template for parameters set
+    special_columns_templates: list[dict[str, Any]] = []
+
+    styles_extra: list[Any] = []  # Here you can define new styles for a plot method
+    styles_fields: list | str = '__all__'
+    styles_fields_exclude: set[str] = set()
+
+    styles_modificators = [StyleModificator('max_size', value=reduce_max_size)]
+
+    def __init__(self):
+        self.layout = self.get_default_layout()
+        self.max_size = self.reduce_max_size
+        self.n_splits_max = 10
+
+        # удаляем едва видимый бежевый цвет
+        self.scheme_color = {
+            'light': list(filter(lambda x: x != '#FED4C4', px.colors.qualitative.Light24)),
+            'dark': px.colors.qualitative.Dark24,
+        }
+
+        self.columns = []  # columns are used often
+        self._styles = Styles(
+            self.styles_extra,
+            self.styles_fields,
+            self.styles_modificators,
+            exclude=self.styles_fields_exclude,
+        )
+
+    @property
+    def styles(self):
+        return self._styles
+
+    def update_styles(self, styles: dict[str, str] | None):
+        if styles:
+            self._styles.update(styles=styles)
+
+    @staticmethod
+    def is_proba_column(column_name: str) -> bool:
+        return column_name.startswith('proba') or ':proba' in column_name
+
+    @classmethod
+    def generate_image_plots_dir(cls) -> None:
+        """Если каталог создан, то ошибка не вызывается"""
+        os.makedirs(settings.PLOT_IMAGES_SOURCE, exist_ok=True)
+
+    @property
+    def image_plots_source(self) -> str:
+        """Возвращает путь, где лежат графики"""
+        return settings.PLOT_IMAGES_SOURCE
+
+    @classmethod
+    def generate_hashed_plot_image_name(cls, *, input_name: str) -> str:
+        """Генерация названия результирующего файла"""
+        hash_ = uuid4().hex
+        return '{}_{}'.format(hash_, input_name)
+
+    @classmethod
+    def get_default_layout(cls) -> dict:
+        return {
+            'hovermode': 'closest',
+            'xaxis': {'tickangle': 0},
+            'yaxis': {'tickangle': 0},
+        }
+
+    @abstractmethod
+    def plot(self, *args, **kwargs):
+        raise NotImplementedError('Method "plot" is not realized in base method. Please extend this method')
+
+    @staticmethod
+    def group_by(index: pd.Series, group_by: np.ndarray | pd.Series | None, n_splits_max=10) -> list:
+        if group_by is None:
+            return [(None, index)]
+
+        categories = np.unique(group_by)
+        if categories.shape[0] > n_splits_max:
+            if pd.api.types.is_numeric_dtype(group_by.dtype):
+                categories = []
+                for p_current in range(0, 100, 20):
+                    p_next = p_current + 20
+                    a, b = (
+                        np.percentile(group_by, p_current),
+                        np.percentile(group_by, p_next),
+                    )
+                    categories.append((a, b))
+            else:
+                categories_counts = np.unique(group_by, return_counts=True)
+                categories = [cat[0] for cat in sorted(zip(*categories_counts), key=lambda v: v[1], reverse=True)][
+                    n_splits_max
+                ]
+
+        indices_out = []
+        for cat in categories:
+            if isinstance(cat, tuple):
+                indices = index[(group_by >= cat[0]) & (group_by < cat[1])]
+                name = f'{round(cat[0], 2)}-{round(cat[1], 2)}'
+            else:
+                indices, name = index[group_by == cat], cat
+
+            indices_out.append((name, indices))
+
+        return indices_out
+
+    @staticmethod
+    def get_one_series(df, additional_data, col):
+        df_contains_col = df is not None and col in df.columns
+        assert col == 'index' or df_contains_col or col in additional_data, (
+            'The input data does not contain column %(column)s' % {'column': col}
+        )
+
+        if col == 'index':
+            return df.index if hasattr(df, 'index') else None
+        else:
+            s = df[col].values if df_contains_col else additional_data[col]
+
+        assert pd.notna(s).any(), f'Столбец {col} содержит только nan значения.'
+
+        return s
+
+    def get_series(
+        self,
+        df: pd.DataFrame,
+        additional_data: dict,
+        columns: list,
+        index_col: str = 'index',
+        group_by_col: str | None = None,
+    ):
+        """
+
+        :param df:
+        :param additional_data:
+        :param columns:
+        :param index_col: str,
+        :param group_by_col: str, The column to group input data
+        :return:
+        """
+        remote_service, df_path, max_size = None, None, None
+        if 'max_size' in self.styles:
+            max_size = self.styles['max_size'].value
+
+        if isinstance(df, DictDataFrameRemote) and df.is_remote:
+            remote_service, df_path = df.remote, df._paths
+        if remote_service is not None:
+            data = remote_service.get_remote_series(
+                df_path,
+                columns,
+                plot_class=self.__class__.__name__,
+                to_reduce=True,
+                index_col=index_col,
+                group_by_col=group_by_col,
+                max_size=max_size,
+            )
+
+            return data
+
+        return self._get_series(
+            df,
+            additional_data,
+            columns,
+            index_col=index_col,
+            group_by_col=group_by_col,
+            data_slice=self.styles.get('data_slice'),
+        )
+
+    @classmethod
+    def parse_slice_style(cls, data_slice_style: StyleString | None, shape: tuple[int, int | None]) -> slice:
+        if not data_slice_style:
+            return slice(None)  # По умолчанию берутся все данные
+
+        data_slice_str = str(data_slice_style.value).replace(' ', '')
+
+        data_slice = slice(*tuple(int(num) if num else None for num in data_slice_str.split(':')))
+
+        if data_slice != slice(None, None, None):
+            df_size = shape[0]
+
+            if data_slice.stop is not None and df_size < data_slice.stop:
+                data_slice = slice(data_slice.start, df_size, data_slice.step)
+
+            if data_slice.start is not None and df_size < data_slice.start:
+                raise PlottingParametersException(f'slice start must be less the size of df {shape[0]}')
+
+        return data_slice
+
+    @classmethod
+    def _get_series(
+        cls,
+        df: pd.DataFrame,
+        additional_data: dict,
+        columns: list[str],
+        index_col: str = 'index',
+        group_by_col: str | None = None,
+        data_slice_style: StyleString | None = None,
+        *args,
+        **kwargs,
+    ) -> list[tuple[None, Any]]:
+        df_out = pd.DataFrame(index=cls.get_one_series(df, additional_data, col=index_col))
+        for column in columns:
+            df_out[column] = cls.get_one_series(df, additional_data, col=column)
+
+        data_slice = cls.parse_slice_style(data_slice_style, df_out.shape)  # style 'Row Count (slice)'
+        df_out = df_out.iloc[data_slice]
+
+        group_by = None
+        if group_by_col is not None and group_by_col != cls.non_selected:
+            df = df.df if hasattr(df, 'df') else df
+            group_by = BaseMethod.get_one_series(df.iloc[data_slice], additional_data, col=group_by_col)
+            df_out[group_by_col] = group_by
+
+        if group_by is not None:
+            group_by = df_out.pop(group_by_col)
+
+        dfs_by_categories = []
+        for cat_name, indices in BaseMethod.group_by(df_out.index, group_by):
+            if cat_name is None:
+                dfs_by_categories.append((cat_name, df_out))
+            else:
+                dfs_by_categories.append((cat_name, df_out.loc[indices]))
+
+        return dfs_by_categories
+
+    @classmethod
+    def filter_dtypes_columns(
+        cls,
+        data_types: dict | None,
+        methods: list[str],
+        columns: list[str] | None = None,
+        exclude: list[str] | None = None,
+        extra_checking_methods: dict[str, Callable[[type], bool]] | None = None,
+    ) -> list[str]:
+        """
+
+        :param data_types:
+        :param methods: Методы для проверки доступных типов, если один из них проходит,
+                        то столбец добавляется
+        :param columns: необходимо для сортировки столбцов из data_types
+        :param exclude: Методы для исключения (для возможности разделения bool и number, string и object)
+        :param extra_checking_methods: Дополнительный словарь с функциями для расширения проверки типов
+                                       Например можно передать {geometry: lambda dt: isinstance(dt, ...)}
+        :return:
+        """
+        if data_types is None:
+            return []
+
+        if columns is None or len(columns) == 0:
+            columns = list(data_types.keys())
+
+        methods_dict = {
+            'bool': pd.api.types.is_bool_dtype,
+            'int': pd.api.types.is_integer_dtype,
+            'float': pd.api.types.is_float_dtype,
+            'category': lambda dt: dt is isinstance(dt, pd.CategoricalDtype),
+            'number': pd.api.types.is_numeric_dtype,  # includes int, float, bool
+            'string': lambda dt: dt is not np.ndarray and pd.api.types.is_string_dtype(dt),
+            'object': lambda dt: dt is not np.ndarray and pd.api.types.is_object_dtype(dt),
+            'array': lambda dtype: dtype is np.ndarray,
+            'datetime': pd.api.types.is_datetime64_any_dtype,
+        }
+        if extra_checking_methods:
+            methods_dict.update(extra_checking_methods)
+
+        columns_accessed = []
+        for col in filter(lambda c: c in data_types, columns):
+            el_type = data_types[col]
+
+            if any(map(lambda method_name: methods_dict[method_name](el_type), methods)) and all(
+                map(
+                    lambda method_name: not methods_dict[method_name](el_type),
+                    exclude or [],
+                )
+            ):
+                columns_accessed.append(col)
+
+        return columns_accessed
+
+    @classmethod
+    def filter_numerical_columns(cls, columns, data_types: dict):
+        except_columns = set(columns) - set(data_types.keys())  # Вычесть поля, которых вообще нет в данных
+        for col, data_type in data_types.items() or {}:
+            if not pd.api.types.is_numeric_dtype(data_type):
+                except_columns.add(col)
+
+        return list(filter(lambda c: c not in except_columns, columns))
+
+    @classmethod
+    def filter_complex_columns(cls, columns, data_types: dict):
+        except_columns = set(columns) - set(data_types.keys())  # Вычесть поля, которых вообще нет в данных
+        for col, data_type in data_types.items() or {}:
+            if data_type != np.ndarray:
+                except_columns.add(col)
+
+        return list(filter(lambda c: c not in except_columns, columns))
+
+    @classmethod
+    def filter_not_complex_columns(cls, columns, data_types: dict):
+        except_columns = set(columns) - set(data_types.keys())  # Вычесть поля, которых вообще нет в данных
+        for col, data_type in data_types.items() or {}:
+            if data_type == np.ndarray:
+                except_columns.add(col)
+
+        return list(filter(lambda c: c not in except_columns, columns))
+
+    @classmethod
+    def filter_not_proba_columns(cls, columns):
+        return list(filter(lambda c: not cls.is_proba_column(c), columns))
+
+    @classmethod
+    def get_columns(cls, *args, **kwargs) -> dict:
+        return {}
+
+    @classmethod
+    def get_json(cls, *args, **kwargs):
+        columns = cls.get_columns(*args, **kwargs)
+        columns_out = cls.format_json_data(columns)
+        return columns_out
+
+    @classmethod
+    def format_json_data(cls, columns: dict[str, Any]) -> list[dict[str, Any]]:
+        """
+        Форматирование данных для фронта на реакте.
+        """
+        all_column_templates = cls.columns_templates + cls.special_columns_templates
+        column_list = []
+
+        for column_key, column_value in columns.items():
+            column_template_list = list(
+                filter(
+                    lambda template: template.get('source') == column_key,
+                    all_column_templates,
+                )
+            )  # не только dict параметры должны парситься
+
+            if isinstance(column_value, dict):
+                if column_template_list:
+                    column_template = column_template_list[0]
+                    label = column_template['label']
+
+                    is_multi = column_template.get('multi', False)
+
+                    options_dict = column_value
+                    options = [{'label': option_label, 'value': option_label} for option_label in options_dict]
+                    if column_template.get('include_non_selected'):
+                        non_selected = column_template.get('non_selected', cls.non_selected)
+                        options.insert(0, {'label': non_selected, 'value': non_selected})
+
+                    chosen_options = get_chosen_options(options_dict)
+                    column_list.append(
+                        {
+                            'key': column_key,
+                            'label': label,
+                            'type': 'select',
+                            'isMulti': is_multi,
+                            'options': options,
+                            'value': chosen_options,
+                        }
+                    )
+                else:
+                    column_list.append(
+                        {
+                            'key': column_key,
+                            'value': column_value,
+                            'label': column_key,
+                            'type': get_js_type(
+                                type(column_value).__name__,
+                            ),
+                        }
+                    )
+            elif column_template_list:
+                column_template = column_template_list[0]
+                label = column_template['label']
+
+                column_list.append(
+                    {
+                        'key': column_key,
+                        'value': column_value,
+                        'label': label,
+                        'type': get_js_type(
+                            type(column_value).__name__,
+                        ),
+                    }
+                )
+            else:
+                column_list.append(
+                    {
+                        'key': column_key,
+                        'value': column_value,
+                        'label': column_key,
+                        'type': get_js_type(
+                            type(column_value).__name__,
+                        ),
+                    }
+                )
+        return column_list
+
+    @classmethod
+    def check_to_show(cls, data_types: dict | None = None, columns: list | None = None, **kwargs) -> bool:
+        return True
+
+    @classmethod
+    def get_viewing_settings_cls(cls, instance: None | BaseMethod):
+        if instance is not None:
+            return instance.get_viewing_settings()
+
+        # todo it is heavy and not fast
+        styles = Styles(
+            cls.styles_extra,
+            cls.styles_fields,
+            cls.styles_modificators,
+            exclude=cls.styles_fields_exclude,
+        )
+        return styles.to_dict()
+
+    def get_viewing_settings(self):
+        return self.styles.to_dict()
+
+    @classmethod
+    def compile_layout_cls(cls, layout: dict | None):
+        styles = Styles(
+            cls.styles_extra,
+            cls.styles_fields,
+            cls.styles_modificators,
+            exclude=cls.styles_fields_exclude,
+        )
+        return styles.form_layout(layout)
+
+    @classmethod
+    def get_viewing_json(cls, instance=None):
+        if instance is None:
+            instance = cls()  # FIXME Пока такой костыль, так как стили есть только в экземпляре
+
+        include_json = instance.styles.to_dict()
+
+        return include_json
+
+    def unit_style_implement(self, layout: dict | None) -> dict | None:
+        units = self.styles.get('units', '')
+
+        if isinstance(units, str) and len(units) == 0:
+            return layout
+
+        units = self.styles['units'].value.replace(' ', '').split(',')
+        unit_prefix_x = ', ' + units[0] if len(units[0]) > 0 else ''
+        unit_prefix_y = ', ' + units[1] if len(units) > 1 else ''
+
+        if layout is not None:
+            layout['xaxis_title'] = (
+                layout.get('xaxis_title') + unit_prefix_x if layout.get('xaxis_title', None) else None
+            )
+            layout['yaxis_title'] = (
+                layout.get('yaxis_title') + unit_prefix_y if layout.get('yaxis_title', None) else None
+            )
+
+        return layout
+
+    def compile_layout(self, layout_in: dict | None = None) -> dict[str, Any]:
+        layout = self.styles.form_layout(layout=layout_in)
+
+        layout['title'] = type(self).__name__ if layout.get('title') in ['', None] else layout['title']
+        layout = self.unit_style_implement(layout)
+        return layout
+
+    def check_columns_type(self, df, columns):
+        if df.shape[0] == 0:
+            raise ValueError('Passed empty DataFrame')
+
+        if hasattr(self, 'exclude_types'):
+            errors_dtypes = []
+            for col in columns:
+                if (type_str := get_type(df[col].dtype)) in self.exclude_types:
+                    errors_dtypes.append(f'{col} ({type_str})')
+
+            if errors_dtypes:
+                raise ValueError(f'Passed unacceptable ({self.exclude_types}) columns types: {errors_dtypes}')
+
+    @staticmethod
+    def get_colors():
+        return px.colors.qualitative.Light24 + px.colors.qualitative.Dark24
