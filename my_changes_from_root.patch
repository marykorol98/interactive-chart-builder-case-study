+    @staticmethod
+    def _plot_single_img(ax, img, shape=None, target=None, predict=None, transform=None, title: str = ''):
+        ax.set_axis_off()
+
+        cmap = None  # by default
+        if shape is not None and (len(img.shape) == 2 or len(img.shape) == 3 and img.shape[2] == 1):
+            # if the image is black-white
+            cmap = 'gray'
+
+        if transform is not None:
+            img = transform(img)
+
+        if shape in ['source', None] and hasattr(img, 'shape') and len(img.shape) == 1:
+            shape = int(np.sqrt(img.size))
+
+            if img.size == shape * shape:
+                shape = (shape, shape)
+            else:
+                raise Exception(
+                    'It is impossible to convert the size {size} automatically. '
+                    'Please enter correct shape in format: "(n_rows, n_cols)"'.format(size=img.size)
+                )
+
+        if shape not in ['source', None]:
+            img = img.reshape(shape)
+
+        ax.imshow(img, cmap=cmap)
+
+        if target is not None:
+            title += f'Real: {target}. '
+        if predict is not None:
+            title += f'M: {predict}.'
+
+        if title:
+            ax.set_title(title)
+
+    @classmethod
+    def get_columns(
+        cls,
+        data_types: dict,
+        columns=None,
