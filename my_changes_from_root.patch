+import pandas as pd
+import shap
+
+from smile_ml_core.plot_methods.shap_methods import PlotBaseShapMethod
+
+
+class BeesWarm(PlotBaseShapMethod):
+    input_name = 'beeswarm.png'
+
+    def shap_plot(
+        self,
+        shap_values: shap.Explanation,
+        df: pd.DataFrame,
+        target_column: str,
