+import numpy as np
+import pandas as pd
+import plotly.graph_objects as go
+
+from smile_ml_core.plot_methods import BaseMethod
+
+
+class AutoCorrelation(BaseMethod):
+    include_viewing_options = ['font_size', 'font_color', 'rot_x', 'rot_y']
+    styles_fields_exclude = {
+        'bg_color',
+        'multiple_axes',
+        'max_size',
+        'data_slice',
+        'line_type',
+        'scheme_color',
+        'marker_color',
+    }
+    columns_templates = [
+        {
+            'label': 'TimeIndex source',
+            'name': 'index_column',
+            'source': 'index_column',
+            'select_all': True,
+            'default': 'index',
+        },
+        {
+            'label': 'Target column',
+            'name': 'target_column',
+            'source': 'target_column',
+            'select_all': True,
+        },
+        {
+            'label': 'Alpha',
+            'name': 'alpha',
+            'default': '0.5',
+        },
+        {
+            'label': 'Lags',
+            'name': 'lags',
+            'default': '5',
+        },
+    ]
+
+    def __init__(self):
+        super().__init__()
+
+        self.index_column = None
+        self.label_column = None
+        self.lags = '5'
+        self.alpha = '0.5'
+
+    def plot(self, data: pd.DataFrame, target_column=None, **kwargs):
+        if target_column is None:
+            raise Exception('Целевой столбец является обязательным параметром')
+
+        try:
+            lags = int(kwargs.get('lags', '5'))
+        except:  # noqa: E722
+            raise Exception('Введите целое число в параметре графика "lags"')
+
+        try:
+            alpha = float(kwargs.get('alpha', '0.5'))
+        except:  # noqa: E722
+            raise Exception('Введите число (вещественное) в параметре графика "alpha".')
+        self.update_styles(kwargs.get('styles'))
+
+        df = data.df
+        index_column = kwargs.get('index_column', 'index')
+        if index_column != 'index':
+            if isinstance(df, pd.DataFrame):
+                df = df.set_index(index_column)
+            else:
+                df = df.df.set_index(index_column)
+        df = df[target_column]
+        if not isinstance(df, pd.Series):
+            df = pd.Series(df)
+
+        self.update_styles(kwargs.get('styles'))
+
+        from statsmodels.tsa.stattools import acf
+
+        corr_array = acf(df, alpha=alpha, nlags=lags)
+        lower_y = corr_array[1][:, 0] - corr_array[0]
+        upper_y = corr_array[1][:, 1] - corr_array[0]
+
+        fig = go.Figure()
+
+        [
+            fig.add_scatter(x=(x, x), y=(0, corr_array[0][x]), mode='lines', line_color='#3f3f3f')
+            for x in range(len(corr_array[0]))
+        ]
+
+        layout = self.compile_layout()
+        layout['title'] = (
+            layout['title'] + f' ({kwargs.get("index_column")})'
+            if layout['title'] == 'AutoCorrelation'
+            else layout['title']
+        )
+        fig.update_layout(layout)
+
+        fig.add_scatter(
+            x=np.arange(len(corr_array[0])),
+            y=corr_array[0],
+            mode='markers',
+            marker_color=self.get_colors()[0],
+            marker_size=12,
+            name='Autocorrelaion',
+        )
+        fig.add_scatter(
+            x=np.arange(len(corr_array[0])),
+            y=upper_y,
+            mode='lines',
+            line_color='rgba(255,255,255,0)',
+        )
+
+        fig.add_scatter(
+            x=np.arange(len(corr_array[0])),
+            y=lower_y,
+            mode='lines',
+            fillcolor='rgba(32, 146, 230, 0.3)',
+            fill='tonexty',
+            line_color='rgba(255,255,255,0)',
+        )
+        for trace in fig['data']:
+            if trace['name'] != 'points':
+                trace['showlegend'] = False
+
+        xaxis_title = 'Time Lags' if layout['xaxis_title'] in ['', None] else layout['xaxis_title']
+        yaxis_title = 'Correlation coeficcient' if layout['yaxis_title'] in ['', None] else layout['yaxis_title']
+
+        fig.update_xaxes(range=[-1, len(corr_array[0])], title=xaxis_title)
+        fig.update_yaxes(zerolinecolor='#000000', title=yaxis_title)
+
+        return fig.to_plotly_json()
+
+    @classmethod
+    def get_columns(cls, data_types=None, columns=None, instance=None, **kwargs):
+        target_column = cls.filter_dtypes_columns(data_types, methods=['number', 'bool'], columns=columns)
+        columns = ['index'] + cls.filter_dtypes_columns(data_types, methods=['datetime'], columns=columns)
+
+        selected_columns, selected_label_column = columns, target_column
+        lags, alpha = '5', '0.5'
+        columns_out = dict(map(lambda col: (col, col in selected_columns), columns))
+        target_column_data = dict(map(lambda col: (col, col == selected_label_column), target_column))
+        return {
+            'index_column': columns_out,
+            'target_column': target_column_data,
+            'lags': lags,
+            'alpha': alpha,
+        }
+
+    @classmethod
+    def check_to_show(cls, data_types=None, columns=None, **kwargs) -> bool:
+        if columns is None:
+            columns = []
+        columns_to_show = cls.filter_dtypes_columns(data_types, methods=['datetime'], columns=['index'] + columns)
+
+        return len(columns_to_show) > 0
