+import plotly.graph_objs as go
+from sklearn import metrics
+
+from ..models._class_state import ClassState
+from . import SortingMixin
+
+
+class ConfusionMatrix(SortingMixin):
+    styles_fields = []
+
+    columns_templates = [
+        {
+            'label': 'Столбец',
+            'name': 'predict_column',
+            'source': 'predict_column',
+        }
+    ]
+
+    def __init__(self):
+        super().__init__()
+
+        self.predict_column = None
+
+    def plot(
+        self,
+        df,
+        *args,
+        predict_column=None,
+        styles: dict[str, str] | None = None,
+        **kwargs,
+    ):
+        if len(args) == 0:
+            raise Exception('Failed to determine target')
+
+        if not predict_column:
+            raise Exception('Failed to determine predict column')
+
+        self.predict_column = predict_column
+
+        self.update_styles(styles=styles)
+
+        # df здесь идет без id, а target c ним. По этому здесь id мы вырезаем
+        target_column = args[0].rsplit(':', 1)[-1]
+        y_test, y_pred = df[target_column], df[self.predict_column]
+        labels = y_test.unique()
+
+        CM = metrics.confusion_matrix(y_pred, y_test, normalize='true')
+        heat = go.Heatmap(
+            x=labels,
+            y=labels,
+            z=CM,
+            xgap=1,
+            ygap=1,
+            colorscale='tealgrn',
+            hoverinfo='skip',
+        )
+
+        annotations = []
+        for i, row in enumerate(CM):
+            for j, value in enumerate(row):
+                annotations.append(
+                    {
+                        'x': labels[i],
+                        'y': labels[j],
+                        'text': str(round(value, 3)),
+                        'font': {'size': 20},
+                        'showarrow': False,
+                    }
+                )
+
+        layout = self.compile_layout()
+
+        layout['title'] = 'Confusion Matrix' if layout.get('title') == 'ConfusionMatrix' else layout.get('title')
+
+        if 'xaxis' not in layout:
+            layout['xaxis'] = {}
+        layout['xaxis'].update(showgrid=False, title='Predicted label', type='category')
+
+        if 'yaxis' not in layout:
+            layout['yaxis'] = {}
+        layout['yaxis'].update(showgrid=False, autorange='reversed', title='True label', type='category')
+
+        layout['annotations'] = annotations
+
+        layout = go.Layout(layout)
+        return {'data': [heat.to_plotly_json()], 'layout': layout}
+
+    @classmethod
+    def _get_mutable_features(cls, node):
+        if node.is_feature() or node.is_model(ClassState.Scorer):
+            features = node.features.input
+        else:
+            features = node.features.output
+
+        mutable_features = node.features.filter_by_property(features, is_mutable=True)
+        mutable_features_names = list(map(lambda f: f.get_name(), mutable_features.values()))
+
+        return mutable_features_names
+
+    @classmethod
+    def get_json(cls, data_types=None, columns=None, instance=None, **kwargs):
+        columns = cls.filter_dtypes_columns(data_types, methods=['number', 'string', 'object', 'bool'], columns=columns)
+
+        mutable_features_names = cls._get_mutable_features(kwargs.get('node'))
+        columns = list(filter(lambda c: c in mutable_features_names, columns))
+
+        predict_column = instance.predict_column if instance else columns[0] if columns else None
+        predict_columns = dict(map(lambda col: (col, col == predict_column), columns))
+
+        return cls.format_json_data({'predict_column': predict_columns})
+
+    @classmethod
+    def check_to_show(cls, data_types=None, columns=None, **kwargs):
+        columns = cls.filter_dtypes_columns(data_types, methods=['number', 'string', 'object', 'bool'], columns=columns)
+
+        mutable_features_names = cls._get_mutable_features(kwargs.get('node'))
+        columns = list(filter(lambda c: c in mutable_features_names, columns))
+
+        return len(columns) > 0
