+from typing import Any
+
+import plotly.graph_objs as go
+
+from ._sorting_mixin import SortingMixin
+from .base_method import BaseMethod
+
+
+class IndexToValuesPlot(SortingMixin, BaseMethod):
+    exclude_types = {'object', 'datetime64'}
+
+    styles_fields_exclude = {
+        'marker_color',
+    }
+
+    columns_templates = [
+        {
+            'label': 'Line type',
+            'name': 'line_type',
+            'source': 'line_type',
+            'include_non_selected': False,
+        },
+        {
+            'label': 'Column',
+            'name': 'columns',
+            'logarithm': True,
+            'source': 'columns',
+            'multi': True,
+        },
+        {
+            'label': 'Group by',
+            'name': 'label_column',
+            'source': 'label_column',
+            'include_non_selected': True,
+        },
+        {
+            'label': 'Average line',
+            'name': 'avg_line',
+            'source': 'avg_line',
+            'default': None,
+            'multi': False,
+            'include_non_selected': True,
+        },
+    ]
+
+    def __init__(self):
+        super().__init__()
+
+        self.columns = []
+        self.label_column = None
+        self.avg_line_column = None
+        self.line_type = 'markers'
+
+    def plot(
+        self,
+        df,
+        *args,
+        columns: list[str] | None = None,
+        styles: dict[str, str] | None = None,
+        **kwargs,
+    ):
+        if columns is None or len(columns) == 0:
+            raise Exception(self.MESSAGE_COLUMNS_EMPTY)
+
+        self.columns = columns
+        self.label_column = label_column_name = kwargs.get('label_column', self.non_selected)
+        self.avg_line_column = avg_line_column = kwargs.get('avg_line', None)
+        self.line_type = line_type = kwargs.get('line_type', self.line_type)
+
+        if len(columns) == 1 and columns[0] == label_column_name:
+            raise Exception('Значение "Столбец" не должно совпадать со значением "Группировать по"')
+
+        self.set_sorting_states(kwargs.get('columns_sort_by'), kwargs.get('reverse'))
+        self.update_styles(styles)
+
+        self.check_columns_type(df, columns)
+
+        marker_color = self.scheme_color[self.styles['scheme_color'].value]
+        is_logarithm = kwargs.get('logarithm', False)
+
+        traces = []
+        dfs_by_categories = self.get_series(df, kwargs, self.columns, group_by_col=label_column_name)
+        for i, (category_name, df_cat) in enumerate(dfs_by_categories):
+            df_cat = df_cat.dropna(axis=0)  # Если оставить Nan, линии будут отображаться некорректно
+            index = df_cat.index.tolist()
+
+            for j, col in enumerate(df_cat.columns):
+                name_cat = col if category_name is None else f'{col} ({category_name})'
+                color_i = i * len(df_cat.columns) + j
+                if color_i >= len(marker_color):
+                    raise IndexError(f'Too many columns to plot (>={color_i}): out of colors ({len(marker_color)})')
+
+                trace = go.Scatter(
+                    x=index,
+                    y=df_cat[col].tolist(),
+                    mode=line_type,
+                    line=dict(color=marker_color[color_i], width=2),
+                    name=name_cat,
+                    showlegend=True,
+                )
+
+                traces.append(trace.to_plotly_json())
+
+                # Средняя линия
+                if col == avg_line_column:
+                    trace = go.Scatter(
+                        mode='lines',
+                        x=index,
+                        y=[df_cat[avg_line_column].mean()] * len(index),
+                        line=dict(color=marker_color[color_i], width=2, dash='dash'),
+                        name=f'{name_cat}_avg',
+                        showlegend=True,
+                    )
+                    traces.append(trace.to_plotly_json())
+
+                    # делаем цвет более прозрачным попутно переводя hex в rgb формат
+                    rgb_color = tuple(int(marker_color[color_i][1:][i : i + 2], 16) for i in (0, 2, 4))
+                    light_color = rgb_color + (0.4,)
+
+                    # заливка
+                    trace2 = go.Scatter(
+                        mode='lines',
+                        x=index + index[::-1],
+                        y=df_cat[col].tolist() + ([df_cat[avg_line_column].mean()] * len(index))[::-1],
+                        fill='toself',
+                        fillcolor=f'rgba{light_color}',
+                        line=dict(color=marker_color[color_i], width=0, dash='dash'),
+                        name=f'{name_cat}_модуль',
+                        showlegend=True,
+                    )
+
+                    traces.append(trace2.to_plotly_json())
+
+        layout = self.compile_layout()
+        xaxis_title = 'Index' if layout['xaxis_title'] in ['', None] else layout['xaxis_title']
+        yaxis_title = 'Value' if layout['yaxis_title'] in ['', None] else layout['yaxis_title']
+        layout['xaxis'].update({'title': xaxis_title})
+        layout['yaxis'].update({'title': yaxis_title})
+
+        # Logarithm y_axis scale
+        if is_logarithm:
+            layout['yaxis'].update({'type': 'log'})
+        else:
+            layout['yaxis'].pop('type', None)
+
+        return {'data': traces, 'layout': layout}
+
+    @classmethod
+    def get_df_info(
+        cls,
+        data_types: dict[str, Any] | None = None,
+        columns=None,
+        instance=None,
+        **kwargs,
+    ):
+        columns_data = cls.filter_dtypes_columns(data_types, methods=['number', 'bool'], columns=columns)
+        label_column = cls.filter_dtypes_columns(data_types, methods=['number', 'object', 'string'], columns=columns)
+        avg_line = cls.filter_dtypes_columns(data_types, methods=['number', 'bool'], columns=columns)
+        line_types = ['markers', 'lines']
+
+        if instance:
+            (
+                selected_columns,
+                selected_group_by,
+                selected_avg_line,
+                selected_line_type,
+            ) = (
+                instance.columns,
+                instance.label_column,
+                instance.avg_line_column,
+                instance.line_type,
+            )
+        else:
+            selected_columns = [columns_data[0]] if columns_data else []
+            selected_group_by = None
+            selected_avg_line = None
+            selected_line_type = line_types[0]
+
+        columns_data_out = dict(map(lambda col: (col, col in selected_columns), columns_data))
+        label_column_out = dict(map(lambda col: (col, col == selected_group_by), label_column))
+        avg_line_out = dict(map(lambda col: (col, col == selected_avg_line), avg_line))
+        line_type = dict(map(lambda method: (method, method == selected_line_type), line_types))
+
+        kwargs['template_columns'] = {
+            'columns': columns_data_out,
+            'line_type': line_type,
+            'label_column': label_column_out,
+            'avg_line': avg_line_out,
+        }
+        kwargs['sorting_columns'] = columns_data
+        kwargs['line_type'] = line_type
+        return data_types, columns, instance, kwargs
+
+    @classmethod
+    def get_template(
+        cls,
+        data_types: dict[str, Any] | None = None,
+        columns=None,
+        instance=None,
+        **kwargs,
+    ):
+        data_types, columns, instance, kwargs = cls.get_df_info(
+            data_types=data_types, columns=columns, instance=instance, **kwargs
+        )
+
+        return super(IndexToValuesPlot, cls).get_template(data_types, columns, instance, **kwargs)
+
+    @classmethod
+    def get_json(
+        cls,
+        data_types: dict[str, Any] | None = None,
+        columns=None,
+        instance=None,
+        **kwargs,
+    ):
+        data_types, columns, instance, kwargs = cls.get_df_info(
+            data_types=data_types, columns=columns, instance=instance, **kwargs
+        )
+
+        return super(IndexToValuesPlot, cls).get_json(data_types, columns, instance, **kwargs)
+
+    @classmethod
+    def check_to_show(cls, data_types=None, columns=None, **kwargs):
+        columns = cls.filter_dtypes_columns(data_types, methods=['number'], columns=columns)
+        return len(columns) > 0
