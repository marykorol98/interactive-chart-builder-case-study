@@ -0,0 +1,101 @@
+import os
+from abc import ABC, abstractmethod
+from typing import TYPE_CHECKING, Dict, List, Optional, Union, Any
+
+from shap import Explanation
+
+from smile_ml_core.data.exceptions import PlottingSmallNumberValuesExceptions
+from smile_ml_core.plot_methods import BaseMethod
+
+if TYPE_CHECKING:
+    from sklearn.base import BaseEstimator
+
+import matplotlib.pyplot as plt
+import pandas as pd
+import plotly.graph_objects as go
+import shap
+from django.conf import settings
+
+
+class PlotBaseShapMethod(BaseMethod, ABC):
+    styles_fields: Union[list, str] = []
+    input_name = ''  # File name
+    min_values_count = 10
+
+    def plot(
+        self,
+        df: pd.DataFrame,
+        target_column: str,
+        styles: Optional[Dict[str, str]] = None,
+        *args,
+        **kwargs,
+    ):
+        self.update_styles(styles=styles)
+
+        shap_values = self.generate_shap_values(df, model=kwargs['model'], model_columns=kwargs['model_columns'])
+
+        self.shap_plot(shap_values, df, target_column, **kwargs)
+
+        file_name = self.generate_hashed_plot_image_name(input_name=self.input_name)
+        img_path = os.path.join(self.image_plots_source, file_name)
+
+        self.save_img(img_path)
+
+        fig = self.render_img_using_plotly(img_path)
+
+        return fig.to_plotly_json()
+
+    @classmethod
+    def generate_shap_values(cls, df: pd.DataFrame, model: 'BaseEstimator', model_columns: List[str]) -> 'Explanation':
+        if df.shape[0] < cls.min_values_count:
+            raise PlottingSmallNumberValuesExceptions(values_count=df.shape[0], min_count=cls.min_values_count)
+
+        X = df[model_columns]
+
+        X_instance = shap.utils.sample(X, nsamples=10 if len(X) <= 100 else 100)
+        explainer = shap.Explainer(model.predict, X_instance)
+
+        shap_values = explainer(X)
+        return shap_values
+
+    @abstractmethod
+    def shap_plot(self, shap_values: 'Explanation', df: pd.DataFrame, target_column: str, **kwargs):
+        pass
+
+    def save_img(self, img_path: str):
+        fig = plt.gcf()
+        fig.tight_layout()
+        fig.savefig(img_path)
+        plt.close(fig)
+
+    @staticmethod
+    def render_img_using_plotly(img_path: str) -> go.Figure:
+        fig = go.Figure()
+        fig.add_layout_image(
+            {
+                'source': f'{settings.URL_SCHEME}{settings.DOMAIN}/api/{img_path}',
+                'xref': 'x',
+                'yref': 'y',
+                'x': 1,
+                'y': 4,
+                'sizex': 5,
+                'sizey': 5,
+                'sizing': 'stretch',
+                'layer': 'below',
+            }
+        )
+
+        fig.update_layout(
+            template='plotly_white',
+            xaxis={'showgrid': False},
+            yaxis={'showgrid': False},
+        )
+        fig.update_xaxes(visible=False)
+        fig.update_yaxes(visible=False)
+
+        return fig
+
+    @classmethod
+    def check_to_show(cls, *args, data_types: Any = None, columns=None, **kwargs):
+        columns = cls.filter_dtypes_columns(data_types, methods=['string', 'array', 'object', 'bool'], columns=columns)
+        return len(columns) == 0
