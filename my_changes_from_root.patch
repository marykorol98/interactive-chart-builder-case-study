+    @staticmethod
+    def validate_shape(shape: str | tuple[int, ...] | None):
+        shape = None if shape in {'', 'None'} else shape
+        if isinstance(shape, str):
+            if shape.startswith('(') and shape.endswith(')'):
+                shape = shape[1:-1]
+
+            shape = tuple(map(lambda v: int(v.strip()), shape.split(',')))
+
+        return shape
+
+    @staticmethod
+    def get_el_by_index(series, i):
+        if series is not None:
+            return series[i]
+        return None
+
+    @classmethod
+    def _get_series(
+        cls,
+        df: pd.DataFrame,
+        additional_data: dict,
+        columns: list[str],
+        index_col: str = 'index',
+        group_by_col: str | None = None,
+        data_slice_style: StyleString | None = None,
+        *args,
+        **kwargs,
+    ) -> list[tuple[None, Any]]:
+        """
+        Для изображений не работает стандартная логика
+        :param data: DictDataFrame
+        :param additional_data:
+        :param columns:
+        :return:
+        """
+        data_is_nan = isinstance(df, np.ndarray)
+
+        res = []
+        if data_is_nan:
+            images = df
+        else:
+            if df is None:
+                df = additional_data
+
+            images = df.get(columns[0], None)
+
+        if images is None:
+            raise Exception('The images were not transferred for plotting')
+
+        res.append(images)
+
+        for col in columns[1:]:
+            s = None
+            if col is not None and col != cls.non_selected and not data_is_nan:
+                s = df.get(col)
+            res.append(s)
+
+        if 'max_size' in additional_data:
+            indices = np.arange(images.shape[0])
+            indices_rand = np.random.choice(indices, additional_data['max_size'])
+
+            # Кейс когда изображения выравненные в строки. В этом случае
+            # выбираем max_size строк (изображений), дальше они будет reshaped
+            res_reduce = []
+            for el in res:
+                if el is not None:
+                    el = el[indices_rand]
+                res_reduce.append(el)
+            res = res_reduce
+
+        return res
+
+    def plot(
+        self,
