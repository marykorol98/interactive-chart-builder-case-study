+import pandas as pd
+import plotly.express as px
+from sklearn.decomposition import PCA
+from sklearn.manifold import TSNE
+from sklearn.preprocessing import StandardScaler
+
+from ..data.tools import get_type
+from .base_method import BaseMethod
+
+
+class DimensionReduction(BaseMethod):
+    styles_fields_exclude = {'line_type', 'marker_color', 'max_size', 'multiple_axes'}
+    MESSAGE_COLUMNS_EMPTY = 'To reduce to 2D, at least 2 columns must be selected'
+
+    columns_templates = [
+        {
+            'label': 'Столбцы признаков',
+            'name': 'columns',
+            'source': 'columns',
+            'multi': True,
+            'select_all': True,
+        },
+        {
+            'label': 'Целевой столбец',
+            'name': 'label_column',
+            'source': 'label_column',
+            'include_non_selected': True,
+        },
+        {
+            'label': 'Метод',
+            'name': 'label_method',
+            'source': 'label_method',
+            'include_non_selected': False,
+        },
+    ]
+    out_columns = ['component-1', 'component-2']
+
+    def __init__(self):
+        super().__init__()
+
+        self.label_column = None
+        self.label_method = 'pca'
+
+    def make_reduction(self, df: pd.DataFrame) -> pd.DataFrame:
+        df_reduce = df.select_dtypes(include=['number', 'bool'])
+        X_scaled = StandardScaler().fit_transform(df_reduce)
+
+        if self.label_method == 'pca':
+            X_reduced = PCA(n_components=2).fit_transform(X_scaled)
+        elif self.label_method == 'tsne':
+            X_reduced = TSNE(n_components=2).fit_transform(X_scaled)
+        else:
+            raise Exception(f'Method {self.label_method} is not known')
+
+        X_reduced = pd.DataFrame(X_reduced, columns=self.out_columns, index=df.index)
+        return X_reduced
+
+    def plot(
+        self,
+        df,
+        *args,
+        columns: list | None = None,
+        styles: dict[str, str] | None = None,
+        **kwargs,
+    ):
+        if not columns or len(columns) < 2:
+            raise Exception(self.MESSAGE_COLUMNS_EMPTY)
+
+        logger = kwargs.get('logger')
+        if len(columns) == 2 and logger is not None:
+            logger.warn(
+                'The number of features is equal to the number of components. '
+                'In this case, the dimensionality reduction method is optional.'
+            )
+
+        self.columns = columns
+        self.label_column = kwargs.get('label_column', self.non_selected)
+        self.label_method = kwargs.get('label_method', 'pca')
+
+        self.update_styles(styles=styles)
+
+        # Group index 0, and df 1 because 0 is index series
+        df_reduced = self.get_series(df, kwargs, df.columns)[0][1]
+
+        # убираем пропуски в выбранных столбцах
+        columns_with_nan = df_reduced.columns[df_reduced.isna().any()].tolist()
+        if len(columns_with_nan) > 0:
+            df_reduced = df_reduced.dropna(subset=columns)
+            if logger is not None:
+                logger.warn(f'NaN in columns: {columns_with_nan}. Rows with NaN values have been removed')
+
+        df_selected_columns = df_reduced[columns]
+        X_reduced = self.make_reduction(df=df_selected_columns)
+
+        if self.label_column is not None and self.label_column != self.non_selected:
+            if self.label_column in df_reduced.columns:
+                X_reduced[self.label_column] = df_reduced[self.label_column].values
+
+            if (
+                get_type(df_reduced[self.label_column].dtype) == 'int'
+                and df_reduced[self.label_column].unique().shape[0] < 30
+            ):
+                self.n_splits_max = 30
+
+        dfs_by_categories = self.get_series(X_reduced, kwargs, self.out_columns, group_by_col=self.label_column)
+
+        scheme_color = {
+            'light': px.colors.qualitative.Light24,
+            'dark': px.colors.qualitative.Dark24,
+        }
+        colors = scheme_color[self.styles['scheme_color'].value]
+
+        traces = []
+        for i, (category_name, df_cat) in enumerate(dfs_by_categories):
+            values = df_cat.values
+
+            if category_name is None:
+                category_name = 'Весь набор данных'
+
+            trace = dict(
+                x=values[:, 0].tolist(),
+                y=values[:, 1].tolist(),
+                type='scatter',
+                name=category_name,
+                mode='markers',
+                marker=dict(color=colors[i % 24], size=8, opacity=0.8),
+                text=df_cat.index.tolist(),
+                showlegend=True,
+            )
+            traces.append(trace)
+
+        if self.label_method == 'tsne':
+            title, title_xaxis, title_yaxis = 'TSNE', 'TSNE1', 'TSNE2'
+        elif self.label_method == 'pca':
+            title, title_xaxis, title_yaxis = 'PCA', 'PC1', 'PC2'
+        else:
+            raise Exception(f'Selected wrong method: {self.label_method}')
+
+        layout = self.compile_layout()
+
+        title_xaxis = layout['xaxis_title'] if layout['xaxis_title'] not in ['', None] else title_xaxis
+        title_yaxis = layout['yaxis_title'] if layout['yaxis_title'] not in ['', None] else title_yaxis
+
+        layout.update({'title': title}) if layout.get('title') == 'DimensionReduction' else None
+        layout['xaxis'].update(
+            {
+                'title': title_xaxis,
+                'showline': False,
+                'zeroline': True,
+                'showticklabels': True,
+            }
+        )
+        layout['yaxis'].update(
+            {
+                'title': title_yaxis,
+                'showgrid': True,
+                'zeroline': True,
+                'showticklabels': True,
+            }
+        )
+
+        return {'data': traces, 'layout': layout}
+
+    @classmethod
+    def get_columns(cls, data_types=None, columns=None, instance=None, **kwargs):
+        label_columns = cls.filter_not_proba_columns(
+            cls.filter_dtypes_columns(data_types, methods=['number', 'string', 'bool'], columns=columns)
+        )
+        columns = cls.filter_not_proba_columns(
+            cls.filter_dtypes_columns(data_types, methods=['number'], columns=columns)
+        )
+        methods = ['pca', 'tsne']
+
+        if instance:
+            selected_columns, selected_label_column, selected_method = (
+                instance.columns,
+                instance.label_column,
+                instance.label_method,
+            )
+        else:
+            selected_columns, selected_label_column, selected_method = (
+                columns,
+                [],
+                methods[0],
+            )
+
+        columns = dict(map(lambda col: (col, col in selected_columns), columns))
+        label_columns = dict(map(lambda col: (col, col == selected_label_column), label_columns))
+        methods_out = dict(map(lambda method: (method, method == selected_method), methods))
+
+        return {
+            'columns': columns,
+            'label_column': label_columns,
+            'label_method': methods_out,
+        }
+
+    @classmethod
+    def check_to_show(cls, columns=None, data_types=None, **kwargs):
+        numeric_cnt = len(columns or [])
+
+        if data_types is not None:
+            numeric_cnt = len(list(filter(lambda v: pd.api.types.is_numeric_dtype(v), data_types.values())))
+
+        return numeric_cnt > 2
