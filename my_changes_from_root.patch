+                    x1_min, x1_max = X[:, 0].min() - 1, X[:, 0].max() + 1
+                    x2_min, x2_max = X[:, 1].min() - 1, X[:, 1].max() + 1
+                    xx1, xx2 = np.meshgrid(
+                        np.linspace(x1_min, x1_max, 100),
+                        np.linspace(x2_min, x2_max, 100),
+                    )
+
+                    Z = clf.predict(np.c_[xx1.ravel(), xx2.ravel()]).reshape(xx1.shape)
+                    fig.add_trace(
+                        go.Contour(
+                            z=Z.tolist(),
+                            x=xx1[0, :].tolist(),
+                            y=xx2[:, 0].tolist(),
+                            colorscale=sns_colorscale,
+                            opacity=0.5,
+                            showscale=False,
+                            connectgaps=True,
+                            contours=dict(coloring='fill', showlines=False),
+                            hoverinfo='none',
+                        ),
+                        row=yi + 1,
+                        col=xi + 1,
+                    )
+
+                    if predicted is not None and np.any(predicted != y):
+                        x1, y1 = X[y != predicted, 0], X[y != predicted, 1]
+                        fig.add_trace(
+                            go.Scatter(
+                                x=x1.tolist(),
+                                y=y1.tolist(),
+                                mode='markers',
+                                name='Errors',
+                                legendgroup='Errors',
+                                marker=dict(color='black', size=size_mark + 2),
+                                showlegend=sl,
+                            ),
+                            row=yi + 1,
+                            col=xi + 1,
+                        )
+                        sl = False
+
+                    for color_index, key in enumerate(d_predict.keys()):
+                        D[key] = key not in D.keys()
+                        fig.add_trace(
+                            go.Scatter(
+                                x=X[key == y_label, 0].tolist(),
+                                y=X[key == y_label, 1].tolist(),
+                                mode='markers',
+                                name=key,
+                                legendgroup=key,
+                                marker=dict(color=color[color_index], size=size_mark),
+                                hovertemplate=key,
+                                showlegend=D[key],
+                            ),
+                            row=yi + 1,
+                            col=xi + 1,
+                        )
+                else:  # column_x == column_y
+                    hist_data = []
+                    for val in d_predict.values():
+                        hist_data.append(X[y_numeric == val][:, 0].tolist())
+
+                    trace = ff.create_distplot(
+                        hist_data,
+                        group_labels=list(d_predict.keys()),
+                        colors=color[: len(d_predict.keys())],
+                        bin_size=0.3,
+                        show_hist=False,
+                        show_rug=False,
+                    )
+
+                    for k in range(len(trace['data'])):
+                        trace['data'][k].update(
+                            fill='tozeroy',
+                            legendgroup=list(d_predict.keys())[k],
+                            showlegend=False,
+                            opacity=0.3,
+                        )
+                        fig.add_trace(trace['data'][k], row=yi + 1, col=xi + 1)
+                    y_min = min(
+                        [
+                            min(trace['data'][0]['y']),
+                            min(trace['data'][1]['y']),
+                            min(trace['data'][2]['y']),
+                        ]
+                    )
+                    y_max = max(
+                        [
+                            max(trace['data'][0]['y']),
+                            max(trace['data'][1]['y']),
+                            max(trace['data'][2]['y']),
+                        ]
+                    )
+
+                    fig.update_yaxes(range=[float(y_min), float(y_max)], row=yi + 1, col=xi + 1)
+
+                if yi == len(columns_y) - 1:
+                    fig.update_xaxes(
+                        automargin=True,
+                        title=columns_x[xi],
+                        titlefont=dict(family='Arial', size=15, color='black'),
+                        tickfont=dict(size=8, color='black'),
+                        domain=domx[xi],
+                        row=yi + 1,
+                        col=xi + 1,
