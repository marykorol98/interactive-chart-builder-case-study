+import numpy as np
+import pandas as pd
+import plotly.express as px
+
+from smile_ml_core.plot_methods import BaseMethod
+
+
+class IntervalEstimates(BaseMethod):
+    styles_fields_exclude = {
+        'line_type',
+        'scheme_color',
+        'marker_color',
+        'max_size',
+    }
+
+    columns_templates = [
+        {
+            'label': 'Столбцы',
+            'name': 'columns',
+            'source': 'columns',
+            'multi': True,
+            'select_all': True,
+        }
+    ]
+
+    def plot(
+        self,
+        df,
+        *args,
+        styles: dict[str, str] | None = None,
+        scores: pd.DataFrame = None,
+        columns: list[str] | None = None,
+        **kwargs,
+    ):
+        """
+        :param df: Данные по точности алгоритмов на кросс-валидации, где со столбцами Алгоритм и X, где X - название метрики
+        :param styles:
+        :param scores: DataFrame with scores (with columns: ['Model'?, 'Class'?])
+        :param columns: Путь для сохранения результирующего файла
+
+        :return: Путь к сохраненному графику
+        """
+        if scores is None:
+            raise Exception('Scores is not defined')
+        if columns is None:
+            raise Exception(self.MESSAGE_COLUMNS_EMPTY)
+
+        color = None
+        self.columns = y = columns
+
+        self.update_styles(styles=styles)
+
+        if 'Model' in scores.columns:
+            color = 'Model'
+
+        if (unique_columns := len(scores[y].dtypes.unique())) != 1:
+            raise Exception(
+                'All columns must have the same type, and you have %(unique_columns)s of them'
+                % {'unique_columns': unique_columns}
+            )
+
+        if 'Class' in scores.columns:  # if the scores are given for every class and Averages
+            scores = scores[scores['Class'] == 'AVG']
+
+        fig = px.box(scores, y=y, color=color)
+
+        layout = self.compile_layout()
+        layout['xaxis_title'] = 'Metric' if layout['xaxis_title'] in ['', None] else layout['xaxis_title']
+        layout['yaxis_title'] = 'Estimates' if layout['yaxis_title'] in ['', None] else layout['yaxis_title']
+
+        fig.update_layout(layout)
+
+        return fig.to_plotly_json() if kwargs.get('as_json', True) else fig
+
+    @classmethod
+    def plot_pyplot(cls, df_scores: pd.DataFrame, metrics: list[str], filename: str):
+        import matplotlib.patches as mpatches
+        from matplotlib import pyplot as plt
+
+        metrics = list(filter(lambda v: v in df_scores.columns, metrics))
+        positions = np.arange(len(metrics))
+
+        shift_options = {
+            1: [0],
+            2: [-0.22, 0.22],
+            3: [-0.30, 0, 0.30],
+            4: [-0.3, -0.1, 0.1, 0.3],
+        }
+        width_options = {1: 0.8, 2: 0.4, 3: 0.25, 4: 0.2}
+
+        if 'Model' not in df_scores.columns:
+            df_scores['Model'] = 'Anonymous model'
+
+        fig, ax = plt.subplots(figsize=(14, 8))
+        models_unique = df_scores['Model'].unique()
+
+        colors = [
+            dict(
+                boxes='#0073b6',
+                whiskers='#0073b6',
+                medians='#0073b6',
+                caps='#0073b6',
+                facecolor='#86badb',
+            ),  # blue
+            dict(
+                boxes='#ff7100',
+                whiskers='#ff7100',
+                medians='#ff7100',
+                caps='#ff7100',
+                facecolor='#ffbb7f',
+            ),  # orange
+            dict(
+                boxes='#00aa2b',
+                whiskers='#00aa2b',
+                medians='#00aa2b',
+                caps='#00aa2b',
+                facecolor='#81d795',
+            ),  # green
+            dict(
+                boxes='#e70000',
+                whiskers='#e70000',
+                medians='#e70000',
+                caps='#e70000',
+                facecolor='#f7878f',
+            ),  # pink
+            dict(
+                boxes='#9f55be',
+                whiskers='#9f55be',
+                medians='#9f55be',
+                caps='#9f55be',
+                facecolor='#cfacde',
+            ),  # ?
+            dict(
+                boxes='#944f46',
+                whiskers='#944f46',
+                medians='#944f46',
+                caps='#944f46',
+                facecolor='#caa8a3',
+            ),  # brown
+        ]
+        legend_records = []
+
+        models_unique = models_unique.tolist()  # Convert numpy array to list
+
+        # Ensure len(models_unique) is a key in shift_options
+        shifts = shift_options.get(len(models_unique))
+        if shifts is None:
+            raise ValueError(f'No shift options available for {len(models_unique)} unique models.')
+        # Verify the type of shifts
+        if not isinstance(shifts, list):
+            raise TypeError('shifts is not a list')
+        # Check if models_unique and shifts are iterables and have the same length
+        if len(models_unique) != len(shifts):
+            raise ValueError('The number of unique models and shifts do not match')
+
+        for i, (model, dx) in enumerate(zip(models_unique, shifts)):
+            df_model = df_scores[df_scores['Model'] == model][metrics]
+
+            color_model = colors[i].copy()
+            facecolor = color_model.pop('facecolor')
+            box = df_model.boxplot(
+                ax=ax,
+                patch_artist=True,
+                return_type='dict',
+                color=color_model,
+                positions=positions + dx,
+                widths=width_options[len(models_unique)],
+            )
+
+            for patch in box['boxes']:
+                patch.set_facecolor(facecolor)
+
+            legend_records.append(mpatches.Patch(color=facecolor, label=model))
+
+        fig.legend(handles=legend_records)
+        fig.tight_layout()
+        fig.savefig(filename)
+
+        return filename
+
+    @classmethod
+    def get_template(cls, instance=None, **kwargs):
+        html, scores = '', kwargs.get('scores')  # type: str, pd.DataFrame
+        if scores is not None and 'Model' in scores.columns:
+            columns = list(set(scores.columns) - {'Subset name', 'Node', 'Model', 'Class'})
+            selected_columns = instance.columns if instance else columns  # по дефолту выбраны все
+            columns_out = dict(map(lambda col: (col, col in selected_columns), columns))
+            html = cls.get_template(columns=columns_out)
+        return html
+
+    @classmethod
+    def get_json(cls, data_types=None, columns=None, instance=None, **kwargs):
+        scores = kwargs.get('scores')  # type: pd.DataFrame
+        if scores is not None and 'Model' in scores.columns:
+            columns = list(set(scores.columns) - {'Subset name', 'Node', 'Model', 'Class'})
+            selected_columns = instance.columns if instance else columns  # по дефолту выбраны все
+            columns = dict(map(lambda col: (col, col in selected_columns), columns))
+            params = {'columns': columns}
+            params_out = cls.format_json_data(params)
+            return params_out
+
+    @classmethod
+    def check_to_show(cls, data_types=None, columns=None, **kwargs):
+        scores, to_show = kwargs.get('scores'), False
+        if scores is not None:
+            # if there are several models
+            to_show |= 'Model' in scores.columns and (scores['Model'].value_counts() > 1).any()
+
+            # if metrics is placed in columns
+            metrics_set = {
+                'Accuracy',
+                'Precision',
+                'Recall',
+                'F1 score',
+                'Logloss',
+            } & set(scores.columns.tolist())
+            to_show |= len(metrics_set) > 0
+        return to_show
