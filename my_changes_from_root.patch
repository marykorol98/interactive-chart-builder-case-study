+from __future__ import annotations
+
+import os
+
+import matplotlib.pyplot as plt
+import pandas as pd
+from lazy_imports import try_import
+
+from smile_ml_core.data.structures import DictDataFrame
+
+from ..base_method import BaseMethod
+from ..plot_tools import render_image
+
+with try_import() as geopandas_import:
+    import geopandas
+    from geopandas.array import GeometryDtype
+
+
+class GeoDataVisualizer(BaseMethod):
+    styles_fields: list | str = []
+
+    columns_templates = [
+        {
+            'label': 'Columns',
+            'name': 'columns',
+            'source': 'columns',
+            'multi': True,
+        },
+    ]
+
+    def plot(
+        self,
+        data: DictDataFrame,
+        columns: list[str],
+        styles: dict[str, str] | None,
+        **kwargs,
+    ):
+        self.update_styles(styles=styles)
+        self.generate_image_plots_dir()
+
+        df = data.df
+        if isinstance(df, pd.DataFrame):
+            df = geopandas.GeoDataFrame(df)  # to convert type
+
+        self.columns = columns
+
+        fig, ax = plt.subplots(1, 1, figsize=(14, 8))
+        colors = self.get_colors()
+        for i, column in enumerate(columns):
+            df[column].plot(ax=ax, color=colors[i])
+
+        file_name = self.generate_hashed_plot_image_name(input_name='graph_visualizer')
+        file_path = os.path.join(self.image_plots_source, f'{file_name}.png')
+        fig.savefig(file_path)
+
+        return render_image(file_path)
+
+    @classmethod
+    def check_to_show(cls, *args, data_types=None, **kwargs):
+        try:
+            geopandas_import.check()
+        except ImportError:
+            return False
+
+        return any(map(lambda v: isinstance(v, GeometryDtype), data_types.values()))
+
+    @classmethod
+    def get_columns(cls, data_types=None, columns=None, instance=None, **kwargs):
+        extra_checking_methods = {'geometry': lambda dt: isinstance(dt, GeometryDtype)}
+        columns_geometry: list = cls.filter_dtypes_columns(
+            data_types,
+            methods=['geometry'],
+            columns=columns,
+            extra_checking_methods=extra_checking_methods,
+        )
+        if instance is None:
+            columns = dict(map(lambda col: (col, False), columns_geometry))  # по дефолту выбраны все
+        else:
+            columns = dict(map(lambda col: (col, col in instance.columns), columns_geometry))
+
+        return {'columns': columns}
