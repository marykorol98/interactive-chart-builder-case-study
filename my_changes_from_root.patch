+    def clean_nan_from_plot_data(self, plot_data: dict[str, Any]) -> dict[str, Any]:
+        """
+        Очищает словарь с данными для графиков от NaN значений, чтобы они могли в дальнейшем сериализоваться.
+        """
+        # Клонируем входной словарь для изменения
+        cleaned_data = {'data': [], 'layout': plot_data.get('layout', {})}
+
+        # Очищаем следы NaN в traces
+        for trace in plot_data.get('data', []):
+            cleaned_trace = trace.copy()
+
+            # Извлечение данных x и y
+            x = cleaned_trace.get('x', [])
+            y = cleaned_trace.get('y', [])
+
+            # Преобразуем x и y в pandas.Series для удобства очистки
+            x_series = pd.Series(x)
+            y_series = pd.Series(y)
+
+            # Определение валидных (не NaN) значений
+            valid = ~x_series.isna() & ~y_series.isna()
+
+            # Очистка данных
+            cleaned_trace['x'] = x_series[valid].tolist()
+            cleaned_trace['y'] = y_series[valid].tolist()
+
+            # Добавляем очищенный trace в cleaned_data, если он не пуст
+            if len(cleaned_trace['x']) > 0 and len(cleaned_trace['y']) > 0:
+                cleaned_data['data'].append(cleaned_trace)
+
+        return cleaned_data
