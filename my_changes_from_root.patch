@@ -0,0 +1,182 @@
+import os
+from typing import Any
+
+import numpy as np
+import plotly.graph_objects as go
+from matplotlib import pyplot as plt
+from PIL import Image
+
+from smile_ml_core.constants import DOMAIN, URL_SCHEME
+from smile_ml_core.plot_methods import SortingMixin
+
+
+class GradCam(SortingMixin):
+    """
+    This plot type is used only for classification on remote data and torch neural networks
+    """
+
+    styles_fields: list | str = []
+
+    columns_templates = [
+        {
+            'label': 'Columns',
+            'name': 'columns',
+            'source': 'columns',
+            'multi': {'is_remote': True},
+        }
+    ]
+    DEFAULT_FIG_WIDTH = 14
+
+    def __init__(self):
+        super().__init__()
+
+    def plot(self, data, **kwargs):
+        import torch
+        from pytorch_grad_cam import GradCAM
+        from pytorch_grad_cam.utils.image import show_cam_on_image
+        from torchvision import transforms
+
+        if 'columns' not in kwargs:
+            raise Exception(self.MESSAGE_COLUMNS_EMPTY)
+        assert 'model' in kwargs, 'This method required model argument with torch model'
+
+        self.columns = kwargs['columns']
+        model = kwargs['model']  # torch model
+
+        # self.update_styles(styles=styles)  # TODO исправить после фикса настроек на фронте
+
+        rows = (len(self.columns) - 1) // 2 + 1  # by 2 images into a row
+        cols = 2 if len(self.columns) > 1 else 1  #
+        img, axes = plt.subplots(rows, cols, figsize=(10, 10))
+
+        if isinstance(axes, np.ndarray):
+            axes = axes.flatten()
+        else:
+            axes = [axes]
+        axes[-1].set_axis_off()  # by default at the start turn off axes for last image (can be not selected)
+
+        cam = GradCAM(model=model, target_layers=[model.layer4], use_cuda=False)
+        for i, image_path in enumerate(self.columns):
+            img_source: np.ndarray = data.load_image(image_path)  # load source image
+            img_input = data[image_path]  # load transformed image
+
+            target, predict = None, None
+            if isinstance(img_input, tuple):
+                assert len(img_input) == 2, 'If the image is tuple, it can have size equal to 2: image and target'
+                img_input, target = img_input
+
+            # if source img shape different, to resize it to transformed image
+            if img_input.shape[0] != img_source.shape[0] or img_input.shape[1] != img_source.shape[1]:
+                transforms_ = []
+                if isinstance(img_source, np.ndarray):
+                    transforms_.append(transforms.ToPILImage())
+                transforms_.append(transforms.Resize((img_input.shape[0], img_input.shape[1])))
+
+                img_source = np.array(transforms.Compose(transforms_)(img_source))
+
+            if len(img_input.shape) == 2:
+                img_input = img_input[:, :, None]
+
+            if img_input.shape[2] == 1:
+                img_input = np.repeat(img_input, 3, axis=2)
+
+            # transform to tensor must be [1, 3, N, M]
+            img_input_tensor = transforms.ToTensor()(img_input)[None,]
+
+            with torch.no_grad():
+                out = model(img_input_tensor)  # here input must be [1, 3, N, M]
+                predict = out.squeeze(0).argmax().item()
+
+            grayscale_cam = cam(input_tensor=img_input_tensor, targets=None)[0]
+            rgb_cam = show_cam_on_image(img_source / 255.0, grayscale_cam, use_rgb=True)
+            image = Image.fromarray(rgb_cam)
+
+            self._plot_single_img(axes[i], image, target=target, predict=predict)
+
+        self.generate_image_plots_dir()
+        file_name = self.generate_hashed_plot_image_name(input_name='gradcam.png')
+        img_path = os.path.join(self.image_plots_source, file_name)
+
+        img.tight_layout()
+        img.savefig(img_path)
+
+        fig = go.Figure()
+        fig.add_layout_image(
+            {
+                'source': f'{URL_SCHEME}{DOMAIN}/api/{img_path}',
+                'xref': 'x',
+                'yref': 'y',
+                'x': 1,
+                'y': 4,
+                'sizex': 5,
+                'sizey': 5,
+            }
+        )
+
+        fig.update_layout(
+            template='plotly_white',
+            xaxis={'showgrid': False},
+            yaxis={'showgrid': False},
+        )
+        fig.update_xaxes(visible=False)
+        fig.update_yaxes(visible=False)
+
+        return fig.to_plotly_json()
+
+    @staticmethod
+    def _plot_single_img(ax, img, shape=None, target=None, predict=None):
+        ax.set_axis_off()
+
+        cmap = None  # by default
+        if shape is not None and (len(img.shape) == 2 or len(img.shape) == 3 and img.shape[2] == 1):
+            # if the image is black-white
+            cmap = 'gray'
+
+        img = img.reshape(shape) if shape not in ['source', None] else img
+        ax.imshow(img, cmap=cmap)
+
+        title = ''
+        if target is not None:
+            title += '{}: {}. '.format('Real', target)
+        if predict is not None:
+            title += f'M: {predict}.'
+
+        if title:
+            ax.set_title(title)
+
+    @classmethod
+    def get_template(cls, data_types=None, columns=None, instance=None, **kwargs):
+        columns = cls.filter_complex_columns(columns or [], data_types=data_types)
+        if 'proba' in columns:
+            columns.remove('proba')
+
+        if instance:
+            selected_column: list = instance.columns
+        else:
+            selected_column = columns[:1] if columns else None
+
+        template_data = {
+            'columns': dict(map(lambda col: (col, col in selected_column), columns)),
+        }
+
+        return cls.get_template(**template_data)
+
+    @classmethod
+    def get_columns(cls, data_types: dict[Any, Any], columns=None, instance=None):
+        columns = cls.filter_complex_columns(columns or [], data_types=data_types)
+        if 'proba' in columns:
+            columns.remove('proba')
+
+        if instance:
+            selected_column: list = instance.columns
+        else:
+            selected_column = columns[:1] if columns else None
+
+        return {
+            'columns': dict(map(lambda col: (col, col in selected_column), columns)),
+        }
+
+    @classmethod
+    def check_to_show(cls):
+        # this is exists only for torch NN, so by default it there is in plots
+        return True
