+import numpy as np
+import pandas as pd
+from sklearn.metrics import average_precision_score, precision_recall_curve
+from sklearn.preprocessing import LabelEncoder, label_binarize
+
+from ..data.exceptions import PlottingAbsentColumnExceptions
+from .base_method import BaseMethod
+
+
+class PrecisionRecall(BaseMethod):
+    styles_fields_exclude = {
+        'line_type',
+        'scheme_color',
+        'marker_color',
+        'max_size',
+    }
+
+    def plot(
+        self,
+        df: pd.DataFrame,
+        target_column: str,
+        styles: dict[str, str] | None = None,
+        **kwargs,
+    ):
+        """
+        Plots precision-recall curves for multiclass classification and returns the traces and layout for the plot.
+
+        :param pd.DataFrame df: The input dataframe containing the target column and probability columns for each class.
+        :param str target_column: The name of the target column in the dataframe.
+        :param Optional[Dict[str, str]] styles: Optional styles for the plot.
+        :param kwargs: Additional keyword arguments for plot customization.
+
+        :return: A dictionary containing the traces and layout for the precision-recall curve plot.
+        :rtype: dict
+        """
+
+        if df.empty:
+            raise ValueError('Dataframe is empty')
+
+        probas = [df[key] for key in df.columns if self.is_proba_column(key)]
+
+        if not probas:
+            raise PlottingAbsentColumnExceptions(column='proba')
+
+        target_series = df[target_column]
+        if target_series.dtype.name.startswith('str'):
+            target_series = LabelEncoder().fit_transform(target_series)
+
+        not_nan_mask = pd.notna(target_series)
+        target_series = target_series[not_nan_mask]
+        lw = 2
+        traces = []
+        target_one_hot = pd.get_dummies(target_series)
+        filtered_probas = [proba[not_nan_mask] for proba in probas]
+
+        if len(target_one_hot.columns) not in {
+            1,
+            2,
+        }:  # когда у нас 1 или 2 класса - не делаем
+            target_binarized = label_binarize(target_series, classes=pd.Series(target_series).unique())
+            proba_matrix = np.array(probas).T
+            precision_micro, recall_micro, average_precision_micro = self.compute_precision_recall_curve(
+                target_binarized.ravel(), proba_matrix.ravel()
+            )
+
+            trace_micro = {
+                'x': recall_micro.tolist(),
+                'y': precision_micro.tolist(),
+                'type': 'scatter',
+                'mode': 'line',
+                'line': {'width': lw},
+                'name': f'micro-average Precision-recall curve (area = {average_precision_micro:.2f})',
+            }
+            traces.append(trace_micro)
+
+        for column_name, proba in zip(target_one_hot.columns, filtered_probas):
+            precision, recall, average_precision = self.compute_precision_recall_curve(
+                target_one_hot[column_name], proba
+            )
+
+            traces.append(
+                {
+                    'x': recall.tolist(),
+                    'y': precision.tolist(),
+                    'type': 'scatter',
+                    'mode': 'line',
+                    'line': {'width': lw},
+                    'name': f'Precision-recall curve of class {column_name} (area = {average_precision:.2f}) for {column_name}',
+                }
+            )
+
+        layout = self.compile_layout()
+        layout.update(title={'text': 'Precision-Recall'}) if layout.get('title') == 'PrecisionRecall' else None
+        layout['xaxis'].update(title={'text': 'Recall'})
+        layout['yaxis'].update(title={'text': 'Precision'})
+
+        return {'data': traces, 'layout': layout}
+
+    @staticmethod
+    def compute_precision_recall_curve(
+        target: np.ndarray | list[int], proba: np.ndarray | list[float]
+    ) -> tuple[np.ndarray, np.ndarray, float]:
+        """
+        Compute precision, recall, and average precision for a given target and probability array.
+
+        :param Union[np.ndarray, List[int]] target: The true binary labels.
+        :param Union[np.ndarray, List[float]] proba: The probability of the positive class.
+
+        :return: A tuple containing precision, recall, and average precision.
+        :rtype: Tuple[np.ndarray, np.ndarray, float]
+        """
+
+        precision, recall, _ = precision_recall_curve(target, proba)
+        average_precision = average_precision_score(target, proba)
+
+        return precision, recall, average_precision
