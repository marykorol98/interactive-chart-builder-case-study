diff --git a/smile_ml_core/plot_methods/recommendation_project_demo/recom_log.py b/smile_ml_core/plot_methods/recommendation_project_demo/recom_log.py
new file mode 100644
index 00000000..28fde29e
--- /dev/null
+++ b/smile_ml_core/plot_methods/recommendation_project_demo/recom_log.py
@@ -0,0 +1,111 @@
+from typing import Any
+
+from lazy_imports import try_import
+
+from smile_ml_core.plot_methods.base_method import convert_ndarray
+
+with try_import() as plotly_import:
+    import plotly.graph_objects as go
+
+from smile_ml_core.data.structures import DictDataFrame
+from smile_ml_core.plot_methods import BaseMethod
+
+
+class RecommendationSimulationComparison(BaseMethod):
+    DEFAULT_METRIC = 'ctr'
+    metrics_dict = {'ctr': 'ctr', 'coverage': 'coverage'}
+    columns_templates = [
+        {
+            'label': 'Metric',
+            'name': 'metric',
+            'default': DEFAULT_METRIC,
+            'source': 'metric',
+            'include_non_selected': False,
+        },
+    ]
+    styles_fields_exclude = {
+        'bg_color',
+        'multiple_axes',
+    }
+
+    def __init__(self):
+        super().__init__()
+        self.metric_name: str = self.DEFAULT_METRIC
+
+    def update_properties(self, properties: dict[str, Any]):
+        self.metric_name = properties.get('metric', self.DEFAULT_METRIC)
+
+    def plot(self, ddf: DictDataFrame, properties: dict[str, Any], styles: dict[str, Any], **kwargs):
+        df = ddf.view()
+        columns = df.columns
+
+        self.update_styles(styles=styles)
+        self.update_properties(properties=properties)
+
+        df_reduced = self.get_series(df, kwargs, columns)[0][1]
+
+        model_names = set(list(['_'.join(col.split('_')[:-2]) for col in columns]))
+        plotly_list = []
+        for model_name in model_names:
+            x = df_reduced.index.tolist()
+            model_list = [
+                go.Scatter(name=model_name, x=x, y=df[f'{model_name}_{self.metric_name}_mean'], mode='lines'),
+                go.Scatter(
+                    name='Upper Bound',
+                    x=x,
+                    y=df[f'{model_name}_{self.metric_name}_upper'],
+                    mode='lines',
+                    marker=dict(color='#444'),
+                    line=dict(width=0),
+                    showlegend=False,
+                ),
+                go.Scatter(
+                    name='Lower Bound',
+                    x=x,
+                    y=df[f'{model_name}_{self.metric_name}_lower'],
+                    marker=dict(color='#444'),
+                    line=dict(width=0),
+                    mode='lines',
+                    fill='tonexty',
+                    showlegend=False,
+                ),
+            ]
+            plotly_list += model_list
+
+        fig = go.Figure(plotly_list)
+        layout = self.compile_layout()
+
+        layout['xaxis_title'] = 'Iteration number'
+        fig.update_layout(**layout)
+
+        fig.update_layout(
+            width=800,
+            height=600,
+            yaxis=dict(title=dict(text=self.metric_name)),
+            title=dict(text=f'RS Comparison by {self.metric_name}'),
+            hovermode='x',
+        )
+
+        return convert_ndarray(fig.to_plotly_json())
+
+    @classmethod
+    def get_columns(
+        cls,
+        data_types: dict | None = None,
+        columns: str | None = None,
+        instance=None,
+        **kwargs,
+    ):
+        selected_metric = cls.DEFAULT_METRIC
+
+        columns_info = {
+            'metric': dict(map(lambda v: (v, v == selected_metric), cls.metrics_dict.keys())),
+        }
+
+        return columns_info
+
+    @classmethod
+    def check_to_show(cls, columns=None, data_types=None, **kwargs):
+        columns = cls.filter_dtypes_columns(data_types, methods=['number'], columns=columns, exclude=['bool'])
+
+        return len(columns) > 0 and len(columns) % 3 == 0

