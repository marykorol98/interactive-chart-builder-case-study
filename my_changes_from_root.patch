@@ -0,0 +1,183 @@
+import pandas as pd
+import plotly.express as px
+
+from .base_method import BaseMethod
+from .styles import StyleModificator
+
+
+class Scatter(BaseMethod):
+    styles_fields_exclude = {
+        'line_type',
+        'bg_color',
+        'color',
+        'scheme_color',
+        'marker_color',
+        'max_size',
+        'multiple_axes',
+    }
+    styles_modificators = BaseMethod.styles_modificators + [
+        StyleModificator('xaxis_tickangle', value=-40),
+        StyleModificator('yaxis_tickangle', value=-40),
+    ]
+
+    columns_templates = [
+        {
+            'label': 'Столбцы',
+            'name': 'columns',
+            'source': 'columns',
+            'multi': True,
+            'select_all': False,
+        },
+        {
+            'label': 'Group by',
+            'name': 'label_column',
+            'source': 'label_column',
+            'include_non_selected': True,
+        },
+        {
+            'label': 'With a BiPlot',
+            'name': 'bi_plot',
+            'source': 'bi_plot',
+            'default': True,
+        },
+        {
+            'label': 'Plot the frequencies',
+            'name': 'plot_freqs',
+            'source': 'plot_freqs',
+            'default': False,
+        },
+    ]
+
+    def __init__(self):
+        super().__init__()
+        self.label_column = None
+        self.columns = []
+        self.bi_plot = False
+        self.plot_freqs = None
+
+    @staticmethod
+    def get_plot_consts(fig, df_reduced, i, col):
+        val_arr = fig['data'][0]['dimensions'][i]['values']
+
+        len_max_value = len(max(map(lambda v: str(v), set(val_arr)), key=len))
+        is_number = pd.api.types.is_numeric_dtype(df_reduced[col].dtype)
+        if len(str(val_arr[0])) > 4 or not is_number:
+            mid, is_long = val_arr[len(val_arr) // 2], True
+        else:
+            mid, is_long = (max(val_arr) + min(val_arr)) / 2, False  # noqa: F841
+
+        return mid, len_max_value
+
+    @staticmethod
+    def get_values_frequencies(df: pd.DataFrame, columns: list[str]) -> pd.Series:
+        return df.groupby(columns)[columns[0]].transform('count')
+
+    def plot(self, df, *args, columns=None, styles: dict[str, str] | None = None, **kwargs):
+        if not columns or len(columns) < 2:
+            raise Exception('Columns amount must be more than 1')
+
+        self.columns = columns
+        self.label_column = label_column_name = kwargs.get('label_column', None)
+        self.bi_plot = bi_plot = kwargs.get('bi_plot', False)
+        self.plot_freqs = plot_freqs = kwargs.get('plot_freqs', False)
+        self.update_styles(styles=styles)
+
+        cols_for_reducing = columns + [label_column_name] if label_column_name else columns
+        df_reduced = self.get_series(df, kwargs, cols_for_reducing)
+        df_reduced = df_reduced[0][1]
+        freqs = self.get_values_frequencies(df_reduced, columns) if not df_reduced.isnull().values.any() else None
+
+        layout = self.compile_layout()
+
+        if len(columns) == 2:
+            fig = px.scatter(
+                x=df_reduced[columns[0]].tolist(),
+                y=df_reduced[columns[1]].tolist(),
+                color=df_reduced[label_column_name] if label_column_name else None,
+                trendline='ols' if bi_plot else None,
+                trendline_color_override='black' if not label_column_name else None,
+                size=freqs if plot_freqs else None,
+            )
+
+            fig.update_layout(layout)
+
+            # Настройка осей
+            fig.update_layout(
+                xaxis=dict(automargin=True, tickangle=0),
+                yaxis=dict(automargin=True, tickangle=0),
+            )
+            return fig.to_plotly_json()
+
+        fig = px.scatter_matrix(
+            df_reduced,
+            dimensions=columns,
+            color=label_column_name,
+            size=freqs if plot_freqs else None,
+        )
+
+        for f in fig['data'][0]['dimensions']:
+            f['label'] = ''
+
+        for i, col in enumerate(columns):
+            mid, len_max_value = self.get_plot_consts(fig, df_reduced, i, col)
+            fig.add_annotation(
+                {
+                    'x': 0,
+                    'xshift': -4.5 * len_max_value,
+                    'y': mid,
+                    'text': col,
+                    'yref': f'y{i + 1}',
+                    'xref': 'paper',
+                    'showarrow': False,
+                    'textangle': layout['yaxis']['tickangle'],
+                    'xanchor': 'right',
+                }
+            )
+            fig.add_annotation(
+                {
+                    'y': 0,
+                    'yshift': -2 * len_max_value,
+                    'x': mid,
+                    'text': col,
+                    'xref': f'x{i + 1}',
+                    'yref': 'paper',
+                    'showarrow': False,
+                    'textangle': layout['xaxis']['tickangle'],
+                    'yanchor': 'top',
+                }
+            )
+        fig.update_layout(layout)
+
+        # Настройка осей
+        fig.update_layout(
+            xaxis=dict(automargin=True, tickangle=0),
+            yaxis=dict(automargin=True, tickangle=0),
+        )
+        return fig.to_plotly_json()
+
+    @classmethod
+    def get_columns(cls, data_types=None, columns=None, instance=None, **kwargs):
+        columns = cls.filter_dtypes_columns(data_types, methods=['number', 'string', 'bool'], columns=columns)
+        label_column = cls.filter_dtypes_columns(
+            data_types, methods=['number', 'object', 'string', 'bool'], columns=columns
+        )
+
+        selected_columns = instance.columns if instance else columns[:2]  # по дефолту выберем первые две
+        selected_group_by = instance.label_column if instance else None
+        selected_bi_plot = instance.bi_plot if instance else True
+        selected_plot_freqs = instance.plot_freqs if instance else False
+
+        columns = dict(map(lambda col: (col, col in selected_columns), columns))
+        label_column_out = dict(map(lambda col: (col, col == selected_group_by), label_column))
+
+        return {
+            'columns': columns,
+            'label_column': label_column_out,
+            'bi_plot': selected_bi_plot,
+            'plot_freqs': selected_plot_freqs,
+        }
+
+    @classmethod
+    def check_to_show(cls, columns=None, data_types=None, **kwargs):
+        columns = cls.filter_dtypes_columns(data_types, methods=['number', 'string'], columns=columns)
+        return len(columns) >= 2  # must be at least 2 columns
