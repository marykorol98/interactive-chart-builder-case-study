new file mode 100644
index 00000000..82f699b1
--- /dev/null
+++ b/smile_ml_core/plot_methods/user_code_plotting/utils.py
@@ -0,0 +1,87 @@
+from typing import Any
+
+import numpy as np
+import pandas as pd
+
+
+MAX_TEXT_LEN = 2000
+
+def _safe_to_string(obj):
+    try:
+        return str(obj)
+    except Exception:
+        try:
+            return repr(obj)
+        except Exception:
+            return f"<unprintable {type(obj).__name__}>"
+        
+
+
+def safe_import(name, globals=None, locals=None, fromlist=(), level=0):
+    allowed_modules = {"math", "numpy", "pandas", "plotly", "plotly.express", "plotly.graph_objects"}
+    if any(name == m or name.startswith(m + ".") for m in allowed_modules):
+        return __import__(name, globals, locals, fromlist, level)
+    
+    return [{'type': 'text', 'message': f'Ошибка импорта: {name}'}]
+
+
+def _convert_object_to_output(obj: Any) -> dict[str, Any]:
+    """
+    Универсальная конвертация результата кода в формат для фронтенда.
+    Поддерживает DataFrame, Series, ndarray, plotly (express и graph_objects),
+    а также базовые типы.
+    """
+    # --- Plotly (graph_objects, express, etc.) ---
+    if hasattr(obj, "__class__") and "plotly" in str(type(obj)).lower():
+        try:
+            # Попробуем to_plotly_json() — если не получится, fallback на to_dict()
+            if hasattr(obj, "to_plotly_json"):
+                fig_json = obj.to_plotly_json()
+            elif hasattr(obj, "to_dict"):
+                fig_json = obj.to_dict()
+            else:
+                fig_json = str(obj)
+            return {
+                "type": "plotly",
+                "code": fig_json,
+            }
+        except Exception as e:
+            return {
+                "type": "text",
+                "message": "Ошибка сериализации plotly объекта: \n",
+                "code": str(e)
+            }
+
+    # --- DataFrame ---
+    if isinstance(obj, pd.DataFrame):
+        return {
+            "type": "table",
+            "code": obj.to_json(orient="records"),
+            "meta": {"columns": list(obj.columns), "shape": obj.shape}
+        }
+
+    # --- Series ---
+    if isinstance(obj, pd.Series):
+        return {
+            "type": "series",
+            "code": obj.to_json(orient="records"),
+            "meta": {"name": obj.name}
+        }
+
+    # --- NumPy ---
