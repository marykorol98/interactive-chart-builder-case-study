+import pandas as pd
+from sklearn.metrics import roc_auc_score, roc_curve
+
+from ..data.exceptions import PlottingAbsentColumnExceptions
+from .base_method import BaseMethod
+
+
+class RocCurve(BaseMethod):
+    styles_fields_exclude = {
+        'line_type',
+        'scheme_color',
+        'marker_color',
+        'max_size',
+    }
+
+    def plot(
+        self,
+        df: pd.DataFrame,
+        target_column: str,
+        styles: dict[str, str] | None = None,
+        **kwargs,
+    ):
+        """
+        Plot the ROC curve for a binary classification problem.
+
+        :param pd.DataFrame df: Pandas DataFrame containing the data.
+        :param str target_column: The name of the column in df containing the target variable.
+        :param Optional[Dict[str, str]] styles: Optional dictionary of plot styles.
+        :param kwargs: Additional keyword arguments for plot customization.
+
+        :return: A dictionary containing the data and layout for the plot.
+        :rtype: dict
+        """
+        # self.update_styles(styles=styles)  # TODO исправить после фикса настроек на фронте
+
+        assert df.shape[0] > 0, 'Данные не были переданы в метод отрисовки'
+
+        probas = [df[key] for key in df.columns if self.is_proba_column(key)]
+
+        if not probas:
+            raise PlottingAbsentColumnExceptions(column='proba')
+
+        df_reduced = self.get_series(df, kwargs, [target_column])
+        df_reduced = df_reduced[0][1]
+
+        # Define the inputs and outputs
+        y = df_reduced[target_column]
+        y_onehot = pd.get_dummies(y, columns=y.unique())
+
+        # Create an empty figure, and iteratively add new lines
+        # every time we compute a new class
+        traces = [
+            dict(
+                x=[0, 1],
+                y=[0, 1],
+                type='scatter',
+                mode=kwargs.get('line_type'),
+                name='zero-line',
+                line={'dash': 'dash', 'color': 'black'},
+            )
+        ]
+
+        for col, proba in zip(y_onehot.columns, probas):
+            y_true = y_onehot[col]
+            y_score = proba
+
+            fpr, tpr, __ = roc_curve(y_true, y_score)
+            auc_score = roc_auc_score(y_true, y_score)
+
+            name = f'{col} (AUC={auc_score:.2f}) for {col}'
+            traces.append(
+                dict(
+                    x=fpr.tolist(),
+                    y=tpr.tolist(),
+                    type='scatter',
+                    name=name,
+                    mode=kwargs.get('line_type'),
+                    showlegend=True,
+                )
+            )
+
+        layout = self.compile_layout()
+        layout['xaxis'].update(
+            {
+                'title': 'False Positive Rate',
+                'showline': False,
+                'zeroline': True,
+                'showticklabels': True,
+            }
+        )
+        layout['yaxis'].update(
+            {
+                'title': 'True Positive Rate',
+                'showgrid': True,
+                'zeroline': True,
+                'showticklabels': True,
+            }
+        )
+
+        return {'data': traces, 'layout': layout}
