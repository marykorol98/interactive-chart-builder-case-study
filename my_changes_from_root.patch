+from __future__ import annotations
+
+import json
+import re
+from typing import Any
+
+import numpy as np
+import pandas as pd
+import plotly.graph_objs as go
+
+from smile_ml_core.data.structures import DictDataFrame
+
+from ..data.exceptions import PlottingAbsentColumnExceptions, PlottingParametersException
+from ._sorting_mixin import SortingMixin
+from .styles import StyleBool, StyleModificator, StyleString
+
+
+class PredictVisualizing(SortingMixin):
+    interval_param_default = 0.5
+    exclude_types = {'object', 'datetime64'}
+    styles_fields_exclude = {'marker_color', 'line_type', 'max_size'}
+
+    styles_extra = [
+        StyleBool(id_='multiple_axes', label='Multiple axes', value=True, layout=True),
+        StyleString(id_='units', label='Measurement units', value='', layout=True),
+    ]
+    styles_modificators = [StyleModificator(id_='scheme_color', value='dark')]
+    styles_fields: list | str = '__all__'
+
+    columns_templates = [
+        {
+            'label': 'Column',
+            'name': 'columns',
+            'logarithm': True,
+            'source': 'columns',
+            'multi': True,
+        },
+        {
+            'label': 'Intervals',
+            'name': 'intervals',
+        },
+        {
+            'label': 'Messages',
+            'name': 'messages',
+        },
+    ]
+
+    def __init__(self):
+        super().__init__()
+        self.columns: list[str] = []
+        self.label_column: str | None = None
+
+    @classmethod
+    def _get_series(
+        cls,
+        df: pd.DataFrame,
+        additional_data: dict,
+        columns: list[str],
+        index_col: str = 'index',
+        group_by_col: str | None = None,
+        data_slice_style: StyleString | None = None,
+        *args,
+        **kwargs,
+    ) -> list[tuple[None, Any]]:
+        """
+        Здесь переопределили метод, потому что данный вид графика работает с вероятностями,
+        обычный метод не обрабатывает эти случаи.
+        Была удалена группировка и изменен метод сэмплирования.
+        """
+        df_out = pd.DataFrame()
+        proba = []
+
+        for column in columns:
+            if cls.is_proba_column(column):
+                proba.append(cls.get_one_series(df, {}, col=column))
+            else:
+                df_out[column] = cls.get_one_series(df, {}, col=column)
+
+        if not proba:
+            raise PlottingAbsentColumnExceptions(column='proba')
+
+        proba_array = np.array(proba).T
+        data_slice: slice = cls.parse_slice_style(data_slice_style, df_out.shape)
+
+        df_out = df_out[data_slice]
+        proba_array = proba_array[data_slice]
+
+        return [(None, df_out), (None, proba_array)]
+
+    @staticmethod
+    def make_multiple_axes(i: int, layout: dict, title: str, marker_color: list[str] | None = None) -> dict[str, str]:
+        assert i <= 5, 'More than 6 columns are chosen, their number should be reduced'
+
+        side, pos, vector = ('right', 0.75, 1) if i % 2 == 1 else ('left', 0.3, -1)
+        layout[f'yaxis{i + 1}'] = dict(
+            title=title,
+            side=side,
+            overlaying='y',
+            anchor='free',
+            position=pos + vector * 0.1 * (i // 2),
+            titlefont=dict(color=marker_color[i]) if marker_color else None,
+            tickfont=dict(color=marker_color[i]) if marker_color else None,
+        )
+        layout['xaxis'] = dict(domain=[0.3, 0.75])
+
+        return layout
+
+    def plot(
+        self,
+        df: pd.DataFrame,
+        *args,
+        reverse: bool,
+        sort_column: str | None = None,
+        columns: list[str] | None = None,
+        styles: dict[str, str] | None = None,
+        **kwargs,
+    ) -> dict:
+        if columns is None or len(columns) == 0:
+            raise PlottingParametersException(self.MESSAGE_COLUMNS_EMPTY)
+        self.columns = columns
+        self.set_sorting_states(sort_column, reverse)
+        self.update_styles(styles)
+        self.check_columns_type(df, columns)
+
+        if not (proba_keys := list(filter(self.is_proba_column, df.columns))):
+            raise PlottingAbsentColumnExceptions(column='proba')
+
+        ddf = DictDataFrame.from_dict({'df': df})
+        df_prepared, proba = self.get_series(ddf, {}, columns=self.columns + proba_keys)
+        df_prepared, proba = df_prepared[1], proba[1]
+        index = df_prepared.index.tolist()
+
+        marker_color = self.scheme_color[self.styles['scheme_color'].value]
+        units = self.styles['units'].value.replace(' ', '').split(',')
+
+        traces = []
+        layout = self.compile_layout()
+        xaxis_title = layout['xaxis_title'] = 'Index' if layout['xaxis_title'] in ['', None] else layout['xaxis_title']
+
+        for i, col in enumerate(df_prepared.columns):
+            # for units
+            # Здесь контроллируется, чтобы индекс столбца не заходил за пределы длины списка с ед-цами измерения.
+            # Если на вход идёт меньше значений, чем количество столбцов,
+            # последнее добавляется к тайтлам тех столбцов, которым не хватило значений.
+            j = i if i < len(units) else -1
+            unit_prefix = f', {units[j]}' if len(self.styles['units'].value) > 0 else ''
+            title = f'{col}{unit_prefix}'
+            yaxis = 'y'
+
+            if i == 0 or not self.styles['multiple_axes'].value:
+                layout['yaxis'] = dict(
+                    title=title,
+                    titlefont=dict(color=marker_color[i]),
+                    tickfont=dict(color=marker_color[i]),
+                )
+
+            else:
+                assert i <= 5, 'More than 6 columns are chosen, their number should be reduced'
+                yaxis = f'y{i + 1}'
+                layout = self.make_multiple_axes(i, layout, title, marker_color)
+
+            trace = go.Scatter(
+                x=index,
+                y=df_prepared[col].tolist(),
+                mode='lines+markers',
+                line=dict(color=marker_color[i], width=2),
+                name=col,
+                yaxis=yaxis,
+            )
+
+            traces.append(trace.to_plotly_json())
+
+        intervals = self.parse_intervals(kwargs.get('intervals', '{}'))
+        messages = json.loads(kwargs.get('messages', '[]').replace("'", '"'))
+
+        if len(messages) != len(intervals.keys()):
+            raise PlottingParametersException('Количество сообщений должно совпадать с количеством интервалов')
+
+        y_min = df[columns].min(axis=None).min()
+        y_max = df[columns].max(axis=None).max()
+
+        indices_all = np.array(index)
+        colors = ['red', 'yellow', 'green'] + self.scheme_color['dark']
+        intervals_legend_keys = []
+        for j, (proba_index, max_value) in enumerate(intervals.items()):
+            indices = proba[:, proba_index] > max_value
+            for i in indices_all[indices]:
+                index_next = i + 1
+                anomaly_trace = go.Scatter(
+                    x=[i, i, index_next, index_next, i],
+                    y=[y_min, y_max, y_max, y_min, y_min],
+                    mode='lines',
+                    line=dict(color=colors[j], width=0.1),
+                    name=messages[j],
+                    fill='toself',
+                    fillcolor=colors[j],
+                    opacity=0.3,
+                    textposition='bottom center',
+                    showlegend=j not in intervals_legend_keys,
+                )
+                traces.append(anomaly_trace.to_plotly_json())
+
+                if j not in intervals_legend_keys:
+                    intervals_legend_keys.append(j)
+
+        layout['xaxis'].update(title=xaxis_title)
+        layout = self.compile_layout(layout)
+
+        return {'data': traces, 'layout': layout}
+
+    @classmethod
+    def get_df_info(
+        cls,
+        data_types: dict[str, np.dtype] | None = None,
+        columns: list[str] | None = None,
+        instance: PredictVisualizing | None = None,
+        data: DictDataFrame | None = None,
+        **kwargs,
+    ) -> tuple[dict[str, np.dtype[Any]] | None, list[str] | None, PredictVisualizing | None, dict[str, Any]]:
+        if columns:
+            columns = cls.filter_dtypes_columns(data_types, methods=['number', 'bool'], columns=columns)
+            columns = cls.filter_not_proba_columns(columns)
+
+        if instance:
+            selected_columns, _ = (
+                instance.columns,
+                instance.label_column,
+            )  # noqa: F841
+        else:
+            selected_columns = [columns[0]] if columns else []
+
+        columns_data = dict(map(lambda col: (col, col in selected_columns), columns)) if columns else {}
+
+        cnt_intervals = 0
+
+        if data is not None:
+            if data.is_array:
+                cnt_intervals = data.array.shape[1]
+            elif data.is_df:
+                proba_list = [data.df[proba_key] for proba_key in data.df.columns if cls.is_proba_column(proba_key)]
+                cnt_intervals = max(2, np.array(proba_list).T.shape[1] if proba_list else 2)
+        else:
+            cnt_intervals = 2
+
+        intervals, messages = {}, []
+        for i in range(1, cnt_intervals):
+            intervals[i] = cls.interval_param_default
+            messages.append(f'Интервал_{i}')
+
+        kwargs['template_columns'] = {
+            'columns': columns_data,
+            'intervals': str(intervals),
+            'messages': str(messages),
+        }
+        kwargs['sorting_columns'] = columns_data
+
+        return data_types, columns, instance, kwargs
+
+    @classmethod
+    def get_json(
+        cls,
+        data_types: dict | None = None,
+        columns: list | None = None,
+        instance: PredictVisualizing | None = None,
+        **kwargs,
+    ) -> list[dict]:
+        data_types, columns, instance, kwargs = cls.get_df_info(
+            data_types=data_types, columns=columns, instance=instance, **kwargs
+        )
+
+        return super().get_json(data_types, columns, instance, **kwargs)
+
+    @classmethod
+    def check_to_show(cls, data_types: dict | None = None, columns: list | None = None, **kwargs) -> bool:
+        columns = cls.filter_dtypes_columns(data_types, methods=['number'], columns=columns)
+
+        return len(columns) > 0
+
+    @staticmethod
+    def parse_intervals(intervals: str) -> dict[int, float]:
+        res = {}
+        intervals_found = re.search(r'^{(.*?)}$', intervals)
+        if intervals_found is None:
+            raise PlottingParametersException('Неверный формат интервалов. Пример: {1:0.2, 2:0.4}')
+
+        try:
+            intervals = intervals_found.group(1)
+            for kv in intervals.split(','):
+                key, value = kv.split(':')
+                res[int(key)] = float(value)
+        except (AttributeError, ValueError):
+            raise PlottingParametersException('Неверный формат интервалов. Пример: {1:0.2, 2:0.4}')
+
+        return res
