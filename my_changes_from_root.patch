+from typing import Any
+
+import numpy as np
+import plotly.graph_objs as go
+from plotly.subplots import make_subplots
+from sklearn.preprocessing import LabelEncoder
+
+from ..data.exceptions import PlottingParametersException
+from .base_method import BaseMethod
+from ..models._ml_model_protocol import MLModel
+
+
+class DecisionBoundaryDisplay(BaseMethod):
+    exclude_types = {'object', 'datetime64'}
+
+    columns_templates = [
+        {
+            'label': 'x1',
+            'name': 'x_1',
+            'source': 'x_1',
+            'default': [],
+            'multi': False,
+        },
+        {
+            'label': 'x2',
+            'name': 'x_2',
+            'source': 'x_2',
+            'default': [],
+            'multi': False,
+        },
+    ]
+
+    styles_fields_exclude = {'bg_color', 'line_type', 'multiple_axes', 'marker_color'}
+
+    def __init__(self):
+        super().__init__()
+        self.columns: list[str] = []
+        self.x_1: str = ''
+        self.x_2: str = ''
+        self.label_column: str | None = None
+        self.target_column_name: str | None = None
+
+    def plot(self, df, *args, **kwargs: Any) -> Any:
+        self.x_1, self.x_2 = kwargs.get('x_1', None), kwargs.get('x_2', None)
+        columns = [self.x_1, self.x_2]
+
+        if len(columns) < 2 or len(args) == 0:
+            raise Exception(self.MESSAGE_COLUMNS_EMPTY)
+        if columns[0] == columns[1]:
+            raise Exception('Column values must not be the same')
+
+        styles = kwargs.get('styles', None)
+
+        if columns is None or len(columns) == 0:
+            raise PlottingParametersException(self.MESSAGE_COLUMNS_EMPTY)
+
+        self.columns = columns
+        if len(columns) < 2:
+            raise ValueError('Number of chosen columns should be not less than 2')
+
+        try:
+            self.label_column = label_column_name = [col for col in df.columns if 'predict(' in col][-1]
+        except IndexError:
+            raise IndexError('No predict column received')
+
+        try:
+            self.target_column_name = target_column_name = args[0].split(':')[
+                -1
+            ]  # нам нужна только читаемая часть заголовка
+        except IndexError:
+            raise IndexError('No target column received')
+
+        self.update_styles(styles=styles)
+
+        cols_for_reducing = columns + [label_column_name] + [target_column_name]
+
+        self.check_columns_type(df, columns)
+
+        df_reduced = self.get_series(df, kwargs, cols_for_reducing)
+        df_reduced = df_reduced[0][1]
+
+        X = df_reduced[columns]
+        y = df_reduced[label_column_name]
+
+        x_min, x_max = (
+            df_reduced[columns[0]].min() - 1,
+            df_reduced[columns[0]].max() + 1,
+        )
+        y_min, y_max = (
+            df_reduced[columns[1]].min() - 1,
+            df_reduced[columns[1]].max() + 1,
+        )
+
+        xx, yy = np.meshgrid(np.linspace(x_min, x_max), np.linspace(y_min, y_max))
+        y_ = np.linspace(y_min, y_max)
+
+        assert 'model' in kwargs.keys(), 'The model is not available'
+        predictor: MLModel | None = kwargs.get('model')
+        if predictor is None:
+            raise ValueError('The model for the predictor is not available')
+
+        predictor.fit(X, y)
+
+        z = predictor.predict(np.c_[xx.ravel(), yy.ravel()])
+        colorbar = None
+        if isinstance(z[0], str) or isinstance(z[0], bool):
+            enc = LabelEncoder()
+            enc.fit(z)
+            z = enc.transform(z)
+            colorbar = dict(tickvals=enc.transform(enc.classes_), ticktext=enc.classes_)
+
+        z = z.reshape(xx.shape)
+
+        fig = make_subplots(rows=1, cols=1)
+
+        display = go.Heatmap(
+            x=xx[0],
+            y=y_,
+            z=z,
+            showscale=True,
+            hovertemplate='%{z}',
+            showlegend=True,
+            colorbar=colorbar,
+            name='Predictions Heatmap',
+            colorscale='Viridis',
+            xaxis='x',
+            yaxis='y',
+        )
+
+        fig.add_trace(display, row=1, col=1)
+
+        marker_color = self.scheme_color[self.styles['scheme_color'].value]
+
+        for i, label in enumerate(df_reduced[target_column_name].unique()):
+            df_label = df_reduced[df_reduced[target_column_name] == label].copy()
+            scatters = go.Scatter(
+                x=df_label[columns[0]],
+                y=df_label[columns[1]],
+                mode='markers',
+                showlegend=True,
+                marker=dict(
+                    size=10,
+                    color=marker_color[i],
+                    line=dict(color='black', width=1),
+                ),
+                text=df_reduced[target_column_name].astype(str),
+                name=label if isinstance(label, str) else str(label),
+                hovertemplate='Value: %{text}',
+            )
+            fig.add_trace(scatters, row=1, col=1)
+
+        layout = self.compile_layout()
+
+        layout['title'] = (
+            'Decision Boundary Display' if layout['title'] == 'DecisionBoundaryDisplay' else layout['title']
+        )
+        layout['xaxis_title'] = self.x_1 if layout.get('xaxis_title') in ['', None] else layout.get('xaxis_title')
+        layout['yaxis_title'] = self.x_2 if layout.get('yaxis_title') in ['', None] else layout.get('yaxis_title')
+
+        fig.update_layout(layout)
+
+        return fig.to_plotly_json()
+
+    @classmethod
+    def get_columns(cls, data_types=None, columns=None, instance=None, **kwargs):
+        columns = cls.filter_dtypes_columns(data_types, methods=['number', 'object'], columns=columns)
+        columns = cls.filter_not_proba_columns(columns)
+
+        if instance:
+            selected_column1, selected_column2 = instance.x_1, instance.x_2
+        else:
+            selected_column1 = columns[0] if columns else None
+            selected_column2 = columns[1] if len(columns) > 1 else None
+
+        columns1 = dict(map(lambda col: (col, col == selected_column1), columns))
+        columns2 = dict(map(lambda col: (col, col == selected_column2), columns))
+
+        return {'x_1': columns1, 'x_2': columns2}
+
+    @classmethod
+    def check_to_show(cls, columns=None, data_types=None, **kwargs):
+        columns = cls.filter_dtypes_columns(data_types, methods=['number', 'string'], columns=columns)
+        return len(columns) >= 2  # must be at least 2 columns
