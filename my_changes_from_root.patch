+import plotly.express as px
+
+from ..data.exceptions import PlottingParametersException
+from .base_method import BaseMethod
+
+
+class BoxPlot(BaseMethod):
+    exclude_types = {'datetime64'}
+    styles_fields_exclude = {'line_type', 'marker_color', 'max_size', 'xaxis_title'}
+
+    columns_templates = [
+        {
+            'label': 'Столбцы',
+            'name': 'columns',
+            'source': 'columns',
+            'multi': True,
+        },
+        {
+            'label': 'Group by',
+            'name': 'group_by',
+            'source': 'group_by',
+            'include_non_selected': True,
+        },
+    ]
+
+    def __init__(self):
+        super().__init__()
+        self.if_group_by: str = self.non_selected
+
+    def plot(
+        self,
+        df,
+        *args,
+        columns: list[str] | None = None,
+        styles: dict[str, str] | None = None,
+        **kwargs,
+    ):
+        if columns is None or len(columns) == 0:
+            raise Exception(self.MESSAGE_COLUMNS_EMPTY)
+
+        self.columns = columns
+        self.if_group_by = group_by = kwargs.get('group_by', self.non_selected)
+        if group_by == self.non_selected:
+            group_by = None
+
+        self.update_styles(styles=styles)
+
+        if group_by is not None and len(columns) > 1:
+            raise PlottingParametersException('Группировка доступна только для одного столбца')
+
+        df_reduced = self.get_series(df, kwargs, columns + ([group_by] if group_by else []))
+        assert len(df_reduced) == 1, 'The input data was split into several dfs, check'
+        df = df_reduced[0][1]
+
+        self.check_columns_type(df, columns)
+
+        fig = px.box(df, x=group_by, y=columns, color_discrete_sequence=self.get_colors())
+
+        layout = self.compile_layout()
+        layout['yaxis_title'] = 'Values' if layout.get('yaxis_title') in ['', None] else layout.get('yaxis_title')
+        fig.update_layout(layout)
+
+        return fig.to_plotly_json()
+
+    @classmethod
+    def get_columns(cls, data_types=None, columns=None, instance=None, **kwargs):
+        columns_numeric: list = cls.filter_not_proba_columns(
+            cls.filter_dtypes_columns(data_types, methods=['number'], columns=columns, exclude=['bool'])
+        )
+        columns_object = cls.filter_not_proba_columns(
+            cls.filter_dtypes_columns(
+                data_types,
+                methods=['int', 'string', 'object', 'category', 'bool'],
+                columns=columns,
+            )
+        )
+        if instance is None:
+            columns = dict(map(lambda col: (col, True), columns_numeric))  # по дефолту выбраны все
+            columns_group_by = dict(map(lambda col: (col, False), columns_object))  # по дефолту ни один не выбран
+        else:
+            columns = dict(map(lambda col: (col, col in instance.columns), columns_numeric))
+            columns_group_by = dict(map(lambda col: (col, col == instance.group_by), columns_object))
+
+        return {'columns': columns, 'group_by': columns_group_by}
+
+    @classmethod
+    def check_to_show(cls, columns=None, data_types=None, **kwargs):
+        columns = cls.filter_dtypes_columns(data_types, methods=['number'], columns=columns, exclude=['bool'])
+        return len(columns) > 0
