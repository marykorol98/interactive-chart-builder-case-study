diff --git a/smile_ml_core/plot_methods/user_code_plotting/code_execution.py b/smile_ml_core/plot_methods/user_code_plotting/code_execution.py
new file mode 100644
index 00000000..a23168a0
--- /dev/null
+++ b/smile_ml_core/plot_methods/user_code_plotting/code_execution.py
@@ -0,0 +1,170 @@
+import logging
+import traceback
+from typing import Any
+import pandas as pd
+import ast
+import pandas as pd
+import numpy as np
+
+logger = logging.getLogger(__name__)
+
+
+def _convert_object_to_output(obj: Any) -> dict[str, Any]:
+    """
+    Универсальная конвертация результата кода в формат для фронтенда.
+    Поддерживает DataFrame, Series, ndarray, plotly (express и graph_objects),
+    а также базовые типы.
+    """
+    # --- Plotly (graph_objects, express, etc.) ---
+    if hasattr(obj, "__class__") and "plotly" in str(type(obj)).lower():
+        try:
+            # Попробуем to_plotly_json() — если не получится, fallback на to_dict()
+            if hasattr(obj, "to_plotly_json"):
+                fig_json = obj.to_plotly_json()
+            elif hasattr(obj, "to_dict"):
+                fig_json = obj.to_dict()
+            else:
+                fig_json = str(obj)
+            return {
+                "type": "plotly",
+                "data": fig_json,
+            }
+        except Exception as e:
+            return {
+                "type": "text",
+                "data": f"Ошибка сериализации plotly объекта: {e}"
+            }
+
+    # --- DataFrame ---
+    if isinstance(obj, pd.DataFrame):
+        return {
+            "type": "table",
+            "data": obj.to_json(orient="records"),
+            "meta": {"columns": list(obj.columns), "shape": obj.shape}
+        }
+
+    # --- Series ---
+    if isinstance(obj, pd.Series):
+        return {
+            "type": "series",
+            "data": obj.to_dict(),
+            "meta": {"name": obj.name}
+        }
+
+    # --- NumPy ---
+    if isinstance(obj, np.ndarray):
+        return {
+            "type": "ndarray",
+            "data": obj.tolist(),
+            "meta": {"shape": obj.shape}
+        }
+
+    # --- Примитивы ---
+    if isinstance(obj, (str, int, float, bool)):
+        return {"type": "text", "data": str(obj)}
+
+    # --- Fallback ---
+    text_repr = str(obj)
+    if len(text_repr) > 2000:
+        text_repr = text_repr[:2000] + " ... [truncated]"
+    return {"type": "text", "data": text_repr}
+
+def execute_code(data_el: pd.DataFrame, user_code: str) -> list[dict[str, Any]]:
+    """
+    Безопасное выполнение пользовательского кода с возвратом результата
+    (включая последний expression или последнюю присвоенную переменную).
+    Поддерживает DataFrame, Series, numpy, plotly.express / plotly.graph_objects и простые типы.
+    """
+
+    local_vars = {'df': data_el}
+    exec_globals = {
+        "__builtins__": {
+            "len": len, "range": range, "min": min, "max": max, "sum": sum,
+            "abs": abs, "round": round, "enumerate": enumerate, "zip": zip,
+            "__import__": __import__,  # разрешаем импорты
+        }
+    }
+
+    try:
+        tree = ast.parse(user_code, mode="exec")
+        last_stmt = tree.body[-1] if tree.body else None
+    except SyntaxError as e:
+        err_msg = f"Ошибка парсинга кода: {e}"
+        logger.error(err_msg)
+        return [{'type': 'text', 'data': err_msg}]
+
+    result = None
+
+    try:
+        # Если последнее выражение — это просто Expr (например, df.head())
+        if isinstance(last_stmt, ast.Expr):
+            exec(compile(ast.Module(body=tree.body[:-1], type_ignores=[]),
+                         filename="<ast>", mode="exec"),
+                 exec_globals, local_vars)
+            result = eval(compile(ast.Expression(last_stmt.value),
+                                  filename="<ast>", mode="eval"),
+                          exec_globals, local_vars)
+
+        # Если последнее выражение — это присваивание
+        elif isinstance(last_stmt, ast.Assign):
+            exec(compile(tree, filename="<ast>", mode="exec"), exec_globals, local_vars)
+            last_target = last_stmt.targets[-1]
+            if isinstance(last_target, ast.Name):
+                result = local_vars.get(last_target.id)
+
+        # Иначе просто выполняем код
+        else:
+            exec(compile(tree, filename="<ast>", mode="exec"), exec_globals, local_vars)
+
+    except Exception:
+        err_msg = f"Ошибка при выполнении кода:\n{traceback.format_exc()}"
+        logger.error(err_msg)
+        return [{'type': 'text', 'data': err_msg}]
+
+    # --- Преобразуем объекты в структурированный вид ---
+    output_items = []
+    seen_ids = set()
+
+    def convert_and_add(obj):
+        if obj is None:
+            return
+        obj_id = id(obj)
+        if obj_id in seen_ids:
+            return
+        seen_ids.add(obj_id)
+        try:
+            converted = _convert_object_to_output(obj)
+            if converted:
+                output_items.append(converted)
+        except Exception as e:
+            output_items.append({
+                'type': 'text',
+                'data': f'Ошибка при сериализации объекта: {e}'
+            })
+
+    # Если в результате получен график — не дублируем другие переменные
+    def is_plotly_obj(obj):
+        return hasattr(obj, "__class__") and "plotly" in str(type(obj)).lower()
+
+    if result is not None:
+        convert_and_add(result)
+        if is_plotly_obj(result):
+            return output_items  # возвращаем только график
+
+    # Добавляем другие переменные (кроме стандартных)
+    standard_vars = {'pd', 'np', 'px', 'plotly', 'df'}
+    for name, val in local_vars.items():
+        if name in standard_vars:
+            continue
+        convert_and_add(val)
+
+    if not output_items:
+        output_items.append({
+            'type': 'text',
+            'data': "Code executed successfully but no notable object found."
+        })
+
+    return output_items
+
+
+

