+
+        self.max_size = kwargs['max_size'] = self.img_count = int(kwargs.get('img_count', '1'))
+
+        self.column_predict = column_predict
+        self.column_target = column_target
+
+        # self.update_styles(styles=styles)  # TODO исправить после фикса настроек на фронте
+
+        is_remote = getattr(data, 'is_remote', False)
+
+        if not is_remote:
+            img = self.plot_table_images(data, meta=meta, shape=kwargs.get('shape', ''))
+        else:
+            img = self.plot_remote_images(data, kwargs.get('draw_target', False))
+
+        self.generate_image_plots_dir()
+        file_name = self.generate_hashed_plot_image_name(input_name='plot_image.png')
+        img_path = os.path.join(self.image_plots_source, file_name)
+
+        img.tight_layout()
+        img.savefig(img_path)
+
+        fig = go.Figure()
+        fig.add_layout_image(
+            {
+                'source': f'{settings.URL_SCHEME}{settings.DOMAIN}/api/{img_path}',
+                'xref': 'x',
+                'yref': 'y',
+                'x': 1,
+                'y': 4,
+                'sizex': 5,
+                'sizey': 5,
+            }
+        )
+
+        fig.update_layout(
+            template='plotly_white',
+            xaxis={'showgrid': False},
+            yaxis={'showgrid': False},
+        )
+        fig.update_xaxes(visible=False)
+        fig.update_yaxes(visible=False)
+
+        return fig.to_plotly_json()
+
+    def plot_remote_images(self, data: 'DictDataFrameRemote', draw_target: bool = False) -> plt.Figure:
+        predict_path = None
+        if self.column_predict and self.column_predict != self.non_selected:
+            predict_path = Path(self.column_predict)
+
+        first_image, is_mask = data[self.column[0]], False
+        to_draw_mask = draw_target or predict_path is not None
+        if isinstance(first_image, tuple):
+            is_mask = hasattr(first_image[1], 'shape') and len(first_image[1].shape) > 1
+            first_image = first_image[0]
+
+        if to_draw_mask and is_mask:
+            fig = self._plot_remote_images_with_mask(first_image, draw_target=draw_target, predict_path=predict_path)
+        else:
+            fig = self._plot_remote_images_without_mask(first_image, draw_target=draw_target)
+
+        return fig
+
+    def _plot_remote_images_without_mask(self, data, draw_target: bool):
+        rows = (len(self.column) - 1) // 2 + 1  # by 2 images into a row
+        cols = 2 if len(self.column) > 1 else 1  #
+
+        width = self.DEFAULT_FIG_WIDTH
+        height = 12  # int(width * first_image.shape[0] / first_image.shape[1])
+        fig, axes = plt.subplots(rows, cols, figsize=(width, height))
+
+        predict_indices, predict_list = None, []
+        if self.column_predict is not None and self.column_predict != self.non_selected:
+            predict_list = data[self.column_predict]
+            predict_indices = data.indices_by_images(img_paths=self.column)
+
+        if isinstance(axes, np.ndarray):
+            axes = axes.flatten()
+        else:
+            axes = [axes]
+        axes[-1].set_axis_off()  # by default at the start turn off axes for last image (can be not selected)
+
+        for i, image_path in enumerate(self.column):
+            # target can be a number for classification, and np.ndarray for segmentation
+            image, target, predict = data[image_path], None, None
+            if isinstance(image, tuple):
+                assert len(image) == 2, 'If the image is tuple, it can have size equal to 2: image and target'
+                image, target = image
+
+            if not draw_target:
+                target = None
+            elif isinstance(target, int):
+                # For classification, we use subfolder as target name. So beside int target to get subfolder
+                target = Path(image_path).parent.name
+
+            if predict_indices is not None:
+                predict = predict_list[predict_indices[i]]
+
+            self._plot_single_img(axes[i], image, target=target, predict=predict)
+
+        return fig
+
+    @staticmethod
+    def _draw_segmentation_mask(image, mask):
+        import torch
+        from torchvision.transforms import ToPILImage, ToTensor
+        from torchvision.utils import draw_segmentation_masks
+
+        if isinstance(image, np.ndarray):
+            image = ToTensor()(image)
+
+        if image.max() <= 1.5:  # 1.5 because additive noize can increase value of pixels
+            image = (image * 255).type(torch.uint8)
+
+        if isinstance(mask, np.ndarray):
+            mask = torch.tensor(mask).long()
+
+        if mask.max() <= 1.0:
+            mask = (mask * 255).type(torch.uint8)
+
+        mask = mask.numpy()
+        if mask.max() == 0:
+            mask = np.array([[False] * mask.shape[0]] * mask.shape[1])
+        else:
+            mask = np.unique(mask)[1:] == mask[:, :, None]
+        mask = ToTensor()(mask).type(torch.bool)
+
+        image_out = draw_segmentation_masks(image, mask, alpha=0.6)
+
+        return ToPILImage()(image_out)
+
+    def _plot_remote_images_with_mask(self, data, draw_target: bool, predict_path: Path | None = None):
+        from imgaug import SegmentationMapsOnImage
+        from imgaug.augmenters import Resize, Sequential
+
+        rows, cols = (
+            len(self.column),
+            1 + int(draw_target) + int(predict_path is not None),
+        )
+
+        fig, axes = plt.subplots(
+            rows,
+            cols,
+            figsize=(self.DEFAULT_FIG_WIDTH, int(self.DEFAULT_FIG_WIDTH * rows / cols)),
+        )
+
+        if len(self.column) == 1:
+            axes = [axes]
+
+        for i, image_path in enumerate(self.column):
+            # target can be a number for classification, and np.ndarray for segmentation
+            image, target = data[image_path], None
+            if isinstance(image, tuple):
+                assert len(image) == 2, 'If the image is tuple, it can have size equal to 2: image and target'
+                image, target = image
+
+            # First to draw predict, because it's size can be different
+            transform = None
+            if predict_path is not None:
+                image_for_predict = image
+                predict_mask_path = predict_path / Path(image_path).name
+                mask_predict = data[str(predict_mask_path)]
+                if len(mask_predict.shape) > 2:
+                    mask_predict = mask_predict[:, :, 0]
+
+                if mask_predict.shape[0] != image.shape[0] or mask_predict.shape[1] != image.shape[1]:
+                    transform = Sequential([Resize(mask_predict.shape)])
+                    image_for_predict = transform(image=image)
+
+                image_mask = self._draw_segmentation_mask(image_for_predict, mask=mask_predict)
+                self._plot_single_img(
+                    axes[i][2 if draw_target else 1],
+                    image_mask,
+                    title='Image with predict mask',
+                )
+
+            if draw_target:
+                if transform is not None:
+                    if target is None:
+                        raise ValueError('target must be provided')
+                    segmap = SegmentationMapsOnImage(target.numpy().astype('uint8'), shape=image.shape)
+                    res = transform(image=image, segmentation_maps=segmap)
+
+                    image, target = res[0], res[1].arr[:, :, 0]
+
+                image_mask = self._draw_segmentation_mask(image, mask=target)
+                self._plot_single_img(axes[i][1], image_mask, title='Image with target mask')
+            elif transform is not None:
+                image = transform(image=image)
+
+            # to draw source image
+            self._plot_single_img(axes[i][0], image, title='Original image')
+
+        return fig
+
+    def plot_table_images(self, data, meta: dict[str, Any], shape: str | None = None):
+        column = self.column[0]
+        img_ = data if isinstance(data, np.ndarray) else data.get(column)
+
+        if img_ is not None and len(img_.shape) == 3:
