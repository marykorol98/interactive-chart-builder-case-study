+        
+        # # legend_dot = self.generate_simple_legend_dot(class_color_map)
+        # legend_dot = self.generate_gradient_legend_dot(class_color_map)
+        
+        # dot_data_with_legend = dot_data.rstrip('}\n') + legend_dot + '\n}'
+        
+        # graph = graphviz.Source(dot_data_with_legend)
+
+        # file_name = self.generate_hashed_plot_image_name(input_name='tree_graph_visualizer')
+
+        # # Получаем изображение в бинарном виде
+        # with io.BytesIO(graph.pipe(format='png')) as img_data:
+        #     img_data.seek(0)
+        #     # Сохраняем картинку в байтах на s3 хранилище
+        #     img_s3_src = boto_handler(img_data, file_name)
+
+        # fig = go.Figure()
+        # fig.add_layout_image(
+        #     {
+        #         'source': img_s3_src,
+        #         'xref': 'paper',
+        #         'yref': 'paper',
+        #         'x': 0,
+        #         'y': 1,
+        #         'sizex': 1,
+        #         'sizey': 1,
+        #         'sizing': 'contain', # ✅ сохранить пропорции
+        #         'layer': 'below',
+        #     }
+        # )
+
+        # fig.update_layout(
+        #     template='plotly_white',
+        #     xaxis={'showgrid': False},
+        #     yaxis={'showgrid': False},
+        # )
+        # fig.update_xaxes(visible=False)
+        # fig.update_yaxes(visible=False)
+        
+        fig = self.plot_tree_with_plotly(cls_, feature_names=columns, class_names=class_names, max_depth=self.max_depth)
+
+        return convert_ndarray(fig.to_plotly_json())
+    
+    
+    def plot_tree_with_plotly(
+        self, model: Any, feature_names: Optional[list[str]] = None,
+        class_names: Optional[list[str]] = None, max_depth: Optional[int] = None
+        ) -> 'go.Figure':
+        tree = model.tree_
+        n_nodes = tree.node_count
+        children_left = tree.children_left
+        children_right = tree.children_right
+        features = tree.feature
+        thresholds = tree.threshold
+        values = tree.value
+
+        # Вычисляем координаты узлов
+        def compute_positions():
+            positions = {}
+            depths = {}
+
+            def recurse(node_id: int, depth: int, x: float):
+                if max_depth is not None and depth > max_depth:
+                    return
+                y = -depth
+                positions[node_id] = (x, y)
+                depths[depth] = depths.get(depth, 0) + 1
+
+                left = children_left[node_id]
+                right = children_right[node_id]
+                if left != right:  # не лист
+                    recurse(left, depth + 1, x - 1 / (2 ** (depth + 1)))
+                    recurse(right, depth + 1, x + 1 / (2 ** (depth + 1)))
+
+            recurse(0, 0, 0.5)
+            return positions
+
+        pos = compute_positions()
+
+        # Собираем линии (ребра)
+        edge_x = []
+        edge_y = []
+
+        for i in range(n_nodes):
+            if children_left[i] != children_right[i]:
+                for child in [children_left[i], children_right[i]]:
+                    if child == -1 or child not in pos: continue
+                    x0, y0 = pos[i]
+                    x1, y1 = pos[child]
+                    edge_x += [x0, x1, None]
+                    edge_y += [y0, y1, None]
+
+        edge_trace = go.Scatter(
+            x=edge_x,
+            y=edge_y,
+            mode='lines',
+            line=dict(color='gray', width=1),
+            hoverinfo='none'
+        )
+
+        # Собираем узлы
+        node_x = []
+        node_y = []
+        labels = []
+        colors = []
+
+        for i in range(n_nodes):
+            if i not in pos:
+                continue
+            x, y = pos[i]
+            node_x.append(x)
+            node_y.append(y)
+
+            if children_left[i] == children_right[i]:  # лист
+                label = f"Leaf<br>samples={tree.n_node_samples[i]}<br>value={values[i].tolist()}"
+            else:
+                fname = feature_names[features[i]] if feature_names is not None else f"f{features[i]}"
+                label = f"{fname} ≤ {thresholds[i]:.2f}<br>samples={tree.n_node_samples[i]}<br>value={values[i].tolist()}"
+
+            labels.append(label)
+
+            # Цвет — по доминирующему классу
+            if class_names is not None and values.shape[-1] > 1:
+                class_id = np.argmax(values[i])
+                colors.append(class_id)
+            else:
+                colors.append(0)
+
+        node_trace = go.Scatter(
+            x=node_x,
+            y=node_y,
+            mode='markers+text',
+            marker=dict(
+                showscale=True,
+                colorscale='Viridis',
+                color=colors,
+                size=40,
+                line=dict(color='black', width=1)
+            ),
+            textposition='middle center',
+            text=[f"{i}" for i in range(len(node_x))],
+            hoverinfo='text',
+            hovertext=labels
+        )
+
+        fig = go.Figure(data=[edge_trace, node_trace])
+        fig.update_layout(
+            title="Интерактивная визуализация дерева",
+            showlegend=False,
+            margin=dict(t=50, b=20, l=20, r=20),
+            xaxis=dict(showgrid=False, zeroline=False, showticklabels=False),
+            yaxis=dict(showgrid=False, zeroline=False, showticklabels=False),
+            height=600
+        )
+        
+        return fig
+    
+
+    @classmethod
+    def check_to_show(cls, *args, columns=None, **kwargs):
+        model_path = kwargs.get('model_path')
+        # Строится только при деревьях и лесах 
+        # Проверяем по названию -> не очень красиво, но лучшего способа пока не придумано
+        for model_pattern in TREE_MODELS:
+            if model_pattern in model_path:
+                return True
+            
+        return False
+
+    @classmethod
+    def default_properties(cls) -> dict[str, Any]:
+        return {'tree_index': ''}
+
+    @classmethod
+    def get_columns(
+        cls,
+        data_types: dict[str, Any] | None = None,
+        columns: list[str] | None = None,
+        instance: Any | None = None,
+        **kwargs,
+    ) -> dict[str, Any]:
+        plots_data: dict[str, Any] = {}
+        if instance is None:
+            plots_data |= cls.default_properties()
+            max_depth = cls.MAX_DEPTH_DEFAULT
+        else:
+            plots_data['tree_index'] = str(instance.tree_index)
+            max_depth = instance.max_depth
+
+        return plots_data | {'max_depth': max_depth}
