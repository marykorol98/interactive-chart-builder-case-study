+
+    columns_templates = [
+        {
+            'label': 'x1',
+            'name': 'x_1',
+            'source': 'x_1',
+            'default': [],
+            'multi': False,
+        },
+        {
+            'label': 'x2',
+            'name': 'x_2',
+            'source': 'x_2',
+            'default': [],
+            'multi': False,
+        },
+        {
+            'label': 'Window size',
+            'name': 'window_size',
+            'source': 'window_size',
+            'default': 10,
+        },
+        {
+            'label': 'Correlation threshold',
+            'name': 'corr_threshold',
+            'source': 'corr_threshold',
+            'default': 0.5,
+        },
+    ]
+
+    def __init__(self):
+        super().__init__()
+
+    @staticmethod
+    def timestamp_to_index(
+        time_index: pd.Series | list[Timestamp],
+    ) -> tuple[list[int], dict[Timestamp, int]]:
+        """
+        Функция для перевода Timestamp в порядковые индексы
+
+        Parameters:
+        -----------
+        time_index : array-like
+            Временной индекс
+
+        Returns:
+        --------
+        int_index: list
+            Целочисленный индекс
+        time_dict: dict
+            Словарь для обратной конвертации
+        """
+        # создаём словарь дат
+        all_dates = sorted(time_index)
+        time_dict = {key: value for (key, value) in enumerate(all_dates)}
+        time_to_int_dict = {
+            value: key for key, value in time_dict.items()
+        }  # словарь для обратной конвертации на следующих итерациях
+        int_index = [time_to_int_dict[date] for date in time_index]
+
+        return sorted(int_index), time_dict
+
+    @staticmethod
+    def bad_corr_periods_search(
+        corr_dict: dict[int, dict[str, Any]],
+    ) -> list[list[int]]:
+        """
+        Нахождение участков с низкой корреляцией для дальнейшего отображения на графике
+
+        Parameters:
+        -----------
+        corr_dict : dict
+            Словарь с корреляциями, где ключи - индексы окон с низкой корреляцией, значения - левые и правые границы окон.
+
+        Returns:
+        --------
+        bad_periods_filtered : list
+            Список участков с корреляциями ниже минимального порога.
+        """
+
+        bad_periods = []
+        indices = list(corr_dict.keys())
+        period = [indices[0]]
+        for i in range(len(indices) - 1):
+            if indices[i + 1] - indices[i] > 1:
+                bad_periods.append([corr_dict[period[0]]['s'], corr_dict[period[-1]]['f']])
+                period = []
+            period.append(indices[i + 1])
+
+        bad_periods.append([corr_dict[period[0]]['s'], corr_dict[period[-1]]['f']])  # the last iteration
+
+        # Теперь объединим все пересекающиеся участки
+        previous = bad_periods[0]
+        bad_periods_filtered = []
+
+        if len(bad_periods) > 1:
+            for start, finish in bad_periods[1:]:
+                if start in range(*previous) or start == previous[1]:
+                    previous[1] = finish if finish > previous[1] else previous[1]
+                else:
+                    bad_periods_filtered.append(previous)
+                    previous = [start, finish]
+
+        bad_periods_filtered.append(previous)
+
+        return bad_periods_filtered
+
+    def plot(self, df, *args, **kwargs: Any) -> Any:
+        x1, x2 = (kwargs.get('x_1', None), kwargs.get('x_2', None))
+        window_size = int(kwargs.get('window_size', 10))
+        corr_threshold = float(kwargs.get('corr_threshold', 0.5))
+
+        if x1 is None or x2 is None:
+            raise Exception(self.MESSAGE_COLUMNS_EMPTY)
+        if x1 == x2:
+            raise Exception('Column values must not be the same')
+        if window_size <= 1:
+            raise Exception('Window size should be greater than 1')
+
+        styles = kwargs.get('styles', None)
+
+        self.update_styles(styles=styles)
+
+        self.check_columns_type(df, [x1, x2])
+
+        df_reduced = self.get_series(df, kwargs, [x1, x2])
+        df_reduced = df_reduced[0][1].sort_index()
+
+        traces = []
+        corrs = []
+        corr_low = {}
+
+        # Проверка типа индекса:
+        if isinstance(df_reduced.index[0], Timestamp):
+            int_index, time_dict = self.timestamp_to_index(df_reduced.index)
+        else:
+            int_index, time_dict = df_reduced.index, {}
+
+        for i in range(len(df_reduced) - window_size):
+            showlegend = True if i == 0 else False
+            window = slice(i, i + window_size)
+            corr = pearsonr(df_reduced[x1][window], df_reduced[x2][window])[0]  # рассчёт корелляции
+            corrs.append(corr)
+
+            if corr <= corr_threshold:
+                corr_low[i] = {'s': int_index[i], 'f': int_index[i + window_size]}
+            traces.append(
+                go.Scatter(
+                    x=df_reduced.index[window],
+                    y=[corr] * window_size,
+                    mode='lines',
+                    name='Window correlation',
+                    line=dict(width=2, color='green'),
+                    hovertemplate=corr,
+                    showlegend=showlegend,
+                )
+            )
+
+        # Теперь подсветим участки с корреляцией ниже, чем corr_threshold
+        bad_corr_periods = self.bad_corr_periods_search(corr_low) if corr_low else []
+
+        if time_dict:
+            # Конвертируем обратно в Timestamp формат
+            bad_corr_periods = [[time_dict[i], time_dict[j]] for (i, j) in bad_corr_periods]
+
+        corr_min, corr_max = min(corrs), max(corrs)
+        if len(bad_corr_periods) != 0:
+            for i, bad_period in enumerate(bad_corr_periods):
+                showlegend = True if i == 0 else False
+                traces.append(
+                    go.Scatter(
+                        x=[
+                            bad_period[0],
+                            bad_period[0],
+                            bad_period[1],
+                            bad_period[1],
+                            bad_period[0],
+                        ],
+                        y=[corr_min, corr_max, corr_max, corr_min, corr_min],
+                        line=dict(color='red', width=0.1),
+                        legendgroup='X1 and X2 window correlation <=' + str(corr_threshold),
+                        name='X1 and X2 window correlation <=' + str(corr_threshold),
+                        fill='toself',
+                        fillcolor='red',
+                        opacity=0.3,
+                        showlegend=showlegend,
+                    )
+                )
+
+        layout = self.compile_layout()
+
+        xaxis_title = 'Date' if layout['xaxis_title'] in ['', None] else layout['xaxis_title']
+        yaxis_title = 'Correlation coeficcient' if layout['yaxis_title'] in ['', None] else layout['yaxis_title']
+
+        layout['xaxis'].update({'title': xaxis_title})
+        layout['yaxis'].update({'title': yaxis_title})
+
+        return {'data': traces[::-1], 'layout': layout}
+
+    @classmethod
+    def get_columns(cls, data_types=None, columns=None, instance=None, **kwargs):
+        columns = cls.filter_not_proba_columns(
+            cls.filter_dtypes_columns(data_types, methods=['number', 'object'], columns=columns)
+        )
+
+        if instance:
+            selected_column1, selected_column2 = instance.x_1, instance.x_2
+            window_size = instance.window_size
+            corr_threshold = instance.corr_threshold
+
+        else:
+            selected_column1 = columns[0] if columns else None
+            selected_column2 = columns[1] if len(columns) > 1 else None
+            window_size, corr_threshold = 10, 0.5
+
+        columns1 = dict(map(lambda col: (col, col == selected_column1), columns))
+        columns2 = dict(map(lambda col: (col, col == selected_column2), columns))
+
+        return {
+            'x_1': columns1,
+            'x_2': columns2,
+            'window_size': window_size,
+            'corr_threshold': corr_threshold,
+        }
+
+    @classmethod
+    def check_to_show(cls, *args: Any, columns=None, **kwargs: Any) -> Any:
+        if columns is None:
+            columns = []
+        columns_dtype_filtered = cls.filter_dtypes_columns(
+            kwargs.get('data_types', {}),
+            methods=['datetime'],
+            columns=['index'] + columns,
+        )
+
+        return len(columns_dtype_filtered) > 0

