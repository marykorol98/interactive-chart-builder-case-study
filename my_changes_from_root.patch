+from typing import Any, MutableMapping
+
+from smile_ml_core.plot_methods.styles import StyleBool, StyleModificator, StyleNumber, StyleSelect, StyleString
+from smile_ml_core.plot_methods.styles.style_element import StyleElement
+
+_base_styles: list[StyleElement] = [
+    StyleSelect(
+        id_='bg_color',
+        label='Background color',
+        value='white',
+        layout=True,
+        options={'white': 'Белый', 'black': 'Черный', 'rgb(238, 235, 234)': 'Серый'},
+        set_to=['paper_bgcolor', 'plot_bgcolor'],
+    ),
+    StyleNumber(id_='size', label='Font size', value=12, layout=True, parent='font'),
+    StyleSelect(
+        id_='color',
+        label='Font color',
+        value='black',
+        layout=True,
+        parent='font',
+        options={
+            'black': 'Черный',
+            'white': 'Белый',
+        },
+    ),
+    StyleNumber(id_='tickangle', label='Rot x', parent='xaxis', value=0, layout=True),
+    StyleNumber(id_='tickangle', label='Rot y', parent='yaxis', value=0, layout=True),
+    # Not to layout
+    StyleSelect(
+        id_='scheme_color',
+        label='Color scheme',
+        value='light',
+        options={
+            'light': 'Светлая',
+            'dark': 'Темная',
+        },
+    ),
+    # Not to layout
+    StyleSelect(
+        id_='marker_color',
+        label='Marker color',
+        value='black',
+        options={
+            'black': 'Черный',
+            'white': 'Белый',
+        },
+    ),
+    # Not to layout
+    StyleString(id_='data_slice', label='Row count (data slice)', value='1000'),
+    StyleBool(
+        id_='multiple_axes',
+        label='Multiple axes',
+        value=True,
+    ),
+    StyleString(id_='title', label='Title', value='', layout=True),
+    StyleString(id_='xaxis_title', label='X title', value='', layout=True),
+    StyleString(id_='yaxis_title', label='Y title', value='', layout=True),
+    StyleString(id_='units', label='Measurement units', value=''),
+]
+
+
+class Styles(MutableMapping[str, Any]):
+    def __init__(
+        self,
+        styles_extra: list[StyleElement],
+        style_fields: list[str] | str,
+        styles_modificators: list[StyleModificator],
+        exclude: set[str] | None = None,
+    ):
+        super().__init__()
+        to_include_all = style_fields == '__all__'
+        styles_modificators_dict = dict(map(lambda v: (v.id, v), styles_modificators))
+
+        styles_extra_ids = set(map(lambda v: v.id, styles_extra))
+
+        # If some styles were redefined, then to exclude them
+        styles_default = list(filter(lambda v: v.id not in styles_extra_ids, _base_styles))
+        for style in styles_default + styles_extra:
+            if (to_include_all or style.id in style_fields) and (exclude is None or style.id not in exclude):
+                style_copy = style.copy()
+                if style_copy.id in styles_modificators_dict:
+                    style_copy = styles_modificators_dict[style_copy.id].modify(style_copy)
+                self[style.id] = style_copy
+
+    def __setitem__(self, key: str, value: Any):
+        # Implement setting an item in the Styles mapping
+        # This is required by MutableMapping
+        pass
+
+    def __getitem__(self, key: str) -> Any:
+        # Implement getting an item from the Styles mapping
+        # This is required by MutableMapping
+        pass
+
+    def __delitem__(self, key: str):
+        # Implement deleting an item from the Styles mapping
+        # This is required by MutableMapping
+        pass
+
+    def __iter__(self):
+        # Implement iteration over keys in the Styles mapping
+        # This is required by MutableMapping
+        pass
+
+    def __len__(self) -> int:
+        # Implement getting the number of items in the Styles mapping
+        # This is required by MutableMapping
+        return len(self.keys())
+
+    def update(self, *args, **kwargs):
+        # Implement updating the Styles mapping
+        if args:
+            if len(args) > 1:
+                raise TypeError('update expected at most 1 argument, got ' + str(len(args)))
+            other = dict(args[0])
+            for key in other:
+                self[key] = other[key]
+        if kwargs:
+            for key in kwargs:
+                self[key] = kwargs[key]
+
+    def to_dict(self) -> dict[str, str | int | float | bool]:
+        styles_dict = {}
+        for k, style in self.items():
+            styles_dict[k] = style.to_dict()
+
+        return styles_dict
+
+    def form_layout(self, layout: None | dict):
+        if layout is None:
+            layout = {}
+
+        for style in self.values():  # type: StyleElement
+            layout = style.update_layout(layout)
+
+        return layout
+
+    def apply_to_instance(self):
+        pass
