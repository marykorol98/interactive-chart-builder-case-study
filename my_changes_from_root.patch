diff --git a/smile_ml_core/plot_methods/autocorrelation.py b/smile_ml_core/plot_methods/autocorrelation.py
index b0f601b2..d835267a 100644
--- a/smile_ml_core/plot_methods/autocorrelation.py
+++ b/smile_ml_core/plot_methods/autocorrelation.py
@@ -57,6 +57,35 @@ class AutoCorrelation(BaseMethod):
             'default': LAG_PROPERTY_DEFAULT,
         },
     ]
+    
+    description = '''
+        График автокорреляции (ACF) показывает взаимосвязь значений временного ряда с его собственными лагами. Позволяет анализировать, насколько текущие значения зависят от предыдущих, и помогает выявить структуру временных зависимостей.
+
+        📊 Что показывает граф:
+        - По оси X — лаги (задержки) во времени.
+        - По оси Y — коэффициент автокорреляции.
+        - Столбцы — значения автокорреляции для каждого лага.
+        - Область доверительного интервала (заштрихованная зона) показывает границы статистической значимости автокорреляции.
+
+        🔍 Как интерпретировать:
+        - Коэффициенты около 1 или -1 свидетельствуют о сильной корреляции с прошлым.
+        - Если значения лежат за пределами доверительного интервала — автокорреляция значима.
+        - Быстрое затухание — признак стационарности ряда.
+        - Наличие повторяющихся пиков — возможные сезонные зависимости.
+        
+        📘 Что такое лаг?
+        Лаг — это сдвиг временного ряда назад на определённое количество шагов. Например, лаг = 1 — это сравнение текущего значения с предыдущим, лаг = 2 — с позапрошлым и т.д. Лаги помогают определить, как сильно прошлые значения влияют на текущее.
+
+        📘 Что такое стационарность?
