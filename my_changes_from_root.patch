+from collections import Counter
+from typing import Any
+
+import numpy as np
+import plotly.figure_factory as ff
+import plotly.graph_objs as go
+import randomcolor
+from plotly.subplots import make_subplots
+
+from . import SortingMixin
+from ..models._ml_model_protocol import MLModel
+
+
+class Classification(SortingMixin):
+    include_viewing_options = ['bg_color', 'font_size', 'font_color', 'rot_x', 'rot_y']
+    columns_templates = [
+        {
+            'label': 'Признаки',
+            'name': 'columns',
+            'source': 'columns2',
+            'multi': True,
+            'select_all': True,
+        },
+        {
+            'label': 'Целевой столбец',
+            'name': 'label_column',
+            'source': 'columns1',
+        },
+    ]
+
+    def __init__(self):
+        super().__init__()
+
+        self.label_column = None
+
+    def plot(self, data, target_column, **kwargs):
+        self.label_column = label_column = kwargs['label_column']
+        self.columns = columns_x = columns_y = kwargs.get('columns', [])
+        model: MLModel | None = kwargs.get('model')
+        if model is None:
+            raise ValueError('Model must be provided')
+
+        size_mark = 7
+        color = [
+            'khaki',
+            '#7272AF',
+            'lightcoral',
+            'lightgreen',
+            '#595671',
+            '#d93a46',
+            '#A3707F',
+            'turquoise',
+            'pink',
+            '#1A3B85',
+            'orchid',
+            '#6399CD',
+        ]
+
+        fig = make_subplots(rows=len(columns_y), cols=len(columns_x))
+
+        d_predict = dict(Counter(data[label_column]))
+        for i in range(len(d_predict.keys())):
+            d_predict[list(d_predict.keys())[i]] = i
+
+        predicted = kwargs.get('predict', None)
+
+        y_label = data[label_column].values
+        y = data[target_column].values
+        y_numeric = y
+        if y.dtype == np.object_:
+            y_numeric = np.array(list(map(lambda v: d_predict[v], y)))
+
+        q = len(d_predict)
+        if q > len(color):
+            for i in range(q - len(color)):
+                color.append(randomcolor.RandomColor().generate()[0])
+
+        delta_q = 1 / (q - 1)
+        z: float = 0
+        c, sns_colorscale = [], []
+        for i in range(q):
+            if i == 0:
+                c.append(z)
+            elif i == q - 1:
+                c.append(1)
+            else:
+                z += delta_q
+                c.append(z)
+        for i in range(q):
+            sns_colorscale.append([c[i], color[i]])
+
+        q1 = len(columns_x)
+        delta_q1 = (1 / q1) - 0.02
+        z = 0
+        domx, domy = [], []
+        for i in range(q1):
+            if i == 0:
+                z += delta_q1
+                domx.append([0, z])
+                domy.append([0, z])
+            else:
+                z0 = z + 0.02
+                z = z0 + delta_q1
+                if z > 1:
+                    z = 1
+                domx.append([z0, z])
+                domy.insert(0, [z0, z])
+
+        size_mark -= len(columns_x) - 1
+        if size_mark < 2:
+            size_mark = 2
+
+        D: dict[Any, Any] = {}
