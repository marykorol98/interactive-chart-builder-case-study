+from typing import Any
+
+import pandas as pd
+import plotly.graph_objects as go
+from plotly.subplots import make_subplots
+
+from smile_ml_core.plot_methods import BaseMethod
+
+
+class SeasonalDecompose(BaseMethod):
+    include_viewing_options = ['font_size', 'font_color', 'rot_x', 'rot_y']
+    styles_fields_exclude = {
+        'bg_color',
+        'multiple_axes',
+        'line_type',
+        'scheme_color',
+        'max_size',
+        'marker_color',
+    }
+    columns_templates = [
+        {
+            'label': 'Целевой столбец',
+            'name': 'target_column',
+            'source': 'target_column',
+            'select_all': True,
+        },
+        {
+            'label': 'Модель',
+            'name': 'label_model',
+            'source': 'label_model',
+            'select_all': True,
+        },
+        {
+            'label': 'Period length',
+            'name': 'period',
+            'source': 'period',
+            'default': '50',
+        },
+    ]
+
+    def __init__(self):
+        super().__init__()
+
+        self.target_column = None
+        self.label_model = 'additive'
+        self.period = None
+
+    def plot(self, data: pd.DataFrame, target_column=None, **kwargs):
+        if target_column is None:
+            raise Exception('Целевой столбец является обязательным параметром')
+
+        self.update_styles(kwargs.get('styles'))
+
+        data = self.get_series(data, kwargs, columns=[target_column])[0][1]
+
+        if not isinstance(data, pd.DataFrame):
+            data = data.df
+        from statsmodels.tsa.seasonal import seasonal_decompose
+
+        data = data[target_column].dropna().sort_index()
+        index = data.index.to_list()
+
+        fig = make_subplots(rows=4, cols=1)
+
+        period = kwargs.get('period')
+        result = seasonal_decompose(
+            data,
+            model=kwargs.get('label_model', self.label_model),
+            period=int(period) if period else None,
+        )
+        fig.add_trace(
+            go.Scatter(x=index, y=result.observed, mode='lines', name='observed'),
+            row=1,
+            col=1,
+        )
+        fig.add_trace(
+            go.Scatter(x=index, y=result.resid, mode='lines', name='resid'),
+            row=2,
+            col=1,
+        )
+        fig.add_trace(
+            go.Scatter(x=index, y=result.seasonal, mode='lines', name='seasonal'),
+            row=3,
+            col=1,
+        )
+        fig.add_trace(
+            go.Scatter(x=index, y=result.trend, mode='lines', name='trend'),
+            row=4,
+            col=1,
+        )
+
+        layout = self.compile_layout()
+        fig.update_layout(layout)
+
+        return fig.to_plotly_json()
+
+    @classmethod
+    def get_columns(cls, data_types=None, columns=None, instance=None, **kwargs):
+        target_columns = cls.filter_dtypes_columns(data_types, methods=['number'], columns=columns)
+
+        selected_label_column = columns
+        label_models = ['additive', 'multiplicative']
+        selected_model = 'additive'
+        target_columns_out = dict(map(lambda col: (col, col == selected_label_column), target_columns))
+        label_models_out = dict(map(lambda method: (method, method == selected_model), label_models))
+        period = '50'
+
+        return {
+            'target_column': target_columns_out,
+            'label_model': label_models_out,
+            'period': period,
+        }
+
+    @classmethod
+    def check_to_show(cls, *args, data_types=None, columns=None, **kwargs) -> Any:
+        columns = cls.filter_dtypes_columns(data_types, methods=['datetime'], columns=['index'] + columns)
+
+        return len(columns) > 0
