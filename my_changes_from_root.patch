+
+                if xi == 0:
+                    fig.update_yaxes(
+                        automargin=True,
+                        title=columns_y[yi],
+                        titlefont=dict(family='Arial', size=15, color='black'),
+                        tickfont=dict(size=8, color='black'),
+                        domain=domy[yi],
+                        row=yi + 1,
+                        col=xi + 1,
