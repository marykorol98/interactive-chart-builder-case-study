+                else:
+                    fig.update_yaxes(
+                        automargin=True,
+                        tickfont=dict(size=8, color='black'),
+                        domain=domy[yi],
+                        row=yi + 1,
+                        col=xi + 1,
+                    )
+
+        layout = self.compile_layout()
+        fig.update_layout(layout)
+
+        fig = fig.to_plotly_json()
+        for trace in fig['data']:
+            if 'y' in trace and isinstance(trace['y'], np.ndarray):
+                trace['y'] = trace['y'].tolist()
+        return fig
+
+    @classmethod
+    def get_template(cls, instance=None, **kwargs):
+        columns1 = list(filter(lambda c: c not in ['predict', 'proba'], kwargs.get('label_columns', [])))
+        columns2 = kwargs.get('columns', [])
+        if instance:
+            selected_column1, selected_columns2 = (
+                instance.label_column,
+                instance.columns,
+            )
+        else:
+            selected_column1, selected_columns2 = (
+                columns1[0],
+                columns2,
+            )  # по дефолту выбраны все columns2
+
+        columns1_data = dict(map(lambda col: (col, col == selected_column1), columns1))
+        columns2_data = dict(map(lambda col: (col, col in selected_columns2), columns2))
+
+        html = cls.get_template(columns1=columns1_data, columns2=columns2_data)
+        return html
