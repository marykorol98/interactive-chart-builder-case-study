+import numpy as np
+
+from ._sorting_mixin import SortingMixin
+from .base_method import BaseMethod
+
+
+class Regression(SortingMixin, BaseMethod):
+    def plot(self, df, target_column, styles: dict[str, str] | None = None, **kwargs):
+        assert 'model' in kwargs, (
+            'Для создания графика Regression ' "необходимо передать параметр 'модель' " 'с обученной моделью'
+        )
+        assert 'model_columns' in kwargs, 'Столбцы не были переданы'
+        logger = kwargs.get('logger')
+
+        model, model_columns = kwargs['model'], kwargs['model_columns']
+        index_column = kwargs.get('column', 'index')
+        if index_column == 'Отсутствует':
+            index_column = 'index'
+
+        self.set_sorting_states(kwargs.get('sort_column'), kwargs.get('reverse'))
+        self.update_styles(styles=styles)
+
+        df_reduced = self.get_series(df, None, model_columns + [target_column], index_col=index_column)
+        assert len(df_reduced) == 1, 'The input data was split into several dfs, check'
+        df_reduced = df_reduced[0][1]
+
+        index, target = (
+            df_reduced.index.tolist(),
+            df_reduced.pop(target_column).values.tolist(),
+        )
+
+        columns_with_nan = df_reduced.columns[df_reduced.isna().any()].tolist()
+        df_reduced = df_reduced.dropna()
+        if len(columns_with_nan) > 0 and logger is not None:
+            logger.warn(f'NaN in columns: {columns_with_nan}. Rows with NaN values ​​have been removed')
+
+        predict = model.predict(df_reduced)
+
+        if self.sort_column != self.sorting_non_selected:
+            if self.sort_column == 'Prediction':
+                predict = np.sort(predict)
+            else:
+                target = np.sort(target)
+
+        if self.reverse:
+            predict, target = predict[::-1], target[::-1]
+
+        traces = [
+            dict(
+                x=index,
+                y=target,
+                type='scatter',
+                name=target_column,
+                mode='markers',
+                marker=dict(color=kwargs.get('marker_color', 'blue'), size=10),
+                showlegend=True,
+            ),
+            dict(
+                x=index,
+                y=predict.tolist(),
+                type='scatter',
+                name='Prediction',
+                mode='lines',
+                line=dict(color='red', width=1),
+                showlegend=True,
+            ),
+        ]
+
+        layout = self.compile_layout()
+
+        xaxis_title = 'Column' if layout.get('xaxis_title') in ['', None] else layout.get('xaxis_title')
+        yaxis_title = 'Target' if layout.get('yaxis_title') in ['', None] else layout.get('yaxis_title')
+
+        layout['xaxis'].update(title=xaxis_title)
+        layout['yaxis'].update(title=yaxis_title)
+
+        return {'data': traces, 'layout': layout}
+
+    @classmethod
+    def get_template(cls, data_types: dict | None = None, columns=None, instance=None, **kwargs):
+        columns_data, node = {}, kwargs.get('node')
+        if node:
+            model = node.title_property.instance
+            target_column = node.get_property('properties')[f'{model.get_name()}.target_column']
+            sort_column = [instance.sort_column] if instance else []
+
+            columns = cls.filter_dtypes_columns(data_types, columns=[target_column], methods=['number']) + [
+                'Prediction'
+            ]
+            columns_data = dict(map(lambda col: (col, col in sort_column), columns))
+
+        kwargs['template_columns'] = {}
+        kwargs['sorting_columns'] = columns_data
+
+        return super(Regression, cls).get_template(data_types, columns, instance, **kwargs)
