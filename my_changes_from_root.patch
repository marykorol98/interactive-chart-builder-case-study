diff --git a/smile_ml_core/plot_methods/bubble_chart.py b/smile_ml_core/plot_methods/bubble_chart.py
new file mode 100644
index 00000000..4e760542
--- /dev/null
+++ b/smile_ml_core/plot_methods/bubble_chart.py
@@ -0,0 +1,162 @@
+from typing import Any
+
+from lazy_imports import try_import
+import pandas as pd
+from smile_ml_core.data.exceptions import PlottingAbsentColumnExceptions, PlottingParametersException
+from smile_ml_core.data.structures.dict_data_frame import DictDataFrame
+from smile_ml_core.plot_methods.base_method import BaseMethod, convert_ndarray
+with try_import() as plotly_import:
+    import plotly.express as px
+
+class BubbleChart(BaseMethod):
+    styles_fields_exclude = {
+        'line_type',
+        'color',
+        'marker_color',
+        'max_size',
+        'multiple_axes',
+        'marker_size',
+    }
+    
+    columns_templates = [
+        {
+            'label': 'Столбец X',
+            'name': 'column_x',
+            'source': 'column_x',
+            'multi': False,
+        },
+        {
+            'label': 'Столбец Y',
+            'name': 'column_y',
+            'source': 'column_y',
+            'multi': False,
+        },
+        {
+            'label': 'Group by',
+            'name': 'label_column',
+            'source': 'label_column',
+            'include_non_selected': True,
+        },
+        {
+            'label': 'Bubble size condition',
+            'name': 'size_condition',
+            'source': 'size_condition',
+        },
+    ]
+    
+    # Опция, когда размер точек зависит от частоты значений
+    SIZE_CONDITION_DEFAULT = 'Frequency'
+    
+    def __init__(self):
+        super().__init__()
+        self.label_column: str | None = None
+        self.column_x: str = ''
+        self.column_y: str = '' 
+        
+    def update_properties(self, properties: dict[str, Any]):
+        self.column_x = properties.get('column_x', '')
+        self.column_y = properties.get('column_y', '')
+        if not self.column_x:
+            raise PlottingAbsentColumnExceptions('column_x')
+        if not self.column_y:
+            raise PlottingAbsentColumnExceptions('column_y')
+        
+        self.size_condition = properties.get('size_condition', self.SIZE_CONDITION_DEFAULT)
+        
+        if len({self.column_x, self.column_y, self.size_condition}) < 3:
+            raise PlottingParametersException('Column values must not be the same')
+
+        self.label_column = properties.get('label_column', None)
+        
+        
+    def plot(self, ddf: DictDataFrame, properties: dict[str, Any], styles: dict[str, Any], **kwargs):
+        plotly_import.check()
+
+        self.update_styles(styles=styles)
+        self.update_properties(properties=properties)
+
+        if ddf.empty:
+            raise ValueError('DataFrame is empty')
+
+        df = ddf.view()
+
+        cols_for_reducing = [self.column_x, self.column_y] + [self.label_column] if self.label_column else self.columns
+        
+        if self.size_condition != self.SIZE_CONDITION_DEFAULT:
+            cols_for_reducing += [self.size_condition]
+            
+        df_reduced = self.get_series(df, kwargs, cols_for_reducing)
+        df_reduced = df_reduced[0][1]
+
+        freqs: pd.Series | None = None
+        if not df_reduced.isnull().values.any():
+            # Since update 2.0.1 we can not group by float
+            columns_float = df_reduced.select_dtypes('float').columns.tolist()
+            df_transform = df_reduced.copy()
+            if columns_float:
+                df_transform[columns_float] = df_transform[columns_float].round(3).astype(str)
+                
+            if self.size_condition == self.SIZE_CONDITION_DEFAULT:
+                freqs = df_transform.groupby(self.columns)[self.columns[0]].transform('count')
+            else:
+                freqs = df_transform[self.size_condition]
+
+        layout = self.compile_layout()
+        xaxis_title = layout.pop('xaxis_title')
+        yaxis_title = layout.pop('yaxis_title')
+
+        fig = px.scatter(
+            x=df_reduced[self.columns[0]].tolist(),
+            y=df_reduced[self.columns[1]].tolist(),
+            color=df_reduced[self.label_column] if self.label_column else None,
+            size=freqs,
+        )
+
+        fig.update_layout(layout)
+
+        xaxis_title = xaxis_title if xaxis_title not in [None, ''] else self.columns[0]
+        yaxis_title = yaxis_title if yaxis_title not in [None, ''] else self.columns[1]
+
+        # Настройка осей
+        fig.update_layout(
+            dict(
+                xaxis=dict(automargin=True, title=xaxis_title, **layout['xaxis']),
+                yaxis=dict(automargin=True, title=yaxis_title, **layout['yaxis']),
+            )
+        )
+
+        return convert_ndarray(fig.to_plotly_json())
+
+
+    @classmethod
+    def get_columns(cls, data_types=None, columns=None, instance=None, **kwargs):
+        columns = [cls.SIZE_CONDITION_DEFAULT] + cls.filter_dtypes_columns(data_types, methods=['number', 'bool'], columns=columns)
+        label_column = cls.filter_dtypes_columns(
+            data_types, methods=['number', 'object', 'string', 'bool'], columns=columns
+        )
+
+        selected_column_x = instance.column_x if instance else columns[0]
+        selected_column_y = instance.column_y if instance else columns[1]
+        selected_group_by = instance.label_column if instance else None
+        selected_condition = instance.size_condition if instance else cls.SIZE_CONDITION_DEFAULT
+
+        column_x = dict(map(lambda col: (col, col == selected_column_x), columns))
+        column_y = dict(map(lambda col: (col, col == selected_column_y), columns))
+        
+        label_column_out = dict(map(lambda col: (col, col == selected_group_by), label_column))
+        condition_out = dict(map(lambda col: (col, col == selected_condition), columns))
+
+        return {
+            'column_x': column_x,
+            'column_y': column_y,
+            'label_column': label_column_out,
+            'size_condition': condition_out
+            
+        }
+
+    @classmethod
+    def check_to_show(cls, columns=None, data_types=None, **kwargs):
+        columns = cls.filter_dtypes_columns(data_types, methods=['number', 'string'], columns=columns)
+        return len(columns) >= 2  # must be at least 2 columns
+        
+        
\ No newline at end of file
