@@ -0,0 +1,133 @@
+import logging
+from typing import TYPE_CHECKING, Union
+
+import pandas as pd
+import numpy as np
+from lazy_imports import try_import
+
+from smile_ml_core.plot_methods import BaseMethod
+from smile_ml_core.plot_methods.plot_tools import cut_image, render_image
+
+if TYPE_CHECKING:
+    from smile_ml_core.models.auto_ml.fedot_model import FedotModel
+
+with try_import() as fedot_import:
+    from fedot.core.data.data import array_to_input_data
+    from fedot.explainability.explainers import explain_pipeline
+    from golem.visualisation.graph_viz import GraphVisualizer
+
+from data.services.file_manager import FileManager
+
+logger = logging.getLogger(__name__)
+
+
+def prepare_data(df: pd.DataFrame, problem: str, target_column: str, task=None):
+    is_forecasting = problem == 'ts_forecasting'
+    if is_forecasting:
+        columns = df.columns.tolist()
+        if len(columns) == 1:
+            features = target = df[columns[0]].values.reshape(-1, 1)
+        else:
+            features = dict(map(lambda v: (v[0], v[1].values), df.to_dict(orient='series').items()))
+            target = df[target_column].values
+    else:
+        features, target = df.drop(target_column, axis=1), df[target_column].values
+        if isinstance(features, pd.Series):
+            features = features.values
+
+        if task is not None:
+            features = array_to_input_data(features_array=features, target_array=np.array([]), task=task)  # noqa: F821
+
+    return features, target
+
+
+class FedotGraphVisualization(BaseMethod):
+    styles_fields: Union[list, str] = []
+
+    def plot(self, df, target_column, plot_type, model: 'FedotModel', **kwargs):
+        path = FileManager.check_folder('media/images/modules/machine_learning/fedot')
+
+        file_name = f'{path}/{plot_type}'
+
+        GraphVisualizer(graph=model.current_pipeline).visualise(save_path=file_name)
+
+        return self.plot_pipeline(plot_type, model.current_pipeline)
+
+    def plot_pipeline(self, plot_type: str, pipeline):
+        path = FileManager.check_folder('media/images/modules/machine_learning/fedot')
+
+        file_name = f'{path}/{plot_type}'
+        GraphVisualizer(graph=pipeline).visualise(save_path=file_name)
+
+        return render_image(f'{file_name}.png')
+
+    @classmethod
+    def check_to_show(cls, *args, columns=None, **kwargs):
+        try:
+            fedot_import.check()
+        except ImportError:
+            # График не доступен на данном окружении
+            return False
+        else:
+            return True
+
+
+class FedotExplainerVisualization(BaseMethod):
+    styles_fields: Union[list, str] = []
+
+    def plot(self, df, target_column, plot_type, model, **kwargs):
+        case_id = kwargs.get('case_id')
+        pipe_line, problem = model.current_pipeline, model.problem
+        img_path = self.get_explainer_img_path(df, problem, target_column, pipe_line, case_id)
+        return render_image(img_path)
+
+    @staticmethod
+    def get_explainer_img_path(df, problem, target_column, pipe_line, case_id):
+        if problem == 'ts_forecasting':
+            target = df[target_column].to_numpy()
+            features_names = df.columns.tolist()
+            features = df.to_numpy()
+        else:
+            features, target = prepare_data(df, problem, target_column)
+            if hasattr(features, 'columns'):
+                features_names = features.columns.tolist()
+                features = features.to_numpy()
+            else:
+                features_names = list(map(lambda c: f'col-{c}', range(features.shape[1])))
+
+        train_data = array_to_input_data(features_array=features, target_array=target)
+        explainer_path = FileManager.check_folder('media/images/modules/machine_learning/fedot/explainers/' + case_id)
+
+        explainer = explain_pipeline(pipeline=pipe_line, data=train_data, method='surrogate_dt', visualize=False)
+        result = None
+        try:
+            # Не работает визуализиция для ts_forecasting
+            explainer.visualize(
+                dpi=200,
+                feature_names=features_names,
+                precision=6,
+                save_path=explainer_path,
+            )
+            result = f'{explainer_path}.png'
+
+        except Exception as e:
+            logger.info(f'Render explainer error: {str(e)}')
+            raise ValueError('Visualization error')
+
+        # Обрезать фон
+        try:
+            cut_image(result)
+        except Exception as e:
+            logger.info(f'Cut graph error: {str(e)}')
+
+        return result
+
+    @classmethod
+    def check_to_show(cls, *args, columns=None, **kwargs):
+        try:
+            fedot_import.check()
+        except ImportError:
+            # График не доступен на данном окружении
+            return False
+        else:
+            return True
