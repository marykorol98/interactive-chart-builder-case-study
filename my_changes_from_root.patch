+import pandas as pd
+import plotly.graph_objs as go
+
+from .base_method import BaseMethod
+
+
+class Radar(BaseMethod):
+    exclude_types = {'datetime64', 'bool'}
+
+    styles_fields_exclude = {
+        'line_type',
+        'marker_color',
+        'max_size',
+        'xaxis_title',
+        'yaxis_title',
+        'units',
+    }
+
+    strategies = ['median', 'mean', 'most_frequent']
+    default_strategy = 'median'
+
+    columns_templates = [
+        {
+            'label': 'Columns',
+            'name': 'columns',
+            'source': 'columns',
+            'multi': True,
+        },
+        {
+            'label': 'Category',
+            'name': 'category',
+            'source': 'category',
+            'include_non_selected': True,
+        },
+        {
+            'label': 'Strategy',
+            'name': 'strategy',
+            'default': default_strategy,
+            'source': 'strategy',
+            'include_non_selected': True,
+        },
+        {
+            'label': 'Logarithm values',
+            'name': 'log_val',
+            'default': True,
+            'source': 'log_val',
+        },
+    ]
+
+    def __init__(self):
+        super().__init__()
+        self.n_splits_max = 30
+
+        self.category = None
+        self.strategy = 'median'
+        self.log_val: bool = True
+
+    def get_series(
+        self,
+        df: pd.DataFrame,
+        additional_data: dict,
+        columns: list,
+        index_col: str = 'index',
+        group_by_col: str | None = None,
+    ):
+        if group_by_col:
+            group_by = df[group_by_col]
+            fill_value = (
+                '_' if isinstance(group_by[0], str) else 0
+            )  # Если оставить Nan значения, то группировку сделать не получится. fill_na для текстовых и числовых типов своё.
+            group_by = group_by.fillna(value=fill_value)
+            df[group_by_col] = group_by
+
+        return super().get_series(df, additional_data, columns, index_col, group_by_col)
+
+    def plot(
+        self,
+        df,
+        *args,
+        columns: list | None = None,
+        styles: dict[str, str] | None = None,
+        **kwargs,
+    ):
+        if columns is None or len(columns) < 2:
+            raise Exception(self.MESSAGE_COLUMNS_EMPTY)
+
+        category = kwargs.get('category', self.non_selected)
+        strategy = kwargs.get('strategy', self.non_selected)
+
+        cols_for_reducing = columns.copy()
+        if category != self.non_selected and category not in cols_for_reducing:
+            cols_for_reducing.append(category)
+
+        self.columns, self.category, self.strategy = columns, category, strategy
+
+        self.update_styles(styles=styles)
+
+        df_reduced = self.get_series(df, kwargs, cols_for_reducing)
+        assert len(df_reduced) == 1, 'The input data was split into several dfs, check'
+        df = df_reduced[0][1]
+
+        df_selected = df[columns]
+        dtypes = df_selected.dtypes
+        error_columns_mapping = map(
+            lambda v: df_selected.columns[dtypes.to_list().index(v)] if v in self.exclude_types else '',
+            dtypes.to_list(),
+        )
+        error_columns_list = list(filter(lambda v: v != '', error_columns_mapping))
+        assert (
+            len(error_columns_list) == 0
+        ), f'Column type must be int or float. Error with columns: {error_columns_list}'
+
+        fig = go.Figure()
+
+        if strategy in self.strategies:  # выводим усредненные или популярные значения
+            dfs_by_categories = self.get_series(df, kwargs, columns, group_by_col=category)
+            df_result = pd.DataFrame(columns=columns)
+
+            for i, (category_name, df_cat) in enumerate(dfs_by_categories):
+                category_values = {category: category_name}
+
+                for j, col in enumerate(df_cat.columns):
+                    if strategy == 'most_frequent':
+                        col_value = df_cat[col].mode()[0]  # берем первый на случай нескольких наиболее частых значений
+                    elif strategy == 'mean':
+                        col_value = df_cat[col].mean()
+                    else:
+                        col_value = df_cat[col].median()
+
+                    category_values[col] = col_value
+
+                df_result = df_result.append(category_values, ignore_index=True)
+        else:  # выводим все значения
+            df_result = df
+
+        df_result = pd.concat([df_result, df_result.iloc[[0]]], ignore_index=True)  # для замыкания графика
+
+        if category != self.non_selected and strategy in self.strategies:
+            df_result = df_result.groupby(category).mean().T
+            df_result = df_result.append(df_result.iloc[0])  # Для замкнутости линий
+            for i, col in enumerate(df_result):
+                fig.add_trace(
+                    go.Scatterpolar(
+                        r=df_result[col],
+                        theta=df_result.index.tolist(),
+                        name=col,
+                        marker={'color': self.get_colors()[i], 'size': 10},
+                    )
+                )
+        else:
+            categories = df_result[category]
+            if pd.isna(categories).all():
+                categories = [self.non_selected] * df_result.shape[0]
+            for i, col in enumerate(filter(lambda c: c != category, df_result.columns)):
+                fig.add_trace(
+                    go.Scatterpolar(
+                        r=df_result[col],
+                        theta=categories,
+                        name=col,
+                        marker={'color': self.get_colors()[i], 'size': 10},
+                    )
+                )
+
+        layout = self.compile_layout()
+
+        self.log_val = kwargs.get('Logarithm values', True)
+
+        log_val = 'log' if self.log_val else None  # Опция логарифмирования значений
+
+        fig.update_layout(layout)
+        fig.update_layout(
+            polar=dict(
+                radialaxis=dict(
+                    type=log_val,
+                    visible=True,
+                    tickangle=self.styles['xaxis_tickangle'].value,
+                ),
+                angularaxis=dict(
+                    type='category',
+                    tickangle=self.styles['yaxis_tickangle'].value,
+                ),
+                bgcolor='rgba(2, 74, 126, 0.3)',
+            ),
+            showlegend=True,
+        )
+        fig.update_traces({'marker': {'line': {'width': 1, 'color': '#011C30'}}})
+
+        return fig.to_plotly_json()
+
+    @classmethod
+    def get_columns(
+        cls,
+        data_types: dict | None = None,
+        columns=None,
+        label_columns=None,
+        instance=None,
+        **kwargs,
+    ):
+        columns_data = cls.filter_not_proba_columns(
+            cls.filter_dtypes_columns(data_types=data_types, methods=['number'], columns=columns)
+        )
+        category = cls.filter_not_proba_columns(
+            cls.filter_dtypes_columns(
+                data_types=data_types,
+                methods=['string', 'object', 'number'],
+                columns=columns,
+            )
+        )
+        log_val = True
+        if instance:
+            selected_columns, selected_category, selected_strategy, log_val = (
+                instance.columns,
+                instance.category,
+                instance.strategy,
+                instance.log_val,
+            )
+        else:
+            selected_columns = [columns_data[0]] if columns_data else None
+            selected_category, selected_strategy = None, cls.default_strategy
+
+        columns_data = dict(map(lambda col: (col, col in selected_columns), columns_data))
+        category = dict(map(lambda col: (col, col == selected_category), category))
+        strategy = dict(map(lambda col: (col, col == selected_strategy), cls.strategies))
+
+        return {
+            'columns': columns_data,
+            'category': category,
+            'strategy': strategy,
+            'Logarithm values': log_val,
+        }
+
+    @classmethod
+    def check_to_show(cls, *args, data_types=None, **kwargs):
+        is_types_numeric = len(cls.filter_dtypes_columns(data_types=data_types, methods=['number'])) != 0
+        is_types_categorical = (
+            len(cls.filter_dtypes_columns(data_types=data_types, methods=['string', 'object', 'int'])) != 0
+        )
+
+        return is_types_numeric and is_types_categorical
