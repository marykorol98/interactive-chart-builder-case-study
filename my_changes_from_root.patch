+import os
+
+import numpy as np
+
+from ..models._class_state import ClassState
+from ..models._ml_model_protocol import MLModel
+
+try:
+    import graphviz
+
+    graphviz_is_available = True
+except ImportError:
+    graphviz_is_available = False
+
+from sklearn.tree import export_graphviz
+
+from .base_method import BaseMethod
+from .plot_tools import render_image
+
+
+class GraphVisualizer(BaseMethod):
+    styles_fields: list | str = []
+
+    def plot(self, data, target_column, styles: dict[str, str] | None = None, **kwargs):
+        self.update_styles(styles=styles)
+
+        model: MLModel | None = kwargs.get('model')
+        if model is None:
+            raise ValueError('Model must be provided')
+
+        cls_ = model if hasattr(model, 'tree_') else model.estimators_[0]
+        class_names = getattr(cls_, 'classes_', np.ndarray([])).astype('int').astype('str')
+
+        dot_data = export_graphviz(
+            cls_, feature_names=kwargs.get('model_columns'), class_names=class_names, rounded=True, filled=True
+        )
+        self.generate_image_plots_dir()
+        file_name = self.generate_hashed_plot_image_name(input_name='graph_visualizer')
+
+        graph = graphviz.Source(dot_data, directory=self.image_plots_source, format='png')  # creates conf file
+        graph.render(directory=self.image_plots_source, filename=file_name)  # render img from conf file
+        return render_image(os.path.join(self.image_plots_source, '{}.png'.format(file_name)))
+
+    @classmethod
+    def check_to_show(cls, *args, columns=None, **kwargs):
+        node = kwargs['node']
+        exclude_models = {ClassState.ClassificationModel.BaggingClassifierModel}
+        for exclude_model in exclude_models:
+            if node.is_model(exclude_model):
+                return False
+
+        model = node.title_property.instance.first_model
+
+        is_tree = hasattr(model, 'tree_') or hasattr(model, 'estimators_') and hasattr(model.estimators_[0], 'tree_')
+        return graphviz_is_available and is_tree
