+import numpy as np
+import plotly.graph_objs as go
+
+from .base_method import BaseMethod
+
+
+class Forecasting(BaseMethod):
+    def plot(
+        self,
+        df,
+        target_column=None,
+        model_columns=None,
+        styles: dict[str, str] | None = None,
+        **kwargs,
+    ):
+        """
+
+        :param df: Данные узла test
+        :param target_column:
+        :param model_columns:
+        :param styles:
+        :param kwargs:
+                data_input - данные узла train, которые передавались на вход моделе
+        :return:
+        """
+        data_train, model = df, kwargs['model']
+
+        self.update_styles(styles=styles)
+
+        X_train = self.get_series(data_train, {}, model_columns + [target_column])
+        assert len(X_train) == 1, 'The input data was split into several dfs, check'
+        X_train = X_train[0][1]
+        real_data, x0_0 = (
+            X_train.pop(target_column).values.tolist(),
+            X_train.index.tolist(),
+        )
+        validation = model.predict(X_train).tolist()
+
+        X_test = self.get_series(df, {}, model_columns)
+        assert len(X_test) == 1, 'The input data was split into several dfs, check'
+        X_test = X_test[0][1]
+        x1 = X_test.index.tolist()
+        predict = model.predict(X_test).tolist()
+
+        low = predict - np.random.random(len(predict))
+        upp = predict + np.random.random(len(predict))
+
+        m_ticks = 12  # noqa: F841
+
+        min_y = float(min([min(low), min(upp), min(validation), min(predict), min(real_data)]))
+        max_y = float(max([max(low), max(upp), max(validation), max(predict), max(real_data)]))
+
+        trace_real = dict(
+            x=x0_0,
+            y=real_data,
+            type='scatter',
+            name='Historical data',
+            mode='lines+markers',
+            line=dict(color='#1F8AD8', width=2),
+            marker=dict(size=8),
+            hovertemplate='<i>%{x}</i>' + '<br><i>%{y}</i>',
+        )
+
+        trace_val = dict(
+            x=x0_0,
+            y=validation,
+            type='scatter',
+            name='Validation',
+            mode='lines',
+            line=dict(color='orange', width=2),
+            hovertemplate='<i>%{x}</i>' + '<br><i>%{y}</i>',
+        )
+
+        upper_bound = dict(
+            x=x1,
+            y=upp,
+            name='95% Confidence interval',
+            type='scatter',
+            mode=None,
+            line=dict(width=0.2, color='rgba(252,155,149,0.8)'),
+            fill='tonexty',
+            fillcolor='rgba(252,155,149,0.2)',
+            legendgroup='95% доверительный интервал',
+            hovertemplate='<i>%{x}</i>' + '<br><i>%{y}</i>',
+            showlegend=False,
+        )
+        trace_model0 = dict(
+            x=x1,
+            y=predict,
+            type='scatter',
+            name='Forecasting',
+            mode='lines',
+            line=dict(width=0),
+            fill='tonexty',
+            fillcolor='rgba(252,155,149,0.2)',
+            legendgroup='95% доверительный интервал',
+            hoverinfo='none',
+            showlegend=False,
+        )
+        lower_bound = dict(
+            x=x1,
+            y=low,
+            type='scatter',
+            name='95% Confidence interval',
+            mode='lines',
+            line=dict(width=0.2, color='rgba(252,155,149,0.8)'),
+            legendgroup='95% доверительный интервал',
+            hovertemplate='<i>%{x}</i>' + '<br><i>%{y}</i>',
+            showlegend=False,
+        )
+
+        trace_model = dict(
+            x=x1,
+            y=predict,
+            type='scatter',
+            name='Forecasting',
+            mode='lines+markers',
+            line=dict(dash='dot', width=2, color='firebrick'),
+            marker=dict(size=7),
+            legendgroup='Прогноз значений',
+            hovertemplate='<i>%{x}</i>' + '<br><i>%{y}</i>',
+            showlegend=True,
+        )
+        trace_0 = dict(
+            x=[x0_0[-1], x0_0[-1]],
+            y=[min_y - 300, max_y + 300],
+            type='scatter',
+            mode='lines',
+            line=dict(dash='dash', width=2, color='black'),
+            hoverinfo='none',
+            showlegend=False,
+        )
+
+        layout = self.compile_layout()
+        layout = go.Layout(
+            layout,
+            xaxis=dict(
+                showgrid=True,
+                gridcolor='white',
+                showline=True,
+                linecolor='#bdbdbd',
+                linewidth=2,
+                zeroline=True,
+                range=[min(x0_0), max(x1)],
+                showticklabels=True,
+                tickfont=dict(family='Arial', color='dimgrey', size=18),
+                domain=[0.04, 1],
+            ),
+            yaxis=dict(
+                showgrid=True,
+                gridcolor='#bdbdbd',
+                showline=True,
+                zeroline=True,
+                linecolor='#bdbdbd',
+                linewidth=2,
+                range=[min_y - 10, max_y + 10],
+                showticklabels=True,
+                tickfont=dict(family='Arial', color='dimgrey', size=18),
+                title=target_column,
+                titlefont=dict(family='Arial', color='black', size=20),
+                domain=[0.01, 0.95],
+            ),
+            legend=dict(
+                x=0.01,
+                y=1.04,
+                orientation='h',
+                tracegroupgap=12,
+                font=dict(family='Arial', color='black', size=16),
+            ),
+            showlegend=True,
+        )
+
+        fig = dict(
+            data=[
+                trace_real,
+                trace_val,
+                lower_bound,
+                trace_model0,
+                upper_bound,
+                trace_model,
+                trace_0,
+            ],
+            layout=layout,
+        )
+        return fig
+
+    @classmethod
+    def check_to_show(cls, data_types=None, columns=None, **kwargs) -> bool:
+        if columns is None:
+            columns = []
+        columns = cls.filter_dtypes_columns(data_types, methods=['datetime'], columns=['index'] + columns)
+
+        return len(columns) > 0
