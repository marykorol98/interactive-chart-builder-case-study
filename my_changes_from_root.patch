+from typing import Any
+
+import numpy as np
+import pandas as pd
+import plotly.express as px
+
+from .base_method import BaseMethod
+from .styles import StyleModificator
+
+plotly_colors = ['#808080', '#C0C0C0', '#800000', '#808000', '#00FF00']
+
+
+class BarChart(BaseMethod):
+    default_unique_count = 10
+    agg_funcs = {
+        'sum': 'sum',
+        'size': 'size',
+        'mean': 'mean',
+        'std': 'std',
+        'min': 'min',
+        'max': 'max',
+        'first': 'first',
+        'last': 'last',
+        'median': 'median',
+    }
+    styles_fields: list | str = [
+        'bg_color',
+        'font_size',
+        'font_color',
+        'xaxis_tickangle',
+        'yaxis_tickangle',
+        'data_slice',
+        'title',
+        'xaxis_title',
+        'yaxis_title',
+        'units',
+    ]
+
+    columns_templates = [
+        {
+            'label': 'Y colums(s)',
+            'name': 'columns',
+            'source': 'columns',
+            'multi': True,
+        },
+        {
+            'label': 'X column',
+            'name': 'x_column',
+            'source': 'x_column',
+        },
+        {
+            'label': 'Aggregating function',
+            'name': 'agg_func',
+            'source': 'agg_func',
+            'default': 'size',
+        },
+        {'label': 'Max number of bars', 'name': 'bars_num', 'source': 'bars_num'},
+        {
+            'label': 'Group by',
+            'name': 'group_by',
+            'source': 'group_by',
+            'include_non_selected': True,
+        },
+    ]
+    styles_modificators = [
+        StyleModificator(id_='xaxis_tickangle', value=45),
+        StyleModificator(id_='data_slice', value=' '),
+    ]
+
+    def __init__(self):
+        super().__init__()
+
+        self.x_column = None
+
+    @staticmethod
+    def interval_group_by(df: pd.DataFrame | pd.Series, group_col: str | None) -> list[Any]:
+        categories = []
+        for p_current in range(0, 100, 20):
+            p_next = p_current + 20
+            a, b = (
+                np.percentile(df[group_col], p_current),
+                np.percentile(df[group_col], p_next),
+            )
+            categories.append((a, b))
+
+        indices_out = []
+        for _, row in df.iterrows():
+            for cat in categories:
+                if (row[group_col] >= cat[0]) & (row[group_col] <= cat[1]):
+                    name = f'{int(round(cat[0], 0))}-{int(round(cat[1], 0))}'
+                    indices_out.append(name)
+                    break
+
+        return indices_out
+
+    def plot(self, df, *args, styles: dict[str, str] | None = None, **kwargs) -> Any:
+        group_by = kwargs.get('group_by', None)
+        columns = kwargs.get('columns')
+        index = kwargs.get('x_column', 'index')
+        agg_func = kwargs.get('agg_func', 'size')
+        bars_num = int(kwargs.get('bars_num', '10'))
+
+        self.update_styles(styles)
+
+        assert columns and len(columns) > 0, self.MESSAGE_COLUMNS_EMPTY
+
+        self.columns, self.x_column = columns, index
+
+        df_reduced = (
+            self.get_series(df.df, kwargs, columns + [group_by]) if group_by else self.get_series(df, kwargs, columns)
+        )
+
+        df_reduced = df_reduced[0][1]
+        df_reduced[index] = df[: len(df_reduced)][index] if index != 'index' else df_reduced.index.to_list()
+
+        if columns_bool := df_reduced.select_dtypes('bool').columns.tolist():
+            df_reduced.loc[:, columns_bool] = df_reduced[columns_bool].astype('uint8')
+
+        self.check_columns_type(df_reduced, columns)
+
+        if group_by:
+            if pd.api.types.is_numeric_dtype(df_reduced[index].dtype):
+                if len(df_reduced[index].unique()) <= 20:  # if categorical
+                    df_reduced[index] = df_reduced[index].astype('object').astype('string')
+                else:
+                    df_reduced[index] = self.interval_group_by(df_reduced, index)
+
+            if (
+                pd.api.types.is_numeric_dtype(df_reduced[group_by].dtype)
+                and len(df_reduced[group_by].unique()) > 20  # if not categorical
+            ):
+                df_reduced[group_by] = self.interval_group_by(df_reduced, group_by)
+
+            columns_for_filter = set([index] + columns + [group_by])
+            if len(columns_for_filter) < 3:  # 2 columns for grouping an
+                raise ValueError('Y column(s) parameter requires more columns to be selected')
+
+            dfs_by_categories = df_reduced[set([index] + columns + [group_by])]
+            df_counted = (
+                getattr(
+                    dfs_by_categories.groupby([index, group_by], as_index=False),
+                    agg_func,
+                )()
+                .assign(Total=lambda x: x[columns].sum(axis=1) if agg_func != 'size' else len(x))
+                .sort_values(by='Total', ascending=False)
+                .reset_index(drop=True)
+            )
+            fig = px.histogram(
+                df_counted.iloc[0:bars_num],
+                x=index,
+                y=agg_func if agg_func == 'size' else columns,
+                color=group_by,
+                barmode='group',
+            )
+        else:
+            if pd.api.types.is_numeric_dtype(df_reduced[index]):
+                df_reduced[index] = df_reduced[index].astype('object').astype('string')
+            columns_for_filter = [index] + columns
+            if len(columns_for_filter) < 2:
+                raise ValueError('Y column(s) parameter requires more columns to be selected')
+
+            dfs_by_categories = df_reduced[columns_for_filter]
+
+            df_counted = (
+                getattr(dfs_by_categories.groupby(index, as_index=False), agg_func)()
+                .assign(Total=lambda x: x[columns].sum(axis=1) if agg_func != 'size' else len(x))
+                .sort_values(by='Total', ascending=False)
+                .reset_index(drop=True)
+            )
+            fig = px.histogram(
+                df_counted.iloc[0:bars_num],
+                x=index,
+                y=agg_func if agg_func == 'size' else columns,
+                nbins=bars_num,
+                color_discrete_sequence=self.get_colors(),
+            )
+
+        layout: dict[str, Any] = {}
+        layout['xaxis_title'] = index if layout.get('xaxis_title') in ['', None] else layout.get('xaxis_title')
+
+        layout['yaxis_title'] = agg_func if layout.get('yaxis_title') in ['', None] else layout.get('yaxis_title')
+
+        layout = self.compile_layout(layout)
+
+        # Отменяем поворот для случаев с недлинным индексом и в случае группировки
+        layout['xaxis_tickangle'] = (
+            0
+            if len(df_reduced) <= 20 and layout.get('xaxis_tickangle', 45) == 45 and group_by
+            else layout.get('xaxis_tickangle', 45)
+        )
+
+        fig.update_layout(layout)
+
+        return fig.to_plotly_json()
+
+    @classmethod
+    def get_columns(cls, data_types: dict | None = None, columns=None, instance=None, **kwargs):
+        index = cls.filter_not_proba_columns(
+            ['index']
+            + cls.filter_dtypes_columns(
+                data_types,
+                methods=['number', 'object', 'category', 'string', 'bool'],
+                columns=columns,
+            )
+        )
+        columns_group_by = cls.filter_not_proba_columns(
+            cls.filter_dtypes_columns(
+                data_types,
+                methods=['number', 'string', 'object', 'category', 'bool'],
+                columns=columns,
+            )
+        )
+        columns = cls.filter_not_proba_columns(
+            cls.filter_dtypes_columns(data_types, methods=['number'], columns=columns)
+        )
+
+        if instance:
+            selected_columns, selected_index, selected_group_by, selected_agg_func = (
+                instance.columns,
+                instance.index,
+                instance.group_by,
+                instance.agg_func,
+            )
+        else:
+            selected_columns = columns[0] if columns else None
+            selected_index = None
+            selected_group_by = None
+            selected_agg_func = 'size'
+
+        index_data = dict(map(lambda col: (col, col == selected_index), index))
+        columns_data = dict(map(lambda col: (col, col in selected_columns), columns))
+        columns_group_by = dict(map(lambda col: (col, col == selected_group_by), columns_group_by))
+        agg_func = dict(map(lambda v: (v, v == selected_agg_func), cls.agg_funcs.keys()))
+        bars_num = '10'
+        return {
+            'x_column': index_data,
+            'columns': columns_data,
+            'agg_func': agg_func,
+            'bars_num': bars_num,
+            'group_by': columns_group_by,
+        }
+
+    @classmethod
+    def check_to_show(cls, data_types=None, columns=None, **kwargs):
+        columns = cls.filter_dtypes_columns(data_types, methods=['number'], columns=columns)
+        return len(columns) > 0
